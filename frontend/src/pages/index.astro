          <div class="field">
            <label for="question-answer-${index}">Correct answer ${question.type === "selectAll" ? "(comma separated IDs)" : ""}</label>
            <input id="question-answer-${index}" data-question-field="answer" value="${escapeHtml(question.type === "multipleChoice" ? question.answer?.choiceId ?? "a" : (question.answer?.choiceIds ?? []).join(", "))}" />
          </div>
        `;
      }

      function syncDraftQuestionsFromDom() {
        const editors = Array.from(questionEditorList.querySelectorAll<HTMLElement>("[data-question-index]"));
        state.draftQuestions = editors.map((editor) => {
          const type = editor.querySelector<HTMLSelectElement>("[data-question-field='type']")!.value as QuestionType;
          const choices = Array.from(editor.querySelectorAll<HTMLInputElement>("[data-choice-id]"))
            .map((input) => ({ id: input.dataset.choiceId ?? "", text: input.value }));
          const answerValue = editor.querySelector<HTMLInputElement>("[data-question-field='answer']")?.value ?? "";

          const isCircuit = type === "circuit";
          let circuitQuestion = undefined;
          if (isCircuit) {
            let diag = { width: 600, height: 400, components: [], nodes: [], wires: [], annotations: [] };
            try {
              diag = JSON.parse(editor.querySelector<HTMLTextAreaElement>("[data-question-field='circuitDiagramJson']")!.value);
            } catch (e) {}
            diag.width = Number(editor.querySelector<HTMLInputElement>("[data-question-field='circuitWidth']")?.value ?? diag.width ?? 600);
            diag.height = Number(editor.querySelector<HTMLInputElement>("[data-question-field='circuitHeight']")?.value ?? diag.height ?? 400);

            circuitQuestion = {
              schemaVersion: 1,
              catalogVersion: 1,
              interactionMode: editor.querySelector<HTMLSelectElement>("[data-question-field='circuitInteractionMode']")!.value,
              paletteSymbolIds: (editor.querySelector<HTMLInputElement>("[data-question-field='circuitPalette']")?.value ?? "")
                .split(",")
                .map(s => s.trim())
                .filter(Boolean),
              editableProperties: (editor.querySelector<HTMLInputElement>("[data-question-field='circuitEditable']")?.value ?? "")
                .split(",")
                .map(s => s.trim())
                .filter(Boolean),
              diagram: diag
            };
          }

          return {
            id: editor.querySelector<HTMLInputElement>("[data-question-field='id']")!.value.trim(),
            type,
            prompt: editor.querySelector<HTMLTextAreaElement>("[data-question-field='prompt']")!.value.trim(),
            choices: type === "freeResponse" || type === "numericResponse" || type === "code" || type === "symbolicResponse" || type === "circuit" ? [] : choices,
            answer: buildDraftAnswer(type, answerValue, editor),
            language: type === "code" ? editor.querySelector<HTMLSelectElement>("[data-question-field='language']")?.value as "python" | "cpp" : undefined,
            functionName: type === "code" ? editor.querySelector<HTMLInputElement>("[data-question-field='functionName']")?.value.trim() : undefined,
            starterCode: type === "code" ? editor.querySelector<HTMLTextAreaElement>("[data-question-field='starterCode']")?.value : undefined,
            tests: type === "code" ? parseCodeTests(editor.querySelector<HTMLTextAreaElement>("[data-question-field='tests']")?.value ?? "[]") : undefined,
            explanation: editor.querySelector<HTMLTextAreaElement>("[data-question-field='explanation']")!.value.trim(),
            circuitQuestion
          };
        });
      }

      function buildDraftAnswer(type: QuestionType, answerValue: string, editor: HTMLElement) {
        if (type === "freeResponse") {
          return {
            choiceId: null,
            choiceIds: [],
            expected: editor.querySelector<HTMLTextAreaElement>("[data-question-field='expected']")?.value.trim() ?? "",
            gradingMode: "selfCheck",
            keyPoints: (editor.querySelector<HTMLTextAreaElement>("[data-question-field='keyPoints']")?.value ?? "")
              .split("\n")
              .map((value) => value.trim())
              .filter(Boolean)
          };
        }

        if (type === "selectAll") {
          return {
            choiceId: null,
            choiceIds: answerValue.split(",").map((value) => value.trim()).filter(Boolean)
          };
        }

        if (type === "numericResponse") {
          return {
            choiceId: null,
            choiceIds: [],
            numericValue: nullableNumber(editor.querySelector<HTMLInputElement>("[data-question-field='numericValue']")?.value ?? ""),
            numericTolerance: nullableNumber(editor.querySelector<HTMLInputElement>("[data-question-field='numericTolerance']")?.value ?? "")
          };
        }

        if (type === "code") {
          return {
            choiceId: null,
            choiceIds: []
          };
        }

        if (type === "symbolicResponse") {
          return {
            choiceId: null,
            choiceIds: [],
            expectedLatex: editor.querySelector<HTMLTextAreaElement>("[data-question-field='expectedLatex']")?.value.trim() ?? "",
            equivalenceMode: editor.querySelector<HTMLSelectElement>("[data-question-field='equivalenceMode']")?.value ?? "expression",
            variables: (editor.querySelector<HTMLInputElement>("[data-question-field='variables']")?.value ?? "")
              .split(",")
              .map((value) => value.trim())
              .filter(Boolean),
            tolerance: nullableNumber(editor.querySelector<HTMLInputElement>("[data-question-field='tolerance']")?.value ?? "")
          };
        }

        if (type === "circuit") {
          let expectedValues = {};
          try {
            expectedValues = JSON.parse(editor.querySelector<HTMLTextAreaElement>("[data-question-field='circuitExpectedValuesJson']")?.value ?? "{}");
          } catch (e) {}

          let topology = { requiredComponents: [], connectionMode: "anyValidNetlist" };
          try {
            topology = JSON.parse(editor.querySelector<HTMLTextAreaElement>("[data-question-field='circuitTopologyJson']")?.value ?? '{"requiredComponents": [], "connectionMode": "anyValidNetlist"}');
          } catch (e) {}

          const meterType = editor.querySelector<HTMLSelectElement>("[data-question-field='circuitMeterType']")?.value ?? "";
          let meterPlacement = null;
          if (meterType) {
            meterPlacement = {
              meterType,
              targetBranchId: editor.querySelector<HTMLInputElement>("[data-question-field='circuitMeterBranch']")?.value.trim() || null,
              targetNodeIds: (editor.querySelector<HTMLInputElement>("[data-question-field='circuitMeterNodes']")?.value ?? "")
                .split(",")
                .map(s => s.trim())
                .filter(Boolean),
              requirePolarity: editor.querySelector<HTMLInputElement>("[data-question-field='circuitMeterPolarity']")?.checked ?? false,
              positiveTerminalId: editor.querySelector<HTMLInputElement>("[data-question-field='circuitMeterPos']")?.value.trim() || null,
              negativeTerminalId: editor.querySelector<HTMLInputElement>("[data-question-field='circuitMeterNeg']")?.value.trim() || null
            };
          }

          return {
            choiceId: null,
            choiceIds: [],
            circuitAnswer: {
              topology,
              selectedTargetIds: (editor.querySelector<HTMLInputElement>("[data-question-field='circuitSelectTargets']")?.value ?? "")
                .split(",")
                .map(s => s.trim())
                .filter(Boolean),
              meterPlacement,
              expectedValues
            }
          };
        }

        return { choiceId: answerValue.trim(), choiceIds: [] };
      }

      function parseCodeTests(value: string): CodeQuestionTest[] {
        try {
          const parsed = JSON.parse(value);
          return Array.isArray(parsed)
            ? parsed.map((test) => ({ input: String(test.input ?? ""), expected: String(test.expected ?? "") }))
            : [];
        } catch {
          return [];
        }
      }

      function buildDraftAssessment() {
        syncDraftQuestionsFromDom();
        const form = new FormData(createForm);
        return {
          id: String(form.get("id") ?? "").trim(),
          title: String(form.get("title") ?? "").trim(),
          assessmentType: String(form.get("assessmentType") ?? "quiz"),
          categoryId: String(form.get("categoryId") ?? "").trim(),
          subcategoryIds: [String(form.get("subcategoryId") ?? "").trim()].filter(Boolean),
          modeDefault: String(form.get("modeDefault") ?? "practice"),
          randomizeQuestions: form.get("randomizeQuestions") === "on",
          attemptQuestionCount: null,
          questionTimerSeconds: null,
          assessmentTimerSeconds: null,
          questions: state.draftQuestions
        };
      }

      function validateDraftLocally(assessment: ReturnType<typeof buildDraftAssessment>) {
        const errors: string[] = [];
        if (!assessment.id) errors.push("Assessment ID is required.");
        if (!assessment.title) errors.push("Title is required.");
        if (!assessment.categoryId) errors.push("Category is required.");

        const questionIds = new Set<string>();
        assessment.questions.forEach((question, index) => {
          if (!question.id) errors.push(`Question ${index + 1} needs an ID.`);
          if (questionIds.has(question.id)) errors.push(`Question ID '${question.id}' is duplicated.`);
          questionIds.add(question.id);
          if (!question.prompt) errors.push(`Question ${index + 1} needs a prompt.`);
          if (question.type === "numericResponse" && (question.answer?.numericValue === null || question.answer?.numericValue === undefined)) {
            errors.push(`Question ${index + 1} needs a numeric answer value.`);
          }
          if (question.type === "numericResponse" && ((question.answer?.numericTolerance ?? -1) < 0)) {
            errors.push(`Question ${index + 1} needs a non-negative tolerance.`);
          }
          if (question.type === "code") {
            if (!question.language || !["python", "cpp"].includes(question.language)) errors.push(`Question ${index + 1} needs Python or C++.`);
            if (!question.functionName) errors.push(`Question ${index + 1} needs a function name.`);
            if (!question.starterCode) errors.push(`Question ${index + 1} needs starter code.`);
            if (!question.tests || question.tests.length === 0) errors.push(`Question ${index + 1} needs at least one code test.`);
          }
          if (question.type === "symbolicResponse") {
            if (!question.answer?.expectedLatex) errors.push(`Question ${index + 1} needs expected LaTeX.`);
            if (!["expression", "derivative"].includes(String(question.answer?.equivalenceMode ?? ""))) errors.push(`Question ${index + 1} needs expression or derivative equivalence.`);
            if (question.answer?.equivalenceMode === "derivative" && (question.answer?.variables ?? []).length === 0) errors.push(`Question ${index + 1} needs a variable for derivative equivalence.`);
            if ((question.answer?.tolerance ?? -1) < 0) errors.push(`Question ${index + 1} needs a non-negative symbolic tolerance.`);
          }
          
        if (question.type === "multipart") {
          const answerForm = getActiveAnswerForm();
          if (!answerForm) throw new Error("Form not found");
          const form = new FormData(answerForm);
          return {
            questionId: question.id,
            choiceId: null,
            choiceIds: [],
            freeResponseText: null,
            selfCheckCorrect: null,
            numericValue: null,
            codeText: null,
            symbolicLatex: null,
            partAnswers: question.parts?.map(p => readPartAnswer(p, answerForm, form, `${p.id}-`)) ?? []
          };
        }

        if (question.type === "circuit") {
            if (!question.circuitQuestion) errors.push(`Question ${index + 1} needs circuit definition.`);
            if (!question.answer?.circuitAnswer) errors.push(`Question ${index + 1} needs circuit expected answer.`);
          }
        });

        return errors;
      }

      function renderAssessmentPreview() {
        assessmentPreview.textContent = JSON.stringify(buildDraftAssessment(), null, 2);
      }

      function validateDraftAssessment() {
        const errors = validateDraftLocally(buildDraftAssessment());
        createStatus.textContent = errors.length === 0 ? "Draft looks ready to save." : errors.join(" ");
      }

      async function saveDraftAssessment(event: Event) {
        event.preventDefault();
        const assessment = buildDraftAssessment();
        const errors = validateDraftLocally(assessment);
        if (errors.length > 0) {
          createStatus.textContent = errors.join(" ");
          return;
        }

        await api("/assessments", {
          method: "POST",
          body: JSON.stringify(assessment)
        });
        createStatus.textContent = "Assessment saved. It is now available in Load Quiz/Test.";
        await loadAssessments(categorySelect.value);
      }

      async function renderCurrentQuestion() {
        if (!state.attempt || !state.assessment) return;
        if (state.attempt.status !== "inProgress") {
          attemptContent.innerHTML = `<div class="empty-state">This attempt is ${escapeHtml(statusLabel(state.attempt.status).toLowerCase())}. Continue it from Attempt Sessions to make changes.</div>`;
          return;
        }

        if (state.assessment.assessmentType === "workedExample") {
          await renderCurrentWorkedExampleStep();
          return;
        }

        if (state.assessment.assessmentType === "guidedProject") {
          await renderGuidedProject();
          return;
        }

        if (state.assessment.assessmentType === "recallDrill") {
          await renderCurrentRecallItem();
          return;
        }

        if (state.assessment.assessmentType === "conceptLesson" || state.assessment.assessmentType === "interactiveExploration") {
          await renderCurrentLearningSection();
          return;
        }

        const question = getCurrentQuestion();
        const results = state.latestResults?.questions.find((result) => result.questionId === question.id);
        const progress = `${state.currentIndex + 1} of ${state.attempt.questionOrder.length}`;
        const promptHtml = await renderMarkdown(question.prompt);
        const navigatorHtml = renderQuestionNavigator();
        let inputHtml = "";

        if (question.type === "multipart") {
          const partsHtml = await Promise.all((question.parts ?? []).map(async (part, i) => {
            const partResult = results?.partResults?.find(r => r.questionId === part.id);
            const partPrefix = `${part.id}-`;
            const partPromptHtml = await renderMarkdown(part.prompt);
            const partInputHtml = await renderAnswerInput(part, partResult?.submittedAnswer ?? null, partPrefix);
            const partFeedback = part.type === "freeResponse" || partResult?.isCorrect === null || partResult?.isCorrect === undefined
              ? ""
              : `<div class="feedback ${partResult.isCorrect ? "correct" : "incorrect"}">${partResult.isCorrect ? "Correct" : "Needs review"}</div>`;
            return `
              <div class="multipart-part" id="part-container-${partPrefix}">
                <h4>Part ${String.fromCharCode(65 + i)}</h4>
                <div class="markdown">${partPromptHtml}</div>
                ${partInputHtml}
                ${partFeedback}
              </div>
            `;
          }));
          inputHtml = partsHtml.join("");
        } else {
          inputHtml = await renderAnswerInput(question, results?.submittedAnswer ?? null);
        }

        const feedbackExplanation = results?.explanation ? await renderMarkdown(results.explanation) : "";
        const symbolicFeedbackHtml = await renderSymbolicFeedback(results?.symbolicFeedback);
        const selfCheckHtml = await renderFreeResponseSelfCheck(results, state.attempt.mode === "practice");
        const feedback = question.type === "freeResponse" || results?.isCorrect === null || results?.isCorrect === undefined
          ? ""
          : `<div class="feedback ${results.isCorrect ? "correct" : "incorrect"}">
              ${results.isCorrect ? "Correct" : "Needs review"}
              ${renderCodeFeedback(results.codeFeedback)}
              ${symbolicFeedbackHtml}
              ${renderCircuitFeedback(results.circuitFeedback)}
              ${feedbackExplanation ? `<details><summary>Explanation</summary><div class="markdown">${feedbackExplanation}</div></details>` : ""}
            </div>`;

        attemptContent.innerHTML = `
          <div class="question-shell">
            <div class="question-header">
              <span>${progress}</span>
              <strong>${escapeHtml(state.assessment.title)}</strong>
            </div>
            <div class="question-prompt markdown">${promptHtml}</div>
            ${renderMedia(question.media ?? [])}
          </div>
          <form id="answer-form" class="answer-form">
            ${navigatorHtml}
            ${inputHtml}
            <div class="assessment-control-bar">
              <div class="button-row">
                <button class="primary chunky" id="submit-answer" type="submit">Submit Answer</button>
                <button type="button" id="previous-question" ${state.currentIndex === 0 ? "disabled" : ""}>Previous</button>
                <button type="button" id="next-question" ${state.currentIndex === state.attempt.questionOrder.length - 1 ? "disabled" : ""}>Next</button>
                ${renderDevAssessmentRefreshButton()}
                <button type="button" id="pause-attempt">Save and Quit</button>
              </div>
              <div class="button-row terminal-actions" aria-label="Assessment ending actions">
                <button class="chunky complete-action" type="button" id="complete-attempt">Complete Quiz</button>
                <button class="chunky danger-action" type="button" id="abandon-attempt">Quit Early</button>
              </div>
            </div>
          </form>
          ${selfCheckHtml}
          ${feedback}
        `;

        document.querySelector<HTMLFormElement>("#answer-form")!.addEventListener("submit", (event) => {
          event.preventDefault();
          submitCurrentAnswer();
        });
        document.querySelector<HTMLButtonElement>("#previous-question")!.addEventListener("click", () => {
          state.currentIndex -= 1;
          void renderCurrentQuestion();
        });
        document.querySelector<HTMLButtonElement>("#next-question")!.addEventListener("click", () => {
          state.currentIndex += 1;
          void renderCurrentQuestion();
        });
        document.querySelector<HTMLButtonElement>("#complete-attempt")!.addEventListener("click", completeAttempt);
        document.querySelector<HTMLButtonElement>("#pause-attempt")!.addEventListener("click", pauseAttempt);
        document.querySelector<HTMLButtonElement>("#abandon-attempt")!.addEventListener("click", abandonAttempt);
        setupDevAssessmentRefresh();
        setupQuestionNavigator();
        setupChoiceCards(question);
        setupCodeEditor(question);
        setupSymbolicResponseField(question);
        setupSelfCheckButtons();
        setupCircuitEditor(question, results?.submittedAnswer ?? null);
      }

      function getLearningSections() {
        if (state.assessment?.assessmentType === "conceptLesson") {
          return state.assessment.lesson?.sections ?? [];
        }
        return state.assessment?.exploration?.sections ?? [];
      }

      async function renderCurrentLearningSection() {
        if (!state.attempt || !state.assessment || !state.latestResults) {
          if (state.attempt) state.latestResults = await api<AttemptResults>(`/attempts/${state.attempt.id}/results`);
          if (!state.attempt || !state.assessment || !state.latestResults) return;
        }

        attemptContent.classList.remove("empty-state");
        const sections = getLearningSections();
        const sectionId = state.attempt.questionOrder[state.currentIndex] ?? sections[0]?.id;
        const section = sections.find((candidate) => candidate.id === sectionId);
        let result = state.latestResults.learningSections.find((candidate) => candidate.sectionId === sectionId);
        if (!section || !result) return;

        if (!result.visited) {
          await saveLearningSectionState(section.id, true, result.interactionChanged, result.controlValues);
          result = state.latestResults?.learningSections.find((candidate) => candidate.sectionId === sectionId);
          if (!result) return;
        }

        const isExploration = state.assessment.assessmentType === "interactiveExploration";
        const conceptSection = !isExploration ? section as LearningSection : null;
        const explorationSection = isExploration ? section as ExplorationSection : null;
        const introduction = isExploration
          ? state.assessment.exploration?.introduction ?? ""
          : state.assessment.lesson?.introduction ?? "";
        const sectionBody = await renderMarkdown(
          conceptSection?.content ?? explorationSection?.instruction ?? "");
        const introductionHtml = state.currentIndex === 0 ? await renderMarkdown(introduction) : "";
        const check = section.check;
        const checkResult = result.check;
        const checkPrompt = check ? await renderMarkdown(check.prompt) : "";
        const explanation = checkResult?.explanation ? await renderMarkdown(checkResult.explanation) : "";
        const selfCheckHtml = await renderFreeResponseSelfCheck(checkResult, true);
        const checkFeedback = checkResult?.isCorrect === null || checkResult?.isCorrect === undefined
          ? ""
          : `<div class="feedback ${checkResult.isCorrect ? "correct" : "incorrect"}">
              ${checkResult.isCorrect ? "Check complete" : "Not quite yet"}
              ${explanation ? `<details open><summary>Explanation</summary><div class="markdown">${explanation}</div></details>` : ""}
            </div>`;
        const canComplete = (!check || checkResult?.isCorrect === true)
          && (!isExploration || result.interactionChanged);
        const activeSectionIndex = firstUnansweredIndex(state.latestResults, state.attempt);
        const isReviewingCompletedSection = result.completed && state.currentIndex !== activeSectionIndex;
        const continueLabel = isReviewingCompletedSection
          ? "Return to Current Section"
          : state.currentIndex === sections.length - 1 ? "Finish Lesson" : "Continue";

        attemptContent.innerHTML = `
          <div class="learning-session-shell">
            <aside class="learning-progress" aria-label="Lesson sections">
              <p class="eyebrow">${escapeHtml(assessmentTypeLabel(state.assessment.assessmentType))}</p>
              <h2>${escapeHtml(state.assessment.title)}</h2>
              <ol>
                ${sections.map((candidate, index) => {
                  const candidateResult = state.latestResults!.learningSections.find((item) => item.sectionId === candidate.id);
                  const current = candidate.id === section.id;
                  const selectable = candidateResult?.unlocked === true;
                  return `<li class="${candidateResult?.completed ? "complete" : ""} ${current ? "current" : ""} ${!candidateResult?.unlocked ? "locked" : ""}">
                    <button type="button" data-learning-index="${index}" ${selectable ? "" : "disabled"} aria-current="${current ? "step" : "false"}">
                      <span>${candidateResult?.completed ? "&#10003;" : index + 1}</span>
                      ${escapeHtml(candidateResult?.unlocked ? candidate.title : "Locked section")}
                    </button>
                  </li>`;
                }).join("")}
              </ol>
            </aside>
            <section class="learning-section">
              ${introductionHtml ? `<div class="learning-introduction markdown">${introductionHtml}</div>` : ""}
              <article class="learning-card">
                <div class="question-header"><span>${state.currentIndex + 1} of ${sections.length}</span><strong>${section.required ? "Required" : "Optional"}</strong></div>
                <h2>${escapeHtml(section.title)}</h2>
                <div class="markdown learning-content">${sectionBody}</div>
                ${conceptSection ? renderMedia(conceptSection.media ?? []) : ""}
                ${explorationSection ? renderExplorationControls(explorationSection, result.controlValues) : ""}
                ${check ? `
                  <form id="learning-check-form" class="answer-form">
                    <div class="question-prompt markdown">${checkPrompt}</div>
                    ${renderMedia(check.media ?? [])}
                    ${await renderAnswerInput(check, checkResult?.submittedAnswer ?? null)}
                    <button class="primary chunky" id="submit-answer" type="submit">Check Understanding</button>
                  </form>
                  ${selfCheckHtml}
                  ${checkFeedback}
                ` : ""}
                ${isExploration && !result.interactionChanged ? `<p class="input-help">Change at least one control to complete this section.</p>` : ""}
                <div class="assessment-control-bar">
                  <div class="button-row">
                    <button type="button" id="previous-learning-section" ${state.currentIndex === 0 ? "disabled" : ""}>Previous Section</button>
                    <button class="primary chunky" type="button" id="complete-learning-section" ${canComplete ? "" : "disabled"}>${continueLabel}</button>
                    ${renderDevAssessmentRefreshButton()}
                    <button type="button" id="pause-attempt">Save and Quit</button>
                  </div>
                  <div class="button-row terminal-actions">
                    <button class="chunky danger-action" type="button" id="abandon-attempt">Quit Early</button>
                  </div>
                </div>
              </article>
            </section>
          </div>
        `;

        document.querySelector<HTMLFormElement>("#learning-check-form")?.addEventListener("submit", (event) => {
          event.preventDefault();
          void submitCurrentAnswer();
        });
        document.querySelector<HTMLButtonElement>("#previous-learning-section")?.addEventListener("click", async () => {
          await flushLearningSectionState();
          state.currentIndex = Math.max(0, state.currentIndex - 1);
          void renderCurrentLearningSection();
        });
        document.querySelector<HTMLButtonElement>("#complete-learning-section")?.addEventListener("click", async () => {
          await flushLearningSectionState();
          if (result.completed) {
            state.currentIndex = firstUnansweredIndex(state.latestResults!, state.attempt!);
            void renderCurrentLearningSection();
            return;
          }
          void completeLearningSection(section.id);
        });
        document.querySelectorAll<HTMLButtonElement>("[data-learning-index]").forEach((button) => {
          button.addEventListener("click", async () => {
            await flushLearningSectionState();
            state.currentIndex = Number(button.dataset.learningIndex ?? state.currentIndex);
            void renderCurrentLearningSection();
          });
        });
        document.querySelector<HTMLButtonElement>("#pause-attempt")?.addEventListener("click", pauseAttempt);
        document.querySelector<HTMLButtonElement>("#abandon-attempt")?.addEventListener("click", abandonAttempt);
        setupDevAssessmentRefresh();
        if (check) {
          setupChoiceCards(check);
          setupCodeEditor(check);
          setupSymbolicResponseField(check);
          setupSelfCheckButtons();
          setupCircuitEditor(check, checkResult?.submittedAnswer ?? null);
        }
        if (explorationSection) setupExplorationControls(explorationSection, result);
      }

      function renderExplorationControls(section: ExplorationSection, savedValues: Record<string, unknown>) {
        const controls = section.controls.map((control) => {
          const value = savedValues[control.id] ?? control.defaultValue;
          if (control.type === "select") {
            return `<label class="exploration-control"><span>${escapeHtml(control.label)}</span><select data-exploration-control="${escapeHtml(control.id)}">${control.options.map((option) =>
              `<option value="${escapeHtml(option.value)}" ${String(value) === option.value ? "selected" : ""}>${escapeHtml(option.label)}</option>`).join("")}</select></label>`;
          }
          if (control.type === "toggle") {
            const checked = value === true || String(value).toLowerCase() === "true";
            return `<label class="exploration-control exploration-toggle"><input type="checkbox" data-exploration-control="${escapeHtml(control.id)}" ${checked ? "checked" : ""}/><span>${escapeHtml(control.label)}</span></label>`;
          }
          return `<label class="exploration-control"><span>${escapeHtml(control.label)}</span><input type="${control.type === "slider" ? "range" : "number"}" data-exploration-control="${escapeHtml(control.id)}" value="${escapeHtml(String(value))}" ${control.min === null ? "" : `min="${control.min}"`} ${control.max === null ? "" : `max="${control.max}"`} ${control.step === null ? "" : `step="${control.step}"`}/><output data-control-output="${escapeHtml(control.id)}">${escapeHtml(String(value))}</output></label>`;
        }).join("");
        const views = section.views.map((view) =>
          `<section class="exploration-view" data-exploration-view="${escapeHtml(view.id)}"><span>${escapeHtml(view.label)}</span><div class="exploration-view-value"></div></section>`).join("");
        return `<div class="exploration-workspace"><div class="exploration-controls">${controls}</div><div class="exploration-views">${views}</div></div>`;
      }

      function setupExplorationControls(section: ExplorationSection, result: LearningSectionResult) {
        const update = () => {
          const values = readExplorationValues();
          document.querySelectorAll<HTMLOutputElement>("[data-control-output]").forEach((output) => {
            output.value = String(values[output.dataset.controlOutput ?? ""] ?? "");
          });
          updateExplorationViews(section, values);
          if (learningStateTimer) clearTimeout(learningStateTimer);
          pendingLearningSectionState = {
            sectionId: section.id,
            controlValues: values
          };
          const completeButton = document.querySelector<HTMLButtonElement>("#complete-learning-section");
          if (completeButton) {
            completeButton.disabled = Boolean(section.check && result.check?.isCorrect !== true);
          }
          learningStateTimer = setTimeout(() => {
            void flushLearningSectionState();
          }, 300);
        };
        document.querySelectorAll<HTMLInputElement | HTMLSelectElement>("[data-exploration-control]").forEach((control) => {
          control.addEventListener("input", update);
          control.addEventListener("change", update);
        });
        updateExplorationViews(section, readExplorationValues());
      }

      function readExplorationValues() {
        const values: Record<string, unknown> = {};
        document.querySelectorAll<HTMLInputElement | HTMLSelectElement>("[data-exploration-control]").forEach((control) => {
          const id = control.dataset.explorationControl ?? "";
          if (control instanceof HTMLInputElement && control.type === "checkbox") values[id] = control.checked;
          else if (control instanceof HTMLInputElement && (control.type === "range" || control.type === "number")) values[id] = Number(control.value);
          else values[id] = control.value;
        });
        return values;
      }

      function evaluateExplorationExpression(expression: string, values: Record<string, unknown>) {
        try {
          const substitutions = Object.fromEntries(Object.entries(values).map(([key, value]) => [key, typeof value === "boolean" ? (value ? 1 : 0) : value]));
          const evaluated = explorationComputeEngine.parse(expression).subs(substitutions as any).N().value;
          return typeof evaluated === "number" ? Number(evaluated.toFixed(6)) : evaluated;
        } catch {
          return "Unable to evaluate";
        }
      }

      function updateExplorationViews(section: ExplorationSection, values: Record<string, unknown>) {
        section.views.forEach((view) => {
          const mount = document.querySelector<HTMLElement>(`[data-exploration-view="${CSS.escape(view.id)}"] .exploration-view-value`);
          if (!mount) return;
          if (view.type === "conditionalText") {
            const visible = Boolean(evaluateExplorationExpression(view.condition ?? "0", values));
            mount.textContent = visible ? view.content ?? "" : "";
            return;
          }
          if (view.type === "table" || view.type === "plot") {
            const inputId = view.inputControlId ?? "";
            const start = view.start ?? 0;
            const end = view.end ?? 10;
            const step = view.step ?? 1;
            const rows: Array<[number, unknown]> = [];
            for (let x = start; x <= end && rows.length < 100; x += step) {
              rows.push([x, evaluateExplorationExpression(view.expression ?? "0", { ...values, [inputId]: x })]);
            }
            if (view.type === "table") {
              mount.innerHTML = `<table><thead><tr><th>${escapeHtml(inputId)}</th><th>Value</th></tr></thead><tbody>${rows.map(([x, y]) => `<tr><td>${x}</td><td>${escapeHtml(String(y))}</td></tr>`).join("")}</tbody></table>`;
            } else {
              const numericRows = rows.filter((row): row is [number, number] => typeof row[1] === "number");
              const ys = numericRows.map((row) => row[1]);
              const minY = Math.min(...ys, 0);
              const maxY = Math.max(...ys, 1);
              const points = numericRows.map(([x, y]) => `${((x - start) / Math.max(end - start, 1)) * 300},${140 - ((y - minY) / Math.max(maxY - minY, 1)) * 120}`).join(" ");
              mount.innerHTML = `<svg viewBox="0 0 300 150" role="img" aria-label="${escapeHtml(view.label)} plot"><polyline points="${points}" fill="none" stroke="currentColor" stroke-width="3"/></svg>`;
            }
            return;
          }
          mount.textContent = String(evaluateExplorationExpression(view.expression ?? "0", values));
        });
      }

      async function saveLearningSectionState(sectionId: string, visited: boolean, interactionChanged: boolean, controlValues: Record<string, unknown>) {
        if (!state.attempt) return;
        const response = await api<{ attempt: Attempt; results: AttemptResults }>(`/attempts/${state.attempt.id}/learn/sections/${encodeURIComponent(sectionId)}/state`, {
          method: "PUT",
          body: JSON.stringify({ visited, interactionChanged, controlValues })
        });
        state.attempt = response.attempt;
        state.latestResults = response.results;
      }

      async function flushLearningSectionState() {
        if (learningStateTimer) {
          clearTimeout(learningStateTimer);
          learningStateTimer = null;
        }
        const pending = pendingLearningSectionState;
        pendingLearningSectionState = null;
        if (!pending) return;
        await saveLearningSectionState(pending.sectionId, true, true, pending.controlValues);
      }

      async function completeLearningSection(sectionId: string) {
        if (!state.attempt) return;
        const button = document.querySelector<HTMLButtonElement>("#complete-learning-section");
        if (button) setBusy(button, "Saving");
        try {
          await flushLearningSectionState();
          const response = await api<{ attempt: Attempt; results: AttemptResults }>(`/attempts/${state.attempt.id}/learn/sections/${encodeURIComponent(sectionId)}/complete`, { method: "POST" });
          state.attempt = response.attempt;
          state.latestResults = response.results;
          if (state.attempt.status === "completed") {
            updateActiveAttemptChip("Complete");
            await renderResults(false);
            await loadGrades();
            return;
          }
          state.currentIndex = firstUnansweredIndex(response.results, response.attempt);
          await renderCurrentLearningSection();
        } finally {
          if (button) clearBusy(button, "Continue");
        }
      }

      async function renderCurrentWorkedExampleStep() {
        if (!state.attempt || !state.assessment) return;

        const steps = getWorkedExampleSteps();
        const step = steps.find((candidate) => candidate.id === state.attempt!.questionOrder[state.currentIndex]) ?? steps[0];
        const question = workedStepToQuestion(step);
        const result = state.latestResults?.questions.find((candidate) => candidate.questionId === step.id);
        const example = getWorkedExampleForStep(step.id);
        const currentUnlockedIndex = state.latestResults ? firstUnansweredIndex(state.latestResults, state.attempt) : 0;
        const isReviewingPreviousStep = state.currentIndex < currentUnlockedIndex;
        const isLockedFutureStep = state.currentIndex > currentUnlockedIndex;
        const problemHtml = await renderMarkdown(example?.problem ?? "");
        const instructionHtml = await renderMarkdown(step.instruction);
        const promptHtml = await renderMarkdown(question.prompt);
        const feedbackExplanation = result?.explanation ? await renderMarkdown(result.explanation) : "";
        const symbolicFeedbackHtml = await renderSymbolicFeedback(result?.symbolicFeedback);
        const selfCheckHtml = await renderFreeResponseSelfCheck(result, state.attempt.mode === "practice");
        const feedback = question.type === "freeResponse" || result?.isCorrect === null || result?.isCorrect === undefined
          ? ""
          : `<div class="feedback ${result.isCorrect ? "correct" : "incorrect"}">
              ${result.isCorrect ? "Step complete" : "Try this step again"}
              ${renderCodeFeedback(result.codeFeedback)}
              ${symbolicFeedbackHtml}
              ${renderCircuitFeedback(result.circuitFeedback)}
              ${feedbackExplanation ? `<details open><summary>Feedback</summary><div class="markdown">${feedbackExplanation}</div></details>` : ""}
            </div>`;

        attemptContent.innerHTML = `
          <div class="worked-example-shell">
            <aside class="worked-progress" aria-label="Worked example steps">
              <p class="eyebrow">${escapeHtml(state.assessment.title)}</p>
              <ol>
                ${steps.map((candidate, index) => {
                  const completed = state.latestResults?.questions.find((question) => question.questionId === candidate.id)?.isCorrect === true;
                  const current = candidate.id === step.id;
                  const unlocked = completed || index <= currentUnlockedIndex;
                  return `
                    <li class="${completed ? "complete" : ""} ${current ? "current" : ""} ${!unlocked ? "locked" : ""}">
                      <button type="button" data-worked-step-index="${index}" ${unlocked ? "" : "disabled"} aria-current="${current ? "step" : "false"}">
                        <span>${index + 1}</span>${escapeHtml(unlocked ? candidate.title : "Locked step")}
                      </button>
                    </li>
                  `;
                }).join("")}
              </ol>
            </aside>
            <section class="worked-step">
              <div class="worked-context">
                <span>${state.currentIndex + 1} of ${state.attempt.questionOrder.length}</span>
                <h2>${escapeHtml(example?.title ?? state.assessment.title)}</h2>
                <div class="markdown">${problemHtml}</div>
              </div>
              <article class="worked-card">
                <h3>${escapeHtml(step.title)}</h3>
                <div class="worked-instruction markdown">${instructionHtml}</div>
                ${step.hint ? `<details class="hint-box"><summary>Hint</summary><div class="markdown">${await renderMarkdown(step.hint)}</div></details>` : ""}
                <div class="question-prompt markdown">${promptHtml}</div>
                ${renderMedia(question.media ?? [])}
                <form id="answer-form" class="answer-form">
                  ${await renderAnswerInput(question, result?.submittedAnswer ?? null)}
                  <div class="assessment-control-bar">
                    <div class="button-row">
                      ${isReviewingPreviousStep ? `<button type="button" id="return-current-step">Return to Current Step</button>` : ""}
                      <button type="button" id="previous-worked-step" ${state.currentIndex === 0 ? "disabled" : ""}>Previous Step</button>
                      <button class="primary chunky" id="submit-answer" type="submit" ${isReviewingPreviousStep || isLockedFutureStep ? "disabled" : ""}>${result?.isCorrect ? "Continue" : "Check Step"}</button>
                      ${renderDevAssessmentRefreshButton()}
                      <button type="button" id="pause-attempt">Save and Quit</button>
                    </div>
                    <div class="button-row terminal-actions" aria-label="Assessment ending actions">
                      <button class="chunky danger-action" type="button" id="abandon-attempt">Quit Early</button>
                    </div>
                  </div>
                </form>
                ${selfCheckHtml}
                ${feedback}
              </article>
            </section>
          </div>
        `;

        document.querySelector<HTMLFormElement>("#answer-form")!.addEventListener("submit", (event) => {
          event.preventDefault();
          if (isReviewingPreviousStep || isLockedFutureStep) return;
          submitCurrentAnswer();
        });
        document.querySelector<HTMLButtonElement>("#previous-worked-step")!.addEventListener("click", () => {
          state.currentIndex = Math.max(0, state.currentIndex - 1);
          void renderCurrentWorkedExampleStep();
        });
        document.querySelector<HTMLButtonElement>("#return-current-step")?.addEventListener("click", () => {
          state.currentIndex = currentUnlockedIndex;
          void renderCurrentWorkedExampleStep();
        });
        document.querySelectorAll<HTMLButtonElement>("[data-worked-step-index]").forEach((button) => {
          button.addEventListener("click", () => {
            state.currentIndex = Number(button.dataset.workedStepIndex ?? state.currentIndex);
            void renderCurrentWorkedExampleStep();
          });
        });
        document.querySelector<HTMLButtonElement>("#pause-attempt")!.addEventListener("click", pauseAttempt);
        document.querySelector<HTMLButtonElement>("#abandon-attempt")!.addEventListener("click", abandonAttempt);
        setupDevAssessmentRefresh();
        setupChoiceCards(question);
        setupCodeEditor(question);
        setupSymbolicResponseField(question);
        setupSelfCheckButtons();
        setupCircuitEditor(question, result?.submittedAnswer ?? null);
      }

      async function renderGuidedProject() {
        if (!state.attempt || !state.assessment?.guidedProject) return;
        if (state.attempt.status !== "inProgress") {
          attemptContent.innerHTML = `<div class="empty-state">This guided project is ${escapeHtml(statusLabel(state.attempt.status).toLowerCase())}. Continue it from Attempt Sessions to make changes.</div>`;
          return;
        }

        if (!state.guidedProjectSession) {
          state.guidedProjectSession = await api<GuidedProjectSession>(`/attempts/${encodeURIComponent(state.attempt.id)}/guided-project`);
        }

        const project = state.assessment.guidedProject;
        const session = state.guidedProjectSession;
        const editableFiles = session.files.filter((file) => !file.readOnly);
        const activePath = state.guidedProjectActiveFile
          || editableFiles[0]?.path
          || session.files[0]?.path
          || "";
        state.guidedProjectActiveFile = activePath;
        const activeFile = session.files.find((file) => file.path === activePath) ?? session.files[0];
        const instructionsHtml = await renderMarkdown(project.instructions);

        attemptContent.innerHTML = `
          <div class="guided-project-shell">
            <aside class="guided-project-sidebar">
              <p class="eyebrow">Guided Project</p>
              <h2>${escapeHtml(state.assessment.title)}</h2>
              <div class="markdown">${instructionsHtml}</div>
              <div class="guided-check-list">
                <h3>Required Checks</h3>
                ${renderGuidedProjectChecks(project.requiredChecks, session.checkResults, true)}
                ${project.bonusChecks.length > 0 ? `<h3>Bonus Checks</h3>${renderGuidedProjectChecks(project.bonusChecks, session.checkResults, false)}` : ""}
              </div>
            </aside>
            <section class="guided-project-workspace">
              <div class="project-file-tabs" role="tablist" aria-label="Project files">
                ${session.files.map((file) => `
                  <button
                    type="button"
                    class="${file.path === activeFile.path ? "active" : ""}"
                    data-project-file="${escapeHtml(file.path)}"
                    role="tab"
                    aria-selected="${file.path === activeFile.path ? "true" : "false"}"
                  >
                    ${escapeHtml(file.path)}${file.readOnly ? " · read-only" : ""}
                  </button>
                `).join("")}
              </div>
              <div class="project-editor-header">
                <strong>${escapeHtml(activeFile.path)}</strong>
                ${activeFile.readOnly ? `<span>Read-only reference</span>` : `<span>Editable session file</span>`}
              </div>
              <div id="guided-project-editor" class="code-editor-shell project-editor-shell" data-language="${escapeHtml(project.language)}" data-code="${escapeHtml(activeFile.content)}" data-readonly="${activeFile.readOnly ? "true" : "false"}"></div>
              <div class="assessment-control-bar">
                <div class="button-row">
                  <button class="primary chunky" type="button" id="run-guided-project">Run Checks</button>
                  <button type="button" id="save-guided-project">Save Progress</button>
                  ${renderDevAssessmentRefreshButton()}
                  <button type="button" id="pause-attempt">Save and Quit</button>
                </div>
                <div class="button-row terminal-actions" aria-label="Project ending actions">
                  <button class="chunky complete-action" type="button" id="complete-attempt" ${guidedProjectAllRequiredPassed(project, session) ? "" : "disabled"}>Complete Project</button>
                  <button class="chunky danger-action" type="button" id="abandon-attempt">Quit Early</button>
                </div>
              </div>
              ${session.checkResults.length > 0 ? renderGuidedProjectOutput(session.checkResults) : `<p class="input-help">Run checks when you want the app to compile and test the current files. You do not need to write a makefile or terminal command.</p>`}
            </section>
          </div>
        `;

        setupGuidedProjectEditor(project.language, activeFile.readOnly);
        document.querySelectorAll<HTMLButtonElement>("[data-project-file]").forEach((button) => {
          button.addEventListener("click", () => {
            syncGuidedProjectEditor();
            state.guidedProjectActiveFile = button.dataset.projectFile ?? state.guidedProjectActiveFile;
            void renderGuidedProject();
          });
        });
        document.querySelector<HTMLButtonElement>("#run-guided-project")!.addEventListener("click", runGuidedProject);
        document.querySelector<HTMLButtonElement>("#save-guided-project")!.addEventListener("click", async () => {
          await saveGuidedProjectFiles();
          await renderGuidedProject();
        });
        document.querySelector<HTMLButtonElement>("#pause-attempt")!.addEventListener("click", pauseAttempt);
        document.querySelector<HTMLButtonElement>("#complete-attempt")!.addEventListener("click", completeAttempt);
        document.querySelector<HTMLButtonElement>("#abandon-attempt")!.addEventListener("click", abandonAttempt);
        setupDevAssessmentRefresh();
      }

      async function renderCurrentRecallItem() {
        if (!state.attempt || !state.assessment) return;
        const itemId = state.attempt.questionOrder[state.currentIndex];
        const item = state.assessment.items?.find((candidate) => candidate.id === itemId);
        if (!item) {
          attemptContent.innerHTML = `<div class="empty-state">Recall item could not be found.</div>`;
          return;
        }

        const result = state.latestResults?.recallItems.find((candidate) => candidate.itemId === item.id);
        const promptHtml = await renderMarkdown(item.prompt);
        const expectedHtml = result?.expected
          ? await renderMarkdown(result.expected)
          : result?.expectedLatex
            ? await renderMarkdown(`$${result.expectedLatex}$`)
            : "";
        const explanationHtml = result?.explanation ? await renderMarkdown(result.explanation) : "";
        const responseValue = result?.userResponse ?? "";
        const isRevealed = result?.answerRevealed === true;
        const isRated = result?.rating && result.rating !== "unknown";
        const summary = state.latestResults?.recallSummary;

        attemptContent.innerHTML = `
          <div class="recall-shell">
            <aside class="recall-progress">
              <p class="eyebrow">Recall Drill</p>
              <h2>${escapeHtml(state.assessment.title)}</h2>
              <p>${state.currentIndex + 1} of ${state.attempt.questionOrder.length}</p>
              <div class="question-jump-grid recall-jump-grid">
                ${state.attempt.questionOrder.map((candidateId, index) => {
                  const candidateResult = state.latestResults?.recallItems.find((candidate) => candidate.itemId === candidateId);
                  const stateClass = candidateResult?.rating && candidateResult.rating !== "unknown"
                    ? recallRatingClass(candidateResult.rating)
                    : candidateResult?.answerRevealed ? "pending" : "unanswered";
                  return `
                    <button
                      type="button"
                      class="question-jump ${stateClass} ${index === state.currentIndex ? "current" : ""}"
                      data-recall-index="${index}"
                      aria-label="Jump to recall item ${index + 1}, ${recallRatingLabel(candidateResult?.rating ?? "unknown")}"
                    ><span>${index + 1}</span></button>
                  `;
                }).join("")}
              </div>
              ${summary ? `
                <div class="recall-mini-summary">
                  <strong>${summary.itemsReviewed}/${state.attempt.questionOrder.length}</strong>
                  <span>rated</span>
                </div>
              ` : ""}
            </aside>
            <section class="recall-card">
              <div class="question-header">
                <span>${escapeHtml(recallItemTypeLabel(item.type))}</span>
                <strong>${escapeHtml(state.assessment.title)}</strong>
              </div>
              <div class="question-prompt markdown">${promptHtml}</div>
              ${renderRecallResponseInput(item, responseValue, isRevealed)}
              ${isRevealed ? `
                <div class="recall-answer-panel">
                  <h3>Answer</h3>
                  ${expectedHtml ? `<div class="markdown">${expectedHtml}</div>` : ""}
                  ${renderMedia(result?.media ?? item.answer.media ?? [])}
                  ${(result?.aliases ?? []).length > 0 ? `
                    <div class="result-detail">
                      <strong>Aliases</strong>
                      <p>${(result?.aliases ?? []).map(escapeHtml).join(", ")}</p>
                    </div>
                  ` : ""}
                  ${explanationHtml ? `<details open><summary>Explanation</summary><div class="markdown">${explanationHtml}</div></details>` : ""}
                </div>
                <div class="recall-rating-panel">
                  <h3>${isRated ? `Rated ${escapeHtml(recallRatingLabel(result!.rating))}` : "Rate your recall"}</h3>
                  <div class="button-row recall-rating-buttons">
                    ${renderRecallRatingButton("easy", result?.rating)}
                    ${renderRecallRatingButton("correct", result?.rating)}
                    ${renderRecallRatingButton("needsReview", result?.rating)}
                    ${renderRecallRatingButton("forgotCompletely", result?.rating)}
                  </div>
                </div>
              ` : ""}
              <div class="assessment-control-bar">
                <div class="button-row">
                  <button type="button" id="previous-question" ${state.currentIndex === 0 ? "disabled" : ""}>Previous</button>
                  <button type="button" id="next-question" ${state.currentIndex === state.attempt.questionOrder.length - 1 ? "disabled" : ""}>Next</button>
                  ${!isRevealed ? `<button class="primary chunky" type="button" id="reveal-recall-answer">Reveal Answer</button>` : ""}
                  ${renderDevAssessmentRefreshButton()}
                  <button type="button" id="pause-attempt">Save and Quit</button>
                </div>
                <div class="button-row terminal-actions" aria-label="Recall drill ending actions">
                  <button class="chunky danger-action" type="button" id="abandon-attempt">Quit Early</button>
                </div>
              </div>
            </section>
          </div>
        `;

        document.querySelector<HTMLButtonElement>("#previous-question")!.addEventListener("click", () => {
          state.currentIndex -= 1;
          void renderCurrentRecallItem();
        });
        document.querySelector<HTMLButtonElement>("#next-question")!.addEventListener("click", () => {
          state.currentIndex += 1;
          void renderCurrentRecallItem();
        });
        document.querySelector<HTMLButtonElement>("#reveal-recall-answer")?.addEventListener("click", revealCurrentRecallItem);
        document.querySelectorAll<HTMLButtonElement>("[data-recall-rating]").forEach((button) => {
          button.addEventListener("click", () => rateCurrentRecallItem(button.dataset.recallRating as RecallRating));
        });
        document.querySelectorAll<HTMLButtonElement>("[data-recall-index]").forEach((button) => {
          button.addEventListener("click", () => {
            state.currentIndex = Number(button.dataset.recallIndex ?? state.currentIndex);
            void renderCurrentRecallItem();
          });
        });
        document.querySelector<HTMLButtonElement>("#pause-attempt")!.addEventListener("click", pauseAttempt);
        document.querySelector<HTMLButtonElement>("#abandon-attempt")!.addEventListener("click", abandonAttempt);
        setupDevAssessmentRefresh();
      }

      function renderGuidedProjectChecks(checks: GuidedProjectCheck[], results: GuidedProjectCheckResult[], required: boolean) {
        if (checks.length === 0) return `<p class="muted">No checks configured.</p>`;

        return `
          <ol>
            ${checks.map((check) => {
              const result = results.find((candidate) => candidate.checkId === check.id && candidate.required === required);
              const status = result ? (result.passed ? "Pass" : "Needs work") : "Not run";
              return `
                <li class="${result?.passed ? "complete" : result ? "needs-review" : ""}">
                  <strong>${escapeHtml(check.title)}</strong>
                  <span>${escapeHtml(status)}</span>
                  <p>${escapeHtml(check.description)}</p>
                </li>
              `;
            }).join("")}
          </ol>
        `;
      }

      function renderGuidedProjectOutput(results: GuidedProjectCheckResult[]) {
        return `
          <div class="guided-output">
            <h3>Latest run</h3>
            ${results.map((result) => `
              <details class="${result.passed ? "correct" : "incorrect"}" ${result.passed ? "" : "open"}>
                <summary>${escapeHtml(result.title)} - ${result.passed ? "Pass" : "Needs work"}</summary>
                ${result.output ? `<pre>${escapeHtml(result.output)}</pre>` : ""}
                ${result.compileOutput ? `<pre>${escapeHtml(result.compileOutput)}</pre>` : ""}
                ${result.error ? `<pre>${escapeHtml(result.error)}</pre>` : ""}
              </details>
            `).join("")}
          </div>
        `;
      }

      async function runGuidedProject() {
        if (!state.attempt) return;
        const button = document.querySelector<HTMLButtonElement>("#run-guided-project");
        if (button) setBusy(button, "Running");

        try {
          const response = await api<GuidedProjectRunResult>(`/attempts/${encodeURIComponent(state.attempt.id)}/guided-project/run`, {
            method: "POST",
            body: JSON.stringify({ files: readGuidedProjectFiles() })
          });
          state.guidedProjectSession = response.session;
          await renderGuidedProject();
        } finally {
          if (button) clearBusy(button, "Run Checks");
        }
      }

      async function saveGuidedProjectFiles() {
        if (!state.attempt || state.assessment?.assessmentType !== "guidedProject" || !state.guidedProjectSession) return;
        state.guidedProjectSession = await api<GuidedProjectSession>(`/attempts/${encodeURIComponent(state.attempt.id)}/guided-project/files`, {
          method: "PUT",
          body: JSON.stringify({ files: readGuidedProjectFiles() })
        });
      }

      async function completeGuidedProject() {
        if (!state.attempt) return;
        const completeButton = document.querySelector<HTMLButtonElement>("#complete-attempt");
        if (completeButton) setBusy(completeButton, "Completing");

        try {
          await saveGuidedProjectFiles();
          const response = await api<{ results: AttemptResults }>(`/attempts/${encodeURIComponent(state.attempt.id)}/guided-project/complete`, {
            method: "POST"
          });
          state.latestResults = response.results;
          state.guidedProjectSession = null;
          updateActiveAttemptChip("Complete");
          updateModeControlLock();
          await renderResults(false);
          await loadGrades();
        } finally {
          if (completeButton) clearBusy(completeButton, "Complete Project");
        }
      }

      function guidedProjectAllRequiredPassed(project: GuidedProject, session: GuidedProjectSession) {
        return project.requiredChecks.every((check) =>
          session.checkResults.some((result) => result.required && result.checkId === check.id && result.passed));
      }

      function readGuidedProjectFiles() {
        syncGuidedProjectEditor();
        return (state.guidedProjectSession?.files ?? []).map((file) => ({
          path: file.path,
          content: file.content
        }));
      }

      function syncGuidedProjectEditor() {
        if (!state.guidedProjectSession || !state.guidedProjectActiveFile || !currentProjectEditor) return;

        state.guidedProjectSession = {
          ...state.guidedProjectSession,
          files: state.guidedProjectSession.files.map((file) =>
            file.path === state.guidedProjectActiveFile && !file.readOnly
              ? { ...file, content: currentProjectEditor!.state.doc.toString() }
              : file)
        };
      }

            function setupGuidedProjectEditor(language: "cpp" | "python", readOnly: boolean) {
        currentProjectEditor?.destroy();
        currentProjectEditor = null;

        const mount = document.querySelector<HTMLDivElement>("#guided-project-editor");
        if (!mount) return;

        const projectFiles = state.guidedProjectSession?.files || [];
        const activeFilePath = state.guidedProjectActiveFile || "";

        currentProjectEditor = createCodeEditor({
          parent: mount,
          document: mount.dataset.code ?? "",
          language: language,
          readOnly: readOnly,
          projectFiles: projectFiles,
          activeFilePath: activeFilePath,
          onChange: () => syncGuidedProjectEditor()
        });
      }

      async function renderResults(alreadyCommitted: boolean) {
        if (!state.latestResults) return;
        activeCircuitCanvas?.destroy();
        activeCircuitCanvas = null;
        resultCircuitCanvases.forEach((canvas) => canvas.destroy());
        resultCircuitCanvases = [];
        const results = state.latestResults;
        const isWorkedExample = results.assessmentType === "workedExample";
        const isRecallDrill = results.assessmentType === "recallDrill";
        const isLearningSession = results.assessmentType === "conceptLesson" || results.assessmentType === "interactiveExploration";
        const isInstructionalSession = results.assessmentType === "workedExample" || results.assessmentType === "guidedProject" || isRecallDrill || isLearningSession;
        if (isRecallDrill) {
          await renderRecallResults(results);
          return;
        }
        if (isLearningSession) {
          await renderLearningResults(results);
          return;
        }
        const questionHtml = await Promise.all(results.questions.map(async (question) => {
          const promptHtml = await renderMarkdown(question.prompt);
          const expectedHtml = question.expectedAnswer ? await renderMarkdown(question.type === "symbolicResponse" ? `$${question.expectedAnswer}$` : question.expectedAnswer) : "";
          const explanationHtml = question.explanation ? await renderMarkdown(question.explanation) : "";
          const instructionHtml = question.instruction ? await renderMarkdown(question.instruction) : "";
          const hintHtml = question.hint ? await renderMarkdown(question.hint) : "";
          const symbolicFeedbackHtml = await renderSymbolicFeedback(question.symbolicFeedback);
          const selfCheckHtml = await renderFreeResponseSelfCheck(question, true);

          return `
            <article class="result-item ${question.isCorrect ? "correct" : "incorrect"}">
              ${question.title ? `<h3>${escapeHtml(question.title)}</h3>` : ""}
              ${instructionHtml ? `<div class="result-detail"><strong>Step:</strong><div class="markdown">${instructionHtml}</div></div>` : ""}
              <div class="markdown">${promptHtml}</div>
              ${renderMedia(question.media ?? [])}
              <p><strong>${question.isCorrect ? "Correct" : "Needs review"}</strong></p>
              ${renderCodeFeedback(question.codeFeedback)}
              ${symbolicFeedbackHtml}
              ${renderCircuitFeedback(question.circuitFeedback)}
              ${question.type === "circuit" ? `<div class="circuit-result-mount" data-question-id="${question.questionId}" style="min-height: 250px; margin-top: 10px;"></div>` : ""}
              ${question.type === "freeResponse" ? selfCheckHtml : ""}
              ${question.type !== "freeResponse" && expectedHtml ? `<div class="result-detail"><strong>Expected:</strong><div class="markdown">${expectedHtml}</div></div>` : ""}
              ${hintHtml ? `<details><summary>Hint used for this step</summary><div class="markdown">${hintHtml}</div></details>` : ""}
              ${question.type !== "freeResponse" && explanationHtml ? `<details open><summary>Explanation</summary><div class="markdown">${explanationHtml}</div></details>` : ""}
            </article>
          `;
        }));

        attemptContent.innerHTML = `
          <div class="results-header">
            <h2>${escapeHtml(results.assessmentTitle)}</h2>
            <div class="score-badge">${isInstructionalSession ? "Complete" : `${results.percentScore}%`}</div>
          </div>
          <p class="muted">${isInstructionalSession ? assessmentTypeLabel(results.assessmentType) : `${results.correctCount} correct out of ${results.totalQuestions} questions`}. Status: ${escapeHtml(statusLabel(results.status))}.</p>
          <div class="result-list">
            ${questionHtml.join("")}
          </div>
          ${results.hasPendingSelfChecks ? `<p class="feedback incorrect">Resolve pending free-response self-checks before committing this score.</p>` : ""}
          ${alreadyCommitted ? `<p class="feedback correct">Score committed to grade log.</p>` : ""}
          ${renderDevAssessmentRefreshButton()}
          ${!alreadyCommitted && !isInstructionalSession && !results.hasPendingSelfChecks && results.status === "completed" ? `<button class="primary chunky" id="commit-grade">Commit Score</button>` : ""}
        `;

        document.querySelector<HTMLButtonElement>("#commit-grade")?.addEventListener("click", commitGrade);
        setupDevAssessmentRefresh();
        setupSelfCheckButtons();

        document.querySelectorAll<HTMLElement>(".circuit-result-mount").forEach((mount) => {
          const questionId = mount.dataset.questionId;
          const qDef = state.assessment?.questions.find((q) => q.id === questionId);
          if (!qDef) return;

          const results = state.latestResults?.questions.find((r) => r.questionId === questionId);
          const submittedAnswer = results?.submittedAnswer;
          const def = qDef.circuitQuestion || {
            interactionMode: "build",
            paletteSymbolIds: ["resistor", "battery", "capacitor", "junction"],
            editableProperties: ["value", "label", "rotation"],
            diagram: { width: 600, height: 400, components: [], nodes: [], wires: [], annotations: [] }
          };

          let startDiagram = def.diagram;
          if (def.interactionMode === "build" && submittedAnswer?.circuitAnswer?.builtDiagram) {
            startDiagram = submittedAnswer.circuitAnswer.builtDiagram;
          }

          const resultsCanvas = new CircuitCanvas(
            mount,
            startDiagram,
            "preview",
            () => {}
          );
          resultCircuitCanvases.push(resultsCanvas);

          if (submittedAnswer?.circuitAnswer) {
            const ca = submittedAnswer.circuitAnswer;
            resultsCanvas.restoreState({
              selectedIds: [
                ...(ca.selectedComponentIds ?? []),
                ...(ca.selectedNodeIds ?? []),
                ...(ca.selectedBranchIds ?? [])
              ],
              meterType: ca.meterType ?? null,
              meterPositiveTerminalId: ca.meterPositiveTerminalId ?? null,
              meterNegativeTerminalId: ca.meterNegativeTerminalId ?? null,
              meterTargetBranchId: ca.meterTargetBranchId ?? null,
              values: ca.values ?? null
            });
          }
        });
      }

