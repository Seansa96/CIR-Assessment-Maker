            const symbols = def.paletteSymbolIds?.length > 0 ? def.paletteSymbolIds : ["resistor", "battery", "capacitor", "junction"];
            toolbarHtml = `
              <div class="circuit-build-toolbar">
                <div class="palette-buttons">
                  ${symbols.map(sym => `<button type="button" class="palette-btn" data-symbol="${sym}">Add ${sym}</button>`).join(" ")}
                </div>
                <div class="tool-actions">
                  <button type="button" id="btn-circuit-rotate">Rotate Selected</button>
                  <button type="button" class="danger-light" id="btn-circuit-delete">Delete Selected</button>
                  <button type="button" id="btn-circuit-node">Add Junction Node</button>
