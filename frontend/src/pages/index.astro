---
import "katex/dist/katex.min.css";
import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>CIR Assessment Maker</title>
  </head>
  <body>
    <main class="app-shell">
      <header class="app-header">
        <div>
          <p class="eyebrow">Local STEM assessment loop</p>
          <h1>CIR Assessment Maker</h1>
        </div>
        <div class="api-status" id="api-status" role="status">Connecting</div>
      </header>

      <nav class="tabs" aria-label="Primary">
        <button class="tab active" data-tab="load">Load Assessment</button>
        <button class="tab" data-tab="create">Create Quiz/Test</button>
        <button class="tab" data-tab="settings">Settings</button>
        <button class="tab" data-tab="grades">Grade Log</button>
      </nav>

      <section class="view active" id="view-load" aria-labelledby="load-title">
        <!-- Progressive Assessment Navigator -->
        <section class="nav-explorer" id="nav-explorer" aria-label="Assessment Navigator">
          <div class="nav-header">
            <h2 id="load-title">Load Assessment</h2>
            <div class="attempt-chip" id="active-attempt-chip">No active attempt</div>
          </div>
          <p class="quiet-hint">Switch assessments whenever you need a different path.</p>

          <!-- Breadcrumb path -->
          <nav class="nav-breadcrumb" id="nav-breadcrumb" aria-label="Navigator path" hidden></nav>

          <!-- Compact Active Session -->
          <div id="nav-compact-active-session" class="compact-active-session" hidden></div>

          <!-- Step stages (each revealed after prior selection) -->
          <div class="nav-stages" id="nav-stages">
            <!-- Stage 0: Subject -->
            <div class="nav-stage active" id="nav-stage-subject" data-stage="subject">
              <h3 class="nav-stage-label">Subject</h3>
              <div class="nav-tile-grid" id="nav-subject-tiles" role="listbox" aria-label="Select subject"></div>
            </div>
            <!-- Stage 1: Area -->
            <div class="nav-stage" id="nav-stage-area" data-stage="area" hidden>
              <h3 class="nav-stage-label">Area</h3>
              <div class="nav-tile-grid" id="nav-area-tiles" role="listbox" aria-label="Select area"></div>
            </div>
            <!-- Stage 2: Topic -->
            <div class="nav-stage" id="nav-stage-topic" data-stage="topic" hidden>
              <h3 class="nav-stage-label">Topic</h3>
              <div class="nav-tile-grid" id="nav-topic-tiles" role="listbox" aria-label="Select topic"></div>
            </div>
            <!-- Stage 3: Learning Goal -->
            <div class="nav-stage" id="nav-stage-goal" data-stage="goal" hidden>
              <h3 class="nav-stage-label">Learning Goal</h3>
              <div class="nav-tile-grid" id="nav-goal-tiles" role="listbox" aria-label="Select learning goal"></div>
            </div>
            <!-- Stage 4: Activity Type -->
            <div class="nav-stage" id="nav-stage-activity" data-stage="activity" hidden>
              <h3 class="nav-stage-label">Activity Type</h3>
              <div class="nav-tile-grid" id="nav-activity-tiles" role="listbox" aria-label="Select activity type"></div>
            </div>
            <!-- Stage 5: Assessment list -->
            <div class="nav-stage" id="nav-stage-assessments" data-stage="assessments" hidden>
              <h3 class="nav-stage-label">Assessments</h3>
              <div id="nav-assessment-list" class="nav-assessment-list" role="listbox" aria-label="Select assessment"></div>
            </div>
          </div>

          <!-- Mode + Start -->
          <div class="nav-actions" id="nav-actions" hidden>
            <fieldset class="mode-control compact">
              <legend>Mode</legend>
              <div class="mode-segments">
                <label class="mode-segment">
                  <input type="radio" name="nav-mode" value="practice" checked />
                  <span>Practice</span>
                </label>
                <label class="mode-segment">
                  <input type="radio" name="nav-mode" value="scored" />
                  <span>Scored</span>
                </label>
              </div>
            </fieldset>
            <button class="primary action-button" id="nav-start-attempt">Start Selected</button>
          </div>

          <!-- Error fallback message -->
          <p class="nav-error" id="nav-error" hidden></p>
        </section>

        <!-- Classic picker (fallback / legacy) -->
        <details class="classic-picker" id="classic-picker">
          <summary>Classic assessment picker</summary>
          <section class="switcher" aria-labelledby="classic-picker-label">
            <div class="switcher-controls">
              <div class="field compact">
                <label for="category-select">Category</label>
                <select id="category-select"></select>
              </div>
              <div class="field compact wide">
                <label for="assessment-select">Assessment</label>
                <select id="assessment-select"></select>
              </div>
              <fieldset class="mode-control compact">
                <legend>Mode</legend>
                <div class="mode-segments">
                  <label class="mode-segment">
                    <input type="radio" name="mode" value="practice" checked />
                    <span>Practice</span>
                  </label>
                  <label class="mode-segment">
                    <input type="radio" name="mode" value="scored" />
                    <span>Scored</span>
                  </label>
                </div>
              </fieldset>
              <button class="primary action-button" id="start-attempt">Start Selected</button>
            </div>
          </section>
        </details>

        <section class="workspace" id="attempt-panel" aria-live="polite">
          <div id="attempt-content" class="empty-state">Choose an assessment to begin.</div>
        </section>
      </section>


      <section class="view" id="view-create" aria-labelledby="create-title">
        <section class="panel">
          <h2 id="create-title">Create Quiz/Test</h2>
          <p class="muted">Worked Examples are schema-only for now. Create them in YAML/JSON using the project documentation once that section is added.</p>
          <form id="create-form" class="authoring-grid">
            <div class="field">
              <label for="create-title-input">Title</label>
              <input id="create-title-input" name="title" required placeholder="Area Between Curves Practice" />
            </div>
            <div class="field">
              <label for="create-id-input">Stable ID</label>
              <input id="create-id-input" name="id" required placeholder="area-between-curves-practice" />
            </div>
            <div class="field">
              <label for="create-type">Type</label>
              <select id="create-type" name="assessmentType">
                <option value="quiz">Quiz</option>
                <option value="test">Test</option>
              </select>
            </div>
            <div class="field">
              <label for="create-category">Category</label>
              <select id="create-category" name="categoryId"></select>
            </div>
            <div class="field">
              <label for="create-subcategory">Subcategory</label>
              <select id="create-subcategory" name="subcategoryId"></select>
            </div>
            <div class="field">
              <label for="create-mode">Default mode</label>
              <select id="create-mode" name="modeDefault">
                <option value="practice">Practice</option>
                <option value="scored">Scored</option>
              </select>
            </div>
            <label class="checkbox-line">
              <input id="create-randomize" name="randomizeQuestions" type="checkbox" checked />
              Randomize question order
            </label>

            <section class="author-section">
              <div class="section-header">
                <h3>Questions</h3>
                <button type="button" id="add-question">Add Question</button>
              </div>
              <div id="question-editor-list" class="question-editor-list"></div>
            </section>

            <section class="author-section">
              <div class="section-header">
                <h3>Preview</h3>
                <button type="button" id="refresh-preview">Refresh Preview</button>
              </div>
              <pre id="assessment-preview" class="preview-panel"></pre>
            </section>

            <div class="button-row">
              <button class="primary chunky" type="submit">Save Assessment</button>
              <button type="button" id="validate-draft">Validate Draft</button>
            </div>
          </form>
          <p id="create-status" class="muted" role="status"></p>
        </section>
      </section>

      <section class="view" id="view-settings" aria-labelledby="settings-title">
        <section class="panel">
          <h2 id="settings-title">Settings</h2>
          <form id="settings-form" class="settings-grid">
            <div class="field">
              <label for="default-mode">Default mode</label>
              <select id="default-mode" name="defaultMode">
                <option value="practice">Practice</option>
                <option value="scored">Scored</option>
              </select>
            </div>
            <div class="field">
              <label for="default-question-order">Question order</label>
              <select id="default-question-order" name="defaultQuestionOrder">
                <option value="randomized">Randomized</option>
                <option value="static">Static</option>
              </select>
            </div>
            <div class="field">
              <label for="default-quiz-length">Default quiz length</label>
              <input id="default-quiz-length" name="defaultQuizLength" type="number" min="1" max="50" />
            </div>
            <div class="field">
              <label for="default-test-length">Default test length</label>
              <input id="default-test-length" name="defaultTestLength" type="number" min="1" max="200" />
            </div>
            <div class="field">
              <label for="question-timer">Question timer seconds</label>
              <input id="question-timer" name="questionTimerSeconds" type="number" min="0" placeholder="None" />
            </div>
            <div class="field">
              <label for="assessment-timer">Assessment timer seconds</label>
              <input id="assessment-timer" name="assessmentTimerSeconds" type="number" min="0" placeholder="None" />
            </div>
            <div class="field">
              <label for="code-runner-base-url">Code runner URL</label>
              <input id="code-runner-base-url" name="codeRunnerBaseUrl" placeholder="http://localhost:2000/api/v2" />
            </div>
            <div class="field">
              <label for="code-runner-compile-timeout">Compile timeout ms</label>
              <input id="code-runner-compile-timeout" name="codeRunnerCompileTimeoutMs" type="number" min="1" />
            </div>
            <div class="field">
              <label for="code-runner-run-timeout">Run timeout ms</label>
              <input id="code-runner-run-timeout" name="codeRunnerRunTimeoutMs" type="number" min="1" />
            </div>
            <label class="checkbox-line">
              <input id="commit-scored" name="commitScoredAttemptsAutomatically" type="checkbox" />
              Commit scored attempts automatically
            </label>
            <button class="primary" type="submit">Save Settings</button>
          </form>
          <p id="settings-status" class="muted" role="status"></p>
        </section>
      </section>

      <section class="view" id="view-grades" aria-labelledby="grades-title">
        <section class="panel">
          <div class="section-header">
            <h2 id="grades-title">Grade Log</h2>
            <button id="refresh-grades">Refresh</button>
          </div>
          <div id="grade-summary" class="empty-state">No grade entries loaded yet.</div>
          <section class="author-section">
            <h3>Attempt History</h3>
            <div id="attempt-history" class="empty-state">No attempts loaded yet.</div>
          </section>
        </section>
      </section>
    </main>

    <script>
      import { unified } from "unified";
      import remarkParse from "remark-parse";
      import remarkMath from "remark-math";
      import remarkRehype from "remark-rehype";
      import rehypeKatex from "rehype-katex";
      import rehypeStringify from "rehype-stringify";
      import { EditorView, basicSetup } from "codemirror";
      import { createCodeEditor } from "../scripts/codeEditor";
      import { keymap } from "@codemirror/view";
      import { indentWithTab } from "@codemirror/commands";
      import { python } from "@codemirror/lang-python";
      import { cpp } from "@codemirror/lang-cpp";
      import { ComputeEngine } from "@cortex-js/compute-engine";
      import "mathlive";
      import { CircuitCanvas } from "../scripts/CircuitCanvas";
      import type { CircuitDiagram, CircuitComponent, CircuitNode, CircuitWire } from "../scripts/CircuitCanvas";

      type AssessmentMode = "practice" | "scored";
      type AssessmentType = "quiz" | "test" | "workedExample" | "guidedProject" | "recallDrill" | "conceptLesson" | "interactiveExploration";
      type QuestionType = "multipleChoice" | "selectAll" | "freeResponse" | "numericResponse" | "code" | "symbolicResponse" | "circuit" | "multipart";

      interface CircuitQuestionDefinition {
        schemaVersion: number;
        catalogVersion: number;
        interactionMode: string;
        paletteSymbolIds: string[];
        editableProperties: string[];
        diagram: CircuitDiagram;
      }

      interface SubmittedCircuitAnswer {
        selectedComponentIds?: string[] | null;
        selectedNodeIds?: string[] | null;
        selectedBranchIds?: string[] | null;
        meterType?: string | null;
        meterTargetBranchId?: string | null;
        meterTargetNodeIds?: string[] | null;
        meterPositiveTerminalId?: string | null;
        meterNegativeTerminalId?: string | null;
        values?: Record<string, string> | null;
        builtDiagram?: CircuitDiagram | null;
      }

      interface CircuitFeedback {
        missingComponents: string[];
        extraComponents: string[];
        incorrectComponentTypes: string[];
        missingConnections: string[];
        extraConnections: string[];
        incorrectSelectedTargets: string[];
        incorrectMeterPlacement: boolean | null;
        incorrectPolarity: boolean | null;
        incorrectValues: Record<string, string>;
        expectedHighlightTargetIds: string[];
      }
      type AttemptStatus = "inProgress" | "paused" | "completed" | "abandoned";
      type RecallItemType = "typed" | "symbolic" | "flashcard" | "cloze";
      type RecallRating = "unknown" | "easy" | "correct" | "needsReview" | "forgotCompletely";

      interface AppSettings {
        schemaVersion: number;
        defaultMode: AssessmentMode;
        defaultQuestionOrder: "randomized" | "static";
        defaultQuizLength: number;
        defaultTestLength: number;
        questionTimerSeconds: number | null;
        assessmentTimerSeconds: number | null;
        commitScoredAttemptsAutomatically: boolean;
        codeRunnerBaseUrl: string;
        codeRunnerCompileTimeoutMs: number;
        codeRunnerRunTimeoutMs: number;
      }

      interface Category {
        id: string;
        title: string;
        description?: string | null;
        subcategories: SubCategory[];
      }

      interface SubCategory {
        id: string;
        title: string;
        description?: string | null;
      }

      interface AssessmentSummary {
        id: string;
        title: string;
        assessmentType: AssessmentType;
        questionCount: number;
        authoredQuestionCount?: number;
        attemptQuestionCount?: number | null;
      }

      interface NavigationCatalog {
        subjects: NavigationSubject[];
        areas: NavigationArea[];
        topics: NavigationTopic[];
        goals: NavigationGoal[];
        assessments: NavigationAssessment[];
      }

      interface NavigationRecommendation {
        topicId: string;
        areaIds: string[];
        state: "learn" | "recall" | "practice" | "review" | "evaluate";
        recommendedLearningGoal: string;
        recommendedActivityTypes: string[];
        suggestedAssessmentIds: string[];
        completedLearnCount: number;
        completedRecallCount: number;
        eligibleMasteryAttemptCount: number;
        masteryPercent: number | null;
        provisionalMastery: boolean;
      }

      interface NavigationSubject {
        id: string;
        title: string;
        description?: string | null;
      }

      interface NavigationArea {
        id: string;
        title: string;
        subjectIds: string[];
        topicIds: string[];
        description?: string | null;
      }

      interface NavigationTopic {
        id: string;
        title: string;
        subjectId: string;
        description?: string | null;
      }

      interface NavigationGoal {
        id: string;
        label: string;
        activityTypes: string[];
      }

      interface NavigationAssessment extends AssessmentSummary {
        subjectId: string;
        areaIds: string[];
        topicIds: string[];
        learningGoal: string;
        activityType: string;
        tags: string[];
      }

      interface MediaAsset {
        type: "image";
        src: string;
        alt: string;
        caption?: string | null;
      }

      interface ChoiceOption {
        id: string;
        text: string;
        media?: MediaAsset[];
      }

      interface Question {
        id: string;
        type: QuestionType;
        prompt: string;
        choices: ChoiceOption[];
        media?: MediaAsset[];
        answer?: {
          choiceId?: string;
          choiceIds?: string[];
          expected?: string;
          gradingMode?: string;
          numericValue?: number | null;
          numericTolerance?: number | null;
          expectedLatex?: string | null;
          equivalenceMode?: "expression" | "derivative" | string | null;
          variables?: string[];
          tolerance?: number | null;
          media?: MediaAsset[];
          keyPoints?: string[];
          circuitAnswer?: any;
        };
        language?: "python" | "cpp";
        functionName?: string;
        starterCode?: string;
        tests?: CodeQuestionTest[];
        explanation?: string | null;
        circuitQuestion?: CircuitQuestionDefinition;
        parts?: Question[];
      }

      interface CodeQuestionTest {
        input: string;
        expected: string;
      }

      interface WorkedExample {
        id: string;
        title: string;
        problem: string;
        steps: WorkedExampleStep[];
      }

      interface WorkedExampleStep {
        id: string;
        title: string;
        instruction: string;
        hint: string | null;
        question?: Question;
        type?: QuestionType;
        prompt?: string;
        choices?: ChoiceOption[];
        media?: MediaAsset[];
        answer?: Question["answer"];
        language?: "python" | "cpp";
        functionName?: string;
        starterCode?: string;
        tests?: CodeQuestionTest[];
        explanation?: string | null;
      }

      interface GuidedProject {
        language: "cpp" | "python";
        instructions: string;
        files: GuidedProjectFile[];
        requiredChecks: GuidedProjectCheck[];
        bonusChecks: GuidedProjectCheck[];
      }

      interface GuidedProjectFile {
        path: string;
        content: string;
        readOnly: boolean;
      }

      interface GuidedProjectCheck {
        id: string;
        title: string;
        description: string;
        testCode: string;
        expectedOutputContains: string[];
      }

      interface GuidedProjectSession {
        attemptId: string;
        assessmentId: string;
        files: GuidedProjectFile[];
        checkResults: GuidedProjectCheckResult[];
        updatedAt: string;
      }

      interface GuidedProjectCheckResult {
        checkId: string;
        title: string;
        required: boolean;
        passed: boolean;
        output: string | null;
        compileOutput: string | null;
        error: string | null;
        ranAt: string;
      }

      interface GuidedProjectRunResult {
        session: GuidedProjectSession;
        allRequiredPassed: boolean;
      }

      interface RecallItem {
        id: string;
        type: RecallItemType;
        prompt: string;
        answer: {
          expected?: string | null;
          expectedLatex?: string | null;
          aliases?: string[];
          media?: MediaAsset[];
        };
        explanation?: string | null;
        tags: string[];
      }

      interface LearningSection {
        id: string;
        title: string;
        required: boolean;
        content: string;
        media: MediaAsset[];
        check: Question | null;
      }

      interface ConceptLesson {
        introduction: string;
        sections: LearningSection[];
      }

      interface ExplorationOption {
        value: string;
        label: string;
      }

      interface ExplorationControl {
        id: string;
        type: "slider" | "number" | "select" | "toggle";
        label: string;
        min: number | null;
        max: number | null;
        step: number | null;
        defaultValue: string;
        options: ExplorationOption[];
      }

      interface ExplorationView {
        id: string;
        type: "readout" | "conditionalText" | "table" | "plot";
        label: string;
        expression: string | null;
        condition: string | null;
        content: string | null;
        inputControlId: string | null;
        start: number | null;
        end: number | null;
        step: number | null;
      }

      interface ExplorationSection {
        id: string;
        title: string;
        required: boolean;
        instruction: string;
        controls: ExplorationControl[];
        views: ExplorationView[];
        check: Question | null;
      }

      interface InteractiveExploration {
        introduction: string;
        sections: ExplorationSection[];
      }

      interface Assessment {
        id: string;
        title: string;
        assessmentType: AssessmentType;
        attemptQuestionCount?: number | null;
        questions: Question[];
        workedExamples?: WorkedExample[];
        guidedProject?: GuidedProject | null;
        items?: RecallItem[];
        lesson?: ConceptLesson | null;
        exploration?: InteractiveExploration | null;
      }

      interface Attempt {
        id: string;
        assessmentId: string;
        mode: AssessmentMode;
        status: AttemptStatus;
        questionOrder: string[];
        recallItems?: RecallItemAttempt[];
        learningSections?: LearningSectionAttempt[];
      }

      interface LearningSectionAttempt {
        sectionId: string;
        visited: boolean;
        interactionChanged: boolean;
        completed: boolean;
        controlValues: Record<string, unknown>;
        updatedAt: string;
      }

      interface RecallItemAttempt {
        itemId: string;
        userResponse: string | null;
        answerRevealed: boolean;
        rating: RecallRating;
        updatedAt: string;
      }

      interface SubmittedAnswer {
        questionId: string;
        choiceId: string | null;
        choiceIds: string[];
        freeResponseText: string | null;
        selfCheckCorrect: boolean | null;
        numericValue: number | null;
        codeText: string | null;
        symbolicLatex: string | null;
        circuitAnswer?: SubmittedCircuitAnswer | null;
        partAnswers?: SubmittedAnswer[];
      }

      interface CodeFeedback {
        tests: CodeFeedbackTest[];
        compileOutput: string | null;
        runOutput: string | null;
        error: string | null;
      }

      interface CodeFeedbackTest {
        index: number;
        input: string;
        expected: string;
        actual: string | null;
        passed: boolean;
      }

      interface SymbolicFeedback {
        parseSucceeded: boolean;
        normalizedSubmitted: string | null;
        normalizedExpected: string | null;
        equivalenceMode: string;
        reason: string | null;
      }

      interface QuestionResult {
        questionId: string;
        prompt: string;
        type: QuestionType;
        media?: MediaAsset[];
        submittedAnswer: SubmittedAnswer | null;
        isCorrect: boolean | null;
        explanation: string | null;
        expectedAnswer: string | null;
        codeFeedback: CodeFeedback | null;
        symbolicFeedback: SymbolicFeedback | null;
        circuitFeedback?: CircuitFeedback | null;
        title: string | null;
        instruction: string | null;
        hint: string | null;
        exampleId: string | null;
        exampleTitle: string | null;
        problem: string | null;
        keyPoints: string[];
        isPendingSelfCheck: boolean;
        earnedPoints?: number;
        possiblePoints?: number;
        partResults?: QuestionResult[];
      }

      interface AttemptResults {
        attemptId: string;
        assessmentTitle: string;
        assessmentType: AssessmentType;
        mode: AssessmentMode;
        status: AttemptStatus;
        correctCount: number;
        totalQuestions: number;
        percentScore: number;
        isComplete: boolean;
        hasPendingSelfChecks: boolean;
        earnedPoints: number;
        possiblePoints: number;
        questions: QuestionResult[];
        recallSummary: RecallDrillSummary | null;
        recallItems: RecallItemResult[];
        learningSections: LearningSectionResult[];
      }

      interface LearningSectionResult {
        sectionId: string;
        title: string;
        required: boolean;
        visited: boolean;
        interactionChanged: boolean;
        completed: boolean;
        unlocked: boolean;
        controlValues: Record<string, unknown>;
        check: QuestionResult | null;
      }

      interface RecallDrillSummary {
        itemsReviewed: number;
        easyCount: number;
        correctCount: number;
        needsReviewCount: number;
        forgotCompletelyCount: number;
        weakTags: string[];
      }

      interface RecallItemResult {
        itemId: string;
        type: RecallItemType;
        prompt: string;
        userResponse: string | null;
        answerRevealed: boolean;
        rating: RecallRating;
        expected: string | null;
        expectedLatex: string | null;
        aliases: string[];
        explanation: string | null;
        tags: string[];
        media: MediaAsset[];
      }

      interface AttemptSessionResponse {
        attempt: Attempt;
        assessment: Assessment;
        results: AttemptResults;
      }

      interface GradeLogEntry {
        attemptId: string;
        assessmentId: string;
        assessmentTitle: string;
        mode: AssessmentMode;
        correctCount: number;
        totalQuestions: number;
        percentScore: number;
        committedAt: string;
      }

      interface AnalyticsFocus {
        id: string;
        title: string;
        attemptCount: number;
        averagePercent: number;
      }

      interface CategoryGradeAnalytics {
        categoryId: string;
        categoryTitle: string;
        attemptCount: number;
        averagePercent: number;
        lastPercent: number | null;
      }

      interface AreaGradeAnalytics {
        areaId: string;
        areaTitle: string;
        attemptCount: number;
        averagePercent: number;
        weakestSubcategoryId: string | null;
        weakestSubcategoryTitle: string | null;
      }

      interface QuestionTypePerformance {
        questionType: QuestionType;
        answeredCount: number;
        correctCount: number;
        needsReviewCount: number;
        correctPercent: number;
      }

      interface WeakFocusSummary {
        id: string;
        title: string;
        focusType: string;
        attemptCount: number;
        averagePercent: number;
        message: string;
      }

