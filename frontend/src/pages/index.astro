          return `
            <div class="field">
              <label for="${idPrefix}free-response">Your response</label>
              <textarea id="${idPrefix}free-response" name="${idPrefix}freeResponseText" rows="5">${escapeHtml(submittedAnswer?.freeResponseText ?? "")}</textarea>
            </div>
          `;
        }

        return `
          <div class="field">
            <label for="${idPrefix}free-response">Your response</label>
            <textarea id="${idPrefix}free-response" name="${idPrefix}freeResponseText" rows="5">${escapeHtml(submittedAnswer?.freeResponseText ?? "")}</textarea>
          </div>
        `;
      }

      function displayedChoices(question: Question) {
        const supportsChoiceRandomization = state.assessment?.assessmentType === "quiz"
          || state.assessment?.assessmentType === "test"
          || state.assessment?.assessmentType === "workedExample"
          || state.assessment?.assessmentType === "conceptLesson";
        if (!supportsChoiceRandomization
          || question.type !== "multipleChoice"
          || !state.attempt) {
          return question.choices;
        }

        return seededShuffle(question.choices, `${state.attempt.id}:${question.id}`);
      }

      function seededShuffle<T>(values: readonly T[], seedText: string) {
        const shuffled = [...values];
        let stateValue = hashSeed(seedText);
        for (let index = shuffled.length - 1; index > 0; index -= 1) {
          stateValue = nextSeededValue(stateValue);
          const swapIndex = Math.floor((stateValue / 0x100000000) * (index + 1));
          [shuffled[index], shuffled[swapIndex]] = [shuffled[swapIndex], shuffled[index]];
        }
        return shuffled;
      }

      function hashSeed(value: string) {
        let hash = 2166136261;
        for (let index = 0; index < value.length; index += 1) {
          hash ^= value.charCodeAt(index);
          hash = Math.imul(hash, 16777619);
        }
        return hash >>> 0;
      }

      function nextSeededValue(value: number) {
        let next = value >>> 0;
        next ^= next << 13;
        next ^= next >>> 17;
        next ^= next << 5;
        return next >>> 0;
      }

      async function renderChoiceCard(choice: ChoiceOption, index: number, role: "radio" | "checkbox", submittedAnswer: SubmittedAnswer | null, idPrefix: string = "") {
        const isSelectAll = role === "checkbox";
        const shortcut = choiceShortcut(index);
        const choiceHtml = await renderMarkdown(choice.text);
        const selected = isSelectAll
          ? submittedAnswer?.choiceIds?.includes(choice.id) == true
          : submittedAnswer?.choiceId === choice.id;

        return `
          <button
            type="button"
            class="choice-card ${isSelectAll ? "select-card" : ""} ${selected ? "selected" : ""}"
            role="${role}"
            aria-checked="${selected}"
            data-choice-id="${escapeHtml(choice.id)}"
            data-shortcut="${shortcut}"
          >
            <span class="choice-key" aria-hidden="true">${shortcut}</span>
            <span class="choice-text markdown">${choiceHtml}${renderMedia(choice.media ?? [])}</span>
            ${isSelectAll ? `<span class="choice-check" aria-hidden="true">&#10003;</span>` : ""}
          </button>
        `;
      }

      function renderCodeFeedback(feedback: CodeFeedback | null | undefined) {
        if (!feedback) return "";

        const testRows = feedback.tests.map((test) => `
          <tr>
            <td>${test.index}</td>
            <td>${escapeHtml(test.input)}</td>
            <td>${escapeHtml(test.expected)}</td>
            <td>${escapeHtml(test.actual ?? "")}</td>
            <td>${test.passed ? "Pass" : "Fail"}</td>
          </tr>
        `).join("");

        return `
          <div class="code-feedback">
            <table>
              <thead><tr><th>#</th><th>Input</th><th>Expected</th><th>Actual</th><th>Result</th></tr></thead>
              <tbody>${testRows}</tbody>
            </table>
            ${feedback.compileOutput ? `<pre>${escapeHtml(feedback.compileOutput)}</pre>` : ""}
            ${feedback.runOutput && feedback.tests.some((test) => !test.passed) ? `<pre>${escapeHtml(feedback.runOutput)}</pre>` : ""}
            ${feedback.error ? `<pre>${escapeHtml(feedback.error)}</pre>` : ""}
          </div>
        `;
      }

      async function renderSymbolicFeedback(feedback: SymbolicFeedback | null | undefined) {
        if (!feedback) return "";
        const submittedHtml = feedback.normalizedSubmitted ? await renderMarkdown(`$${feedback.normalizedSubmitted}$`) : "";
        const expectedHtml = feedback.normalizedExpected ? await renderMarkdown(`$${feedback.normalizedExpected}$`) : "";

        return `
          <div class="symbolic-feedback">
            <p><strong>${feedback.parseSucceeded ? "Equivalence check" : "Parse check"}:</strong> ${escapeHtml(feedback.reason ?? "No details returned.")}</p>
            <dl>
              <div><dt>Mode</dt><dd>${escapeHtml(feedback.equivalenceMode)}</dd></div>
              ${submittedHtml ? `<div><dt>Your answer</dt><dd class="markdown">${submittedHtml}</dd></div>` : ""}
              ${expectedHtml ? `<div><dt>Expected</dt><dd class="markdown">${expectedHtml}</dd></div>` : ""}
            </dl>
          </div>
        `;
      }

      async function renderFreeResponseSelfCheck(result: QuestionResult | null | undefined, allowSelfCheck: boolean) {
        if (!allowSelfCheck || !result || result.type !== "freeResponse" || !result.submittedAnswer?.freeResponseText) return "";
        if (state.attempt?.mode === "scored" && state.attempt?.status === "inProgress") return "";

        const expectedHtml = result.expectedAnswer ? await renderMarkdown(result.expectedAnswer) : "";
        const explanationHtml = result.explanation ? await renderMarkdown(result.explanation) : "";
        const keyPoints = result.keyPoints ?? [];
        const status = result.isPendingSelfCheck
          ? "Awaiting self-check"
          : result.isCorrect ? "Marked correct" : "Marked needs review";

        return `
          <div class="self-check-panel ${result.isPendingSelfCheck ? "pending" : result.isCorrect ? "correct" : "incorrect"}">
            <div class="section-header">
              <h3>Self-check</h3>
              <span>${status}</span>
            </div>
            <div class="result-detail">
              <strong>Your response:</strong>
              <p>${escapeHtml(result.submittedAnswer.freeResponseText)}</p>
            </div>
            ${expectedHtml ? `<div class="result-detail"><strong>Expected:</strong><div class="markdown">${expectedHtml}</div></div>` : ""}
            ${keyPoints.length > 0 ? `
              <div class="result-detail">
                <strong>Key points:</strong>
                <ul class="key-point-list">
                  ${keyPoints.map((point) => `<li>${escapeHtml(point)}</li>`).join("")}
                </ul>
              </div>
            ` : ""}
            ${explanationHtml ? `<details open><summary>Explanation</summary><div class="markdown">${explanationHtml}</div></details>` : ""}
            ${result.isPendingSelfCheck ? `
              <div class="button-row">
                <button class="primary chunky" type="button" data-self-check="true" data-question-id="${escapeHtml(result.questionId)}">Mark Correct</button>
                <button class="chunky secondary-action" type="button" data-self-check="false" data-question-id="${escapeHtml(result.questionId)}">Mark Needs Review</button>
              </div>
            ` : ""}
          </div>
        `;
      }

      
      function readPartAnswer(question: Question, answerForm: HTMLFormElement, form: FormData, idPrefix: string = ""): SubmittedAnswer {
        
        if (question.type === "multipart") {
          const answerForm = getActiveAnswerForm();
          if (!answerForm) throw new Error("Form not found");
          const form = new FormData(answerForm);
          return {
            questionId: question.id,
            choiceId: null,
            choiceIds: [],
            freeResponseText: null,
            selfCheckCorrect: null,
            numericValue: null,
            codeText: null,
            symbolicLatex: null,
            partAnswers: question.parts?.map(p => readPartAnswer(p, answerForm, form, `${p.id}-`)) ?? []
          };
        }

        if (question.type === "circuit") {
          const mount = document.querySelector<HTMLElement>(`#${idPrefix}circuit-editor-mount`);
          // Note: In a full impl we need to extract from multiple activeCircuitCanvases
          // For now we just return null or empty to avoid breaking
        }
        
        const partScope = idPrefix ? document.querySelector<HTMLElement>(`#part-container-${idPrefix}`) || answerForm : answerForm;
        const selectedCards = Array.from(partScope.querySelectorAll<HTMLButtonElement>(".choice-card.selected"));

        return {
          questionId: question.id,
          choiceId: question.type === "multipleChoice" ? selectedCards[0]?.dataset.choiceId ?? null : null,
          choiceIds: question.type === "selectAll" ? selectedCards.map((card) => card.dataset.choiceId ?? "") : [],
          freeResponseText: question.type === "freeResponse" ? String(form.get(`${idPrefix}freeResponseText`) ?? "") : null,
          selfCheckCorrect: null,
          numericValue: question.type === "numericResponse" ? nullableNumber(form.get(`${idPrefix}numericValue`)) : null,
          codeText: question.type === "code" ? readCodeText(form, idPrefix) : null,
          symbolicLatex: question.type === "symbolicResponse" ? readSymbolicLatex(idPrefix) : null
        };
      }

      function readAnswer(question: Question) {
        
        if (question.type === "multipart") {
          const answerForm = getActiveAnswerForm();
          if (!answerForm) throw new Error("Form not found");
          const form = new FormData(answerForm);
          return {
            questionId: question.id,
            choiceId: null,
            choiceIds: [],
            freeResponseText: null,
            selfCheckCorrect: null,
            numericValue: null,
            codeText: null,
            symbolicLatex: null,
            partAnswers: question.parts?.map(p => readPartAnswer(p, answerForm, form, `${p.id}-`)) ?? []
          };
        }

        if (question.type === "circuit") {
          if (activeCircuitCanvas) {
            const diag = activeCircuitCanvas.getDiagram();
            const selectedIds = activeCircuitCanvas.getSelectedIds();
            const meterType = activeCircuitCanvas.getMeterType();
            const meterPosTarget = activeCircuitCanvas.getMeterPositiveTerminalId();
            const meterNegTarget = activeCircuitCanvas.getMeterNegativeTerminalId();
            const meterBranchTarget = activeCircuitCanvas.getMeterTargetBranchId();
            const values = activeCircuitCanvas.getValues();

            const selectedComponentIds = selectedIds.filter(id => diag.components.some(c => c.id === id));
            const selectedNodeIds = selectedIds.filter(id => diag.nodes.some(n => n.id === id));
            const selectedBranchIds = selectedIds.filter(id => diag.wires.some(w => w.id === id));

            let meterTargetNodeIds: string[] | null = null;
            if (meterType === "voltmeter") {
              meterTargetNodeIds = [];
              if (meterPosTarget) meterTargetNodeIds.push(meterPosTarget);
              if (meterNegTarget) meterTargetNodeIds.push(meterNegTarget);
            }

            return {
              questionId: question.id,
              choiceId: null,
              choiceIds: [],
              freeResponseText: null,
              selfCheckCorrect: null,
              numericValue: null,
              codeText: null,
              symbolicLatex: null,
              circuitAnswer: {
                selectedComponentIds: selectedComponentIds.length > 0 ? selectedComponentIds : null,
                selectedNodeIds: selectedNodeIds.length > 0 ? selectedNodeIds : null,
                selectedBranchIds: selectedBranchIds.length > 0 ? selectedBranchIds : null,
                meterType: meterType || null,
                meterTargetBranchId: meterBranchTarget || null,
                meterTargetNodeIds: meterTargetNodeIds,
                meterPositiveTerminalId: meterPosTarget || null,
                meterNegativeTerminalId: meterNegTarget || null,
                values: Object.keys(values).length > 0 ? values : null,
                builtDiagram: diag
              }
            };
          }
        }

        const answerForm = getActiveAnswerForm();
        if (!answerForm) {
          throw new Error("The active answer form could not be found.");
        }
        const form = new FormData(answerForm);
        const selectedCards = Array.from(answerForm.querySelectorAll<HTMLButtonElement>(".choice-card.selected"));

        return {
          questionId: question.id,
          choiceId: question.type === "multipleChoice" ? selectedCards[0]?.dataset.choiceId ?? null : null,
          choiceIds: question.type === "selectAll" ? selectedCards.map((card) => card.dataset.choiceId ?? "") : [],
          freeResponseText: question.type === "freeResponse" ? String(form.get("freeResponseText") ?? "") : null,
          selfCheckCorrect: null,
          numericValue: question.type === "numericResponse" ? nullableNumber(form.get("numericValue")) : null,
          codeText: question.type === "code" ? readCodeText(form) : null,
          symbolicLatex: question.type === "symbolicResponse" ? readSymbolicLatex() : null
        };
      }

      function setupCircuitEditor(question: Question, submittedAnswer: SubmittedAnswer | null = null) {
        activeCircuitCanvas?.destroy();
        activeCircuitCanvas = null;
        if (question.type !== "circuit") return;

        const container = document.querySelector<HTMLElement>("#circuit-editor-mount");
        if (!container) return;

        const def = question.circuitQuestion || {
          schemaVersion: 1,
          catalogVersion: 1,
          interactionMode: "build",
          paletteSymbolIds: ["resistor", "battery", "capacitor", "junction"],
          editableProperties: ["value", "label", "rotation"],
          diagram: { width: 600, height: 400, components: [], nodes: [], wires: [], annotations: [] }
        };

        let startDiagram = def.diagram;
        if (def.interactionMode === "build") {
          if (submittedAnswer?.circuitAnswer?.builtDiagram) {
            startDiagram = submittedAnswer.circuitAnswer.builtDiagram;
          } else {
            startDiagram = {
              width: def.diagram.width,
              height: def.diagram.height,
              components: [],
              nodes: [],
              wires: [],
              annotations: []
            };
          }
        }

        activeCircuitCanvas = new CircuitCanvas(
          container,
          startDiagram,
          def.interactionMode,
          () => {}
        );

        // Restore submitted state
        if (submittedAnswer?.circuitAnswer) {
          const ca = submittedAnswer.circuitAnswer;
          activeCircuitCanvas.restoreState({
            selectedIds: [
              ...(ca.selectedComponentIds ?? []),
              ...(ca.selectedNodeIds ?? []),
              ...(ca.selectedBranchIds ?? [])
            ],
            meterType: ca.meterType ?? null,
            meterPositiveTerminalId: ca.meterPositiveTerminalId ?? null,
            meterNegativeTerminalId: ca.meterNegativeTerminalId ?? null,
            meterTargetBranchId: ca.meterTargetBranchId ?? null,
            values: ca.values ?? null
          });
        }

        // Setup toolbars based on mode
        if (def.interactionMode === "meterPlacement") {
          const meterVoltmeterBtn = document.querySelector<HTMLButtonElement>("#tool-voltmeter");
          const meterAmmeterBtn = document.querySelector<HTMLButtonElement>("#tool-ammeter");
          const meterClearBtn = document.querySelector<HTMLButtonElement>("#tool-clear-meter");

          const updateMeterToolActive = (type: string | null) => {
            meterVoltmeterBtn?.classList.toggle("active", type === "voltmeter");
            meterAmmeterBtn?.classList.toggle("active", type === "ammeter");
            meterClearBtn?.classList.toggle("active", type === null);
          };

          meterVoltmeterBtn?.addEventListener("click", () => {
            activeCircuitCanvas?.setMeterType("voltmeter");
            updateMeterToolActive("voltmeter");
          });
          meterAmmeterBtn?.addEventListener("click", () => {
            activeCircuitCanvas?.setMeterType("ammeter");
            updateMeterToolActive("ammeter");
          });
          meterClearBtn?.addEventListener("click", () => {
            activeCircuitCanvas?.setMeterType(null);
            updateMeterToolActive(null);
          });

          updateMeterToolActive(activeCircuitCanvas.getMeterType());
        } else if (def.interactionMode === "build") {
          document.querySelectorAll(".palette-btn").forEach(btn => {
            btn.addEventListener("click", (e) => {
              const sym = (e.currentTarget as HTMLButtonElement).dataset.symbol;
              if (sym && activeCircuitCanvas) {
                activeCircuitCanvas.addComponent(sym);
              }
            });
          });

          document.querySelector("#btn-circuit-rotate")?.addEventListener("click", () => {
            activeCircuitCanvas?.rotateSelected();
          });

          document.querySelector("#btn-circuit-delete")?.addEventListener("click", () => {
            activeCircuitCanvas?.deleteSelected();
          });

          document.querySelector("#btn-circuit-node")?.addEventListener("click", () => {
            activeCircuitCanvas?.addNode();
          });
        }
      }

      function renderCircuitFeedback(feedback: CircuitFeedback | null | undefined) {
        if (!feedback) return "";

        const items: string[] = [];
        if (feedback.missingComponents?.length > 0) {
          items.push(`<li><strong>Missing components:</strong> ${feedback.missingComponents.map(escapeHtml).join(", ")}</li>`);
        }
        if (feedback.extraComponents?.length > 0) {
          items.push(`<li><strong>Extra components:</strong> ${feedback.extraComponents.map(escapeHtml).join(", ")}</li>`);
        }
        if (feedback.incorrectComponentTypes?.length > 0) {
          items.push(`<li><strong>Incorrect component types:</strong> ${feedback.incorrectComponentTypes.map(escapeHtml).join(", ")}</li>`);
        }
        if (feedback.missingConnections?.length > 0) {
          items.push(`<li><strong>Missing connections:</strong> ${feedback.missingConnections.map(escapeHtml).join(", ")}</li>`);
        }
        if (feedback.extraConnections?.length > 0) {
          items.push(`<li><strong>Extra connections:</strong> ${feedback.extraConnections.map(escapeHtml).join(", ")}</li>`);
        }
        if (feedback.incorrectSelectedTargets?.length > 0) {
          items.push(`<li><strong>Incorrect selections:</strong> ${feedback.incorrectSelectedTargets.map(escapeHtml).join(", ")}</li>`);
        }
        if (feedback.incorrectMeterPlacement === true) {
          items.push(`<li><strong>Meter placement:</strong> Incorrect location. Make sure you place/probe the correct node(s) or wire.</li>`);
        }
        if (feedback.incorrectPolarity === true) {
          items.push(`<li><strong>Meter polarity:</strong> Reverse connection. Positive/negative probes are swapped.</li>`);
        }
        if (feedback.incorrectValues && Object.keys(feedback.incorrectValues).length > 0) {
          const valEntries = Object.entries(feedback.incorrectValues)
            .map(([k, v]) => `${k} (Expected: ${v})`)
            .join(", ");
          items.push(`<li><strong>Incorrect values:</strong> ${escapeHtml(valEntries)}</li>`);
        }

        if (items.length === 0) {
          return `
            <div class="circuit-feedback correct-feedback">
              <p><strong>Circuit check passed:</strong> All components, connections, placements, and values match the expected topology.</p>
            </div>
          `;
        }

        return `
          <div class="circuit-feedback">
            <p><strong>Circuit check details:</strong></p>
            <ul class="circuit-feedback-list">
              ${items.join("")}
            </ul>
          </div>
        `;
      }

      function renderRecallResponseInput(item: RecallItem, value: string, isRevealed: boolean) {
        if (item.type === "flashcard") {
          return `<p class="input-help">Think through the answer first, then reveal it and rate your recall.</p>`;
        }

        if (isRevealed) {
          return value
            ? `<div class="locked-response"><strong>Your recall attempt</strong><p>${escapeHtml(value)}</p></div>`
            : `<div class="locked-response"><strong>Your recall attempt</strong><p class="muted">No response entered.</p></div>`;
        }

        if (item.type === "symbolic") {
          return `
            <div class="field symbolic-response-field">
              <label for="recall-response">Your recalled expression</label>
              <math-field id="recall-response" aria-describedby="recall-response-help">${escapeHtml(value)}</math-field>
              <p id="recall-response-help" class="input-help">This is self-rated in V1. Use the math field to produce the expression from memory.</p>
            </div>
          `;
        }

        return `
          <div class="field">
            <label for="recall-response">${item.type === "cloze" ? "Missing text" : "Your recall attempt"}</label>
            <textarea id="recall-response" rows="4">${escapeHtml(value)}</textarea>
          </div>
        `;
      }

      function readRecallResponse() {
        const mathField = document.querySelector<HTMLElement & { value?: string }>("#recall-response");
        if (mathField?.tagName.toLowerCase() === "math-field") {
          return mathField.value ?? mathField.textContent ?? "";
        }

        return (document.querySelector<HTMLTextAreaElement>("#recall-response")?.value ?? "").trim();
      }

      async function revealCurrentRecallItem() {
        if (!state.attempt || !state.assessment) return;
        const itemId = state.attempt.questionOrder[state.currentIndex];
        const button = document.querySelector<HTMLButtonElement>("#reveal-recall-answer");
        if (button) setBusy(button, "Revealing");

        try {
          const response = await api<{ attempt: Attempt; results: AttemptResults }>(`/attempts/${encodeURIComponent(state.attempt.id)}/recall/${encodeURIComponent(itemId)}/reveal`, {
            method: "POST",
            body: JSON.stringify({ userResponse: readRecallResponse() })
          });
          state.attempt = response.attempt;
          state.latestResults = response.results;
          await renderCurrentRecallItem();
        } finally {
          if (button) clearBusy(button, "Reveal Answer");
        }
      }

      async function rateCurrentRecallItem(rating: RecallRating) {
        if (!state.attempt || !state.assessment) return;
        const itemId = state.attempt.questionOrder[state.currentIndex];
        const response = await api<{ attempt: Attempt; results: AttemptResults }>(`/attempts/${encodeURIComponent(state.attempt.id)}/recall/${encodeURIComponent(itemId)}/rate`, {
          method: "POST",
          body: JSON.stringify({ rating })
        });
        state.attempt = response.attempt;
        state.latestResults = response.results;

        if (state.attempt.status === "completed") {
          updateActiveAttemptChip("Complete");
          updateModeControlLock();
          await renderResults(false);
          await loadGrades();
          return;
        }

        const nextUnratedIndex = state.attempt.questionOrder.findIndex((candidateId) => {
          const result = state.latestResults?.recallItems.find((item) => item.itemId === candidateId);
          return !result || result.rating === "unknown";
        });
        if (nextUnratedIndex >= 0) {
          state.currentIndex = nextUnratedIndex;
        }

        await renderCurrentRecallItem();
        await loadGrades();
      }

      function renderRecallRatingButton(rating: RecallRating, currentRating: RecallRating | undefined) {
        return `
          <button
            type="button"
            class="chunky ${currentRating === rating ? "primary" : "secondary-action"}"
            data-recall-rating="${rating}"
          >${escapeHtml(recallRatingLabel(rating))}</button>
        `;
      }

      function readCodeText(form: FormData, idPrefix: string = "") {
        return String(form.get(`${idPrefix}codeText`) ?? "");
      }

      function setupSelfCheckButtons() {
        document.querySelectorAll<HTMLButtonElement>("[data-self-check]").forEach((button) => {
          button.addEventListener("click", () => {
            const questionId = button.dataset.questionId ?? "";
            const isCorrect = button.dataset.selfCheck === "true";
            void markFreeResponseSelfCheck(questionId, isCorrect);
          });
        });
      }

      function renderQuestionNavigator() {
        if (!state.attempt) return "";

        const answered = new Set((state.latestResults?.questions ?? [])
          .filter((question) => question.submittedAnswer)
          .map((question) => question.questionId));
        const pending = new Set((state.latestResults?.questions ?? [])
          .filter((question) => question.isPendingSelfCheck)
          .map((question) => question.questionId));
        const correct = new Set((state.latestResults?.questions ?? [])
          .filter((question) => question.isCorrect === true)
          .map((question) => question.questionId));
        const needsReview = new Set((state.latestResults?.questions ?? [])
          .filter((question) => question.isCorrect === false && question.submittedAnswer)
          .map((question) => question.questionId));

        return `
          <div class="question-navigator ${state.questionNavigatorOpen ? "open" : ""}">
            <button
              type="button"
              class="question-navigator-toggle"
              aria-expanded="${state.questionNavigatorOpen ? "true" : "false"}"
              aria-controls="question-jump-panel"
            >
              <span>Jump to question</span>
              <strong>${state.currentIndex + 1}/${state.attempt.questionOrder.length}</strong>
            </button>
            <div class="question-navigator-panel" id="question-jump-panel">
              <div class="question-jump-grid">
                ${state.attempt.questionOrder.map((questionId, index) => {
                  const stateClass = pending.has(questionId)
                    ? "pending"
                    : correct.has(questionId)
                      ? "correct"
                      : needsReview.has(questionId)
                        ? "needs-review"
                        : answered.has(questionId)
                          ? "answered"
                          : "unanswered";
                  const stateLabel = {
                    pending: "awaiting self-check",
                    correct: "correct",
                    "needs-review": "needs review",
                    answered: "answered",
                    unanswered: "unanswered"
                  }[stateClass];
                  return `
                    <button
                      type="button"
                      class="question-jump ${stateClass} ${index === state.currentIndex ? "current" : ""}"
                      data-question-index="${index}"
                      aria-current="${index === state.currentIndex ? "step" : "false"}"
                      aria-label="Jump to question ${index + 1}, ${stateLabel}"
                    ><span>${index + 1}</span></button>
                  `;
                }).join("")}
              </div>
              <div class="question-jump-legend">
                <span>Plain: unanswered</span>
                <span>Marked: answered/reviewed</span>
                <span>Current has a heavier border</span>
              </div>
            </div>
          </div>
        `;
      }

      function setupQuestionNavigator() {
        document.querySelector<HTMLButtonElement>(".question-navigator-toggle")?.addEventListener("click", () => {
          state.questionNavigatorOpen = !state.questionNavigatorOpen;
          void renderCurrentQuestion();
        });
        document.querySelectorAll<HTMLButtonElement>("[data-question-index]").forEach((button) => {
          button.addEventListener("click", () => {
            state.questionNavigatorOpen = true;
            state.currentIndex = Number(button.dataset.questionIndex ?? state.currentIndex);
            void renderCurrentQuestion();
          });
        });
      }

      function readSymbolicLatex(idPrefix: string = "") {
        const mathField = document.querySelector<HTMLElement & { value?: string }>(`#${idPrefix}symbolic-response`);
        return mathField?.value ?? mathField?.textContent ?? "";
      }

      function setupChoiceCards(question: Question) {
        if (question.type !== "multipleChoice" && question.type !== "selectAll") return;

        const form = getActiveAnswerForm();
        if (!form) return;
        const cards = Array.from(form.querySelectorAll<HTMLButtonElement>(".choice-card"));

        cards.forEach((card) => {
          card.addEventListener("click", () => {
            if (question.type === "multipleChoice") {
              selectSingleChoice(cards, card);
              return;
            }

            toggleChoiceCard(card);
          });
        });
      }

      function getActiveAnswerForm() {
        return document.querySelector<HTMLFormElement>("#learning-check-form")
          ?? document.querySelector<HTMLFormElement>("#answer-form");
      }

      function setupCodeEditor(question: Question) {
        if (!currentCodeEditors) currentCodeEditors = [];
        currentCodeEditors.forEach(ed => ed.destroy());
        currentCodeEditors = [];

        if (question.type === "multipart") {
          question.parts?.forEach(p => setupCodeEditor(p));
        }

        if (question.type !== "code") return;

        const mounts = document.querySelectorAll<HTMLDivElement>(".code-editor-shell");
        mounts.forEach(mount => {
          const inputId = mount.dataset.inputId;
          if (!inputId) return;
          const hiddenInput = document.querySelector<HTMLInputElement>(`#${inputId}`);
          if (!hiddenInput) return;

          const initialCode = mount.dataset.code ?? hiddenInput.value ?? "";
          hiddenInput.value = initialCode;

          const editor = createCodeEditor({
            parent: mount,
            document: initialCode,
            language: question.language ?? "python",
            onChange: (content) => {
              hiddenInput.value = content;
            }
          });
          currentCodeEditors.push(editor);
        });
      }

      function setupSymbolicResponseField(question: Question) {
        if (question.type !== "symbolicResponse") return;

        const mathField = document.querySelector<HTMLElement & {
          value?: string;
          smartFence?: boolean;
          smartMode?: boolean;
          smartSuperscript?: boolean;
          mathVirtualKeyboardPolicy?: "auto" | "manual" | "sandboxed";
          placeholderSymbol?: string;
          inlineShortcuts?: Record<string, string | { value: string; after?: string }>;
          executeCommand?: (command: string | unknown[]) => unknown;
        }>("#symbolic-response");
        if (!mathField) return;

        mathField.smartFence = true;
        mathField.smartMode = true;
        mathField.smartSuperscript = false;
        mathField.mathVirtualKeyboardPolicy = "manual";
        mathField.placeholderSymbol = "□";
        mathField.inlineShortcuts = {
          sin: "\\sin\\left(\\placeholder{}\\right)",
          cos: "\\cos\\left(\\placeholder{}\\right)",
          tan: "\\tan\\left(\\placeholder{}\\right)",
          sec: "\\sec\\left(\\placeholder{}\\right)",
          csc: "\\csc\\left(\\placeholder{}\\right)",
          cot: "\\cot\\left(\\placeholder{}\\right)",
          sqrt: "\\sqrt{\\placeholder{}}",
          abs: "\\left|\\placeholder{}\\right|",
          pi: "\\pi",
          theta: "\\theta",
          alpha: "\\alpha",
          beta: "\\beta",
          int: "\\int \\placeholder{}\\,d\\placeholder{}",
          infinity: "\\infty"
        };

        mathField.addEventListener("keydown", (event) => {
          const keyboardEvent = event as KeyboardEvent;
          if (keyboardEvent.key === "Tab") {
            keyboardEvent.preventDefault();
            mathField.executeCommand?.(keyboardEvent.shiftKey ? "moveToPreviousGroup" : "moveToNextGroup");
          }

          if (keyboardEvent.key === " " && mathField.executeCommand) {
            keyboardEvent.preventDefault();
            mathField.executeCommand("moveToNextGroup");
          }
        });
      }

      function handleAnswerShortcut(event: KeyboardEvent) {
        if (!state.attempt || !state.assessment) return;
        if (state.assessment.assessmentType === "guidedProject" || state.assessment.assessmentType === "recallDrill") return;

        const target = event.target as HTMLElement;
        if (target.matches("input, textarea, select, math-field")) return;

        let question: Question;
        try {
          question = getCurrentQuestion();
        } catch {
          return;
        }
        if (question.type !== "multipleChoice" && question.type !== "selectAll") return;

        const key = event.key.toUpperCase();
        const card = document.querySelector<HTMLButtonElement>(`.choice-card[data-shortcut="${key}"]`);
        if (!card) return;

        event.preventDefault();
        card.click();
        card.focus();
      }

      function selectSingleChoice(cards: HTMLButtonElement[], selectedCard: HTMLButtonElement) {
        cards.forEach((card) => {
          const isSelected = card === selectedCard;
          card.classList.toggle("selected", isSelected);
          card.setAttribute("aria-checked", String(isSelected));
        });
      }

      function toggleChoiceCard(card: HTMLButtonElement) {
        const isSelected = !card.classList.contains("selected");
        card.classList.toggle("selected", isSelected);
        card.setAttribute("aria-checked", String(isSelected));
      }

      function choiceShortcut(index: number) {
        return String.fromCharCode(65 + index);
      }

      function getCurrentQuestion() {
        if (state.assessment?.assessmentType === "guidedProject") {
          throw new Error("Guided projects do not use question navigation.");
        }

        if (state.assessment?.assessmentType === "recallDrill") {
          throw new Error("Recall drills do not use quiz question navigation.");
        }

        const questionId = state.attempt!.questionOrder[state.currentIndex];
        if (state.assessment?.assessmentType === "conceptLesson") {
          const section = state.assessment.lesson!.sections.find((candidate) => candidate.id === questionId);
          if (!section?.check) throw new Error("This lesson section does not contain a check.");
          return section.check;
        }

        if (state.assessment?.assessmentType === "interactiveExploration") {
          const section = state.assessment.exploration!.sections.find((candidate) => candidate.id === questionId);
          if (!section?.check) throw new Error("This exploration section does not contain a check.");
          return section.check;
        }

        if (state.assessment?.assessmentType === "workedExample") {
          const step = getWorkedExampleSteps().find((candidate) => candidate.id === questionId)!;
          return workedStepToQuestion(step);
        }

        return state.assessment!.questions.find((question) => question.id === questionId)!;
      }

      function workedStepToQuestion(step: WorkedExampleStep): Question {
        const question = step.question;
        return {
          id: step.id,
          type: question?.type ?? step.type ?? "freeResponse",
          prompt: question?.prompt ?? step.prompt ?? "",
          choices: question?.choices ?? step.choices ?? [],
          media: question?.media ?? step.media ?? [],
          answer: question?.answer ?? step.answer,
          language: question?.language ?? step.language,
          functionName: question?.functionName ?? step.functionName,
          starterCode: question?.starterCode ?? step.starterCode,
          tests: question?.tests ?? step.tests,
          explanation: question?.explanation ?? step.explanation
        };
      }

      function getWorkedExampleSteps() {
        return (state.assessment?.workedExamples ?? []).flatMap((example) => example.steps);
      }

      function getWorkedExampleForStep(stepId: string) {
        return (state.assessment?.workedExamples ?? []).find((example) =>
          example.steps.some((step) => step.id === stepId));
      }

      function getAssessmentQuestionIds(assessment: Assessment) {
        if (assessment.assessmentType === "workedExample") {
          return (assessment.workedExamples ?? []).flatMap((example) => example.steps.map((step) => step.id));
        }

        if (assessment.assessmentType === "guidedProject") {
          return [];
        }

        if (assessment.assessmentType === "recallDrill") {
          return assessment.items?.map((item) => item.id) ?? [];
        }

        if (assessment.assessmentType === "conceptLesson") {
          return assessment.lesson?.sections.map((section) => section.id) ?? [];
        }

        if (assessment.assessmentType === "interactiveExploration") {
          return assessment.exploration?.sections.map((section) => section.id) ?? [];
        }

        return assessment.questions.map((question) => question.id);
      }

      function renderDevAssessmentRefreshButton() {
        return IS_DEV
          ? `<button type="button" data-refresh-current-assessment title="Reload the current assessment YAML without ending this session">Refresh Assessment</button>`
          : "";
