      const API_BASE = import.meta.env.PUBLIC_API_BASE ?? "http://localhost:5000/api";
      const IS_DEV = import.meta.env.DEV;
      let currentCodeEditors: EditorView[] = [];
      let currentCodeEditor: EditorView | null = null; // Legacy
      let currentProjectEditor: EditorView | null = null;
      let activeCircuitCanvas: CircuitCanvas | null = null;
      let resultCircuitCanvases: CircuitCanvas[] = [];
      let learningStateTimer: ReturnType<typeof setTimeout> | null = null;
      let pendingLearningSectionState: {
        sectionId: string;
        controlValues: Record<string, unknown>;
      } | null = null;
      const explorationComputeEngine = new ComputeEngine();
      const markdownProcessor = unified()
        .use(remarkParse)
        .use(remarkMath)
        .use(remarkRehype)
        .use(rehypeKatex)
        .use(rehypeStringify);

      const state: {
        settings: AppSettings | null;
        categories: Category[];
        assessments: AssessmentSummary[];
        assessment: Assessment | null;
        attempt: Attempt | null;
        currentIndex: number;
        latestResults: AttemptResults | null;
        guidedProjectSession: GuidedProjectSession | null;
        guidedProjectActiveFile: string;
        committedAttemptIds: Set<string>;
        analytics: GradeAnalyticsSummary | null;
        historyFilters: {
          status: string;
          mode: string;
          assessmentType: string;
          categoryId: string;
          areaId: string;
          questionType: string;
          committed: string;
          score: string;
        };
        historySort: { key: string; direction: "asc" | "desc" };
        selectedAttemptIds: Set<string>;
        questionNavigatorOpen: boolean;
        draftQuestions: Question[];
        navigationCatalog: NavigationCatalog | null;
        navigationRecommendations: NavigationRecommendation[] | null;
        navigationSelection: {
          subjectId: string;
          areaId: string;
          topicId: string;
          goalId: string;
          activityType: string;
          assessmentId: string;
        };
      } = {
        settings: null,
        categories: [],
        assessments: [],
        assessment: null,
        attempt: null,
        currentIndex: 0,
        latestResults: null,
        guidedProjectSession: null,
        guidedProjectActiveFile: "",
        committedAttemptIds: new Set(),
        analytics: null,
        historyFilters: {
          status: "",
          mode: "",
          assessmentType: "",
          categoryId: "",
          areaId: "",
          questionType: "",
          committed: "",
          score: ""
        },
        historySort: { key: "lastActivityAt", direction: "desc" },
        selectedAttemptIds: new Set(),
        questionNavigatorOpen: false,
        draftQuestions: [],
        navigationCatalog: null,
        navigationRecommendations: null,
        navigationSelection: {
          subjectId: "",
          areaId: "",
          topicId: "",
          goalId: "",
          activityType: "",
          assessmentId: ""
        }
      };

      const apiStatus = document.querySelector<HTMLDivElement>("#api-status")!;
      const categorySelect = document.querySelector<HTMLSelectElement>("#category-select")!;
      const assessmentSelect = document.querySelector<HTMLSelectElement>("#assessment-select")!;
      const attemptContent = document.querySelector<HTMLDivElement>("#attempt-content")!;
      const activeAttemptChip = document.querySelector<HTMLDivElement>("#active-attempt-chip")!;
      const createForm = document.querySelector<HTMLFormElement>("#create-form")!;
      const createCategory = document.querySelector<HTMLSelectElement>("#create-category")!;
      const createSubcategory = document.querySelector<HTMLSelectElement>("#create-subcategory")!;
      const createTitleInput = document.querySelector<HTMLInputElement>("#create-title-input")!;
      const createIdInput = document.querySelector<HTMLInputElement>("#create-id-input")!;
      const questionEditorList = document.querySelector<HTMLDivElement>("#question-editor-list")!;
      const assessmentPreview = document.querySelector<HTMLPreElement>("#assessment-preview")!;
      const createStatus = document.querySelector<HTMLParagraphElement>("#create-status")!;
      const settingsForm = document.querySelector<HTMLFormElement>("#settings-form")!;
      const settingsStatus = document.querySelector<HTMLParagraphElement>("#settings-status")!;
      const gradeSummary = document.querySelector<HTMLDivElement>("#grade-summary")!;
      const attemptHistory = document.querySelector<HTMLDivElement>("#attempt-history")!;
      const modeInputs = Array.from(document.querySelectorAll<HTMLInputElement>("input[name='mode'], input[name='nav-mode']"));
      const classicPicker = document.querySelector<HTMLDetailsElement>("#classic-picker")!;
      const navError = document.querySelector<HTMLParagraphElement>("#nav-error")!;
      const navActions = document.querySelector<HTMLDivElement>("#nav-actions")!;
      const navBreadcrumb = document.querySelector<HTMLElement>("#nav-breadcrumb")!;

      document.querySelectorAll<HTMLButtonElement>(".tab").forEach((tab) => {
        tab.addEventListener("click", () => {
          activateTab(tab.dataset.tab ?? "load");
        });
      });

      categorySelect.addEventListener("change", () => loadAssessments(categorySelect.value));
      document.querySelector<HTMLButtonElement>("#start-attempt")!.addEventListener("click", startAttempt);
      document.querySelector<HTMLButtonElement>("#nav-start-attempt")!.addEventListener("click", startNavigationAttempt);
      document.querySelector<HTMLButtonElement>("#refresh-grades")!.addEventListener("click", loadGrades);
      settingsForm.addEventListener("submit", saveSettings);
      document.addEventListener("keydown", handleAnswerShortcut);
      createForm.addEventListener("submit", saveDraftAssessment);
      createCategory.addEventListener("change", () => {
        renderCreateSubcategories();
        renderAssessmentPreview();
      });
      createTitleInput.addEventListener("input", () => {
        if (!createIdInput.dataset.touched) {
          createIdInput.value = slugify(createTitleInput.value);
        }
        renderAssessmentPreview();
      });
      createIdInput.addEventListener("input", () => {
        createIdInput.dataset.touched = "true";
        renderAssessmentPreview();
      });
      createForm.addEventListener("input", (event) => {
        if ((event.target as HTMLElement).closest(".question-editor-list")) {
          syncDraftQuestionsFromDom();
        }
        renderAssessmentPreview();
      });
      document.querySelector<HTMLButtonElement>("#add-question")!.addEventListener("click", () => addDraftQuestion());
      document.querySelector<HTMLButtonElement>("#refresh-preview")!.addEventListener("click", renderAssessmentPreview);
      document.querySelector<HTMLButtonElement>("#validate-draft")!.addEventListener("click", validateDraftAssessment);

      await initialize();

      async function initialize() {
        try {
          state.settings = await api<AppSettings>("/settings");
          state.categories = await api<Category[]>("/categories");
          fillSettingsForm(state.settings);
          renderCategories();
          renderCreateCategories();
          addDraftQuestion();
          await loadAssessments(categorySelect.value);
          await initializeNavigation();
          await loadGrades();
          setApiStatus("Connected", "ok");
        } catch (error) {
          setApiStatus("Backend offline", "error");
          attemptContent.textContent = readableError(error);
        }
      }

      async function loadAssessments(categoryId: string) {
        if (!categoryId) {
          state.assessments = [];
          renderAssessmentOptions();
          return;
        }

        state.assessments = await api<AssessmentSummary[]>(`/assessments?categoryId=${encodeURIComponent(categoryId)}`);
        renderAssessmentOptions();
      }

      async function loadRecommendations() {
        try {
          state.navigationRecommendations = await api<NavigationRecommendation[]>("/navigation/recommendations");
        } catch (error) {
          console.error("Recommendations unavailable:", error);
          state.navigationRecommendations = [];
        }
      }

      async function initializeNavigation() {
        try {
          const catalog = await api<NavigationCatalog>("/navigation/catalog");
          if (!catalog.assessments.length) throw new Error("The assessment catalog is empty.");
          state.navigationCatalog = catalog;
          await loadRecommendations();
          navError.hidden = true;
          renderNavigation();
        } catch (error) {
          state.navigationCatalog = null;
          navError.textContent = `Guided navigation is unavailable. The classic picker remains ready. ${readableError(error)}`;
          navError.hidden = false;
          classicPicker.open = true;
        }
      }

      function renderNavigation() {
        const catalog = state.navigationCatalog;
        if (!catalog) return;
        const selection = state.navigationSelection;

        const inProgress = state.attempt?.status === "inProgress";
        const compactBar = document.querySelector<HTMLElement>("#nav-compact-active-session");
        const classicPicker = document.querySelector<HTMLElement>("#classic-picker");
        const navStages = document.querySelector<HTMLElement>("#nav-stages");

        if (inProgress) {
          if (navStages) navStages.hidden = true;
          if (classicPicker) classicPicker.hidden = true;
          navActions.hidden = true;
          navBreadcrumb.hidden = true;

          if (compactBar) {
            compactBar.hidden = false;
            compactBar.innerHTML = `
              <div class="compact-bar">
                <span class="compact-bar-item">${escapeHtml(catalog.subjects.find(s => s.id === selection.subjectId)?.title ?? "")}</span>
                <span class="compact-bar-sep">›</span>
                <span class="compact-bar-item">${escapeHtml(catalog.areas.find(a => a.id === selection.areaId)?.title ?? "")}</span>
                <span class="compact-bar-sep">›</span>
                <span class="compact-bar-item">${escapeHtml(catalog.topics.find(t => t.id === selection.topicId)?.title ?? "")}</span>
                <span class="compact-bar-sep">›</span>
                <span class="compact-bar-item"><strong>${escapeHtml(state.assessment?.title ?? "")}</strong> (${escapeHtml(state.attempt?.mode ?? "")})</span>
                <button type="button" class="compact-bar-change secondary-action" id="btn-change-assessment">Change Assessment</button>
              </div>
            `;
            const changeBtn = compactBar.querySelector("#btn-change-assessment");
            if (changeBtn) {
              changeBtn.addEventListener("click", () => {
                if (confirm("Are you sure? Your current progress will be paused and saved, but you will leave this assessment.")) {
                  state.attempt = null;
                  state.assessment = null;
                  state.latestResults = null;
                  renderApp();
                }
              });
            }
          }
          return;
        } else {
          if (navStages) navStages.hidden = false;
          if (classicPicker) classicPicker.hidden = false;
          if (compactBar) compactBar.hidden = true;
          const stageSubject = document.querySelector<HTMLElement>("#nav-stage-subject");
          if (stageSubject) stageSubject.hidden = false;
        }


        const recommendations = state.navigationRecommendations ?? [];
        const topicRecommendations = new Map(recommendations.map(r => [r.topicId, r]));

        const subjects = catalog.subjects
          .map((subject) => ({
            subject,
            count: catalog.assessments.filter((assessment) => assessment.subjectId === subject.id).length
          }))
          .filter((entry) => entry.count > 0);

        renderNavigationTiles("nav-subject-tiles", subjects.map(({ subject, count }) => ({
          id: subject.id,
          label: subject.title,
          description: subject.description,
          count,
          selected: selection.subjectId === subject.id,
          disabled: false
        })), (id) => selectNavigationStage("subject", id));

        const subjectAssessments = catalog.assessments.filter((assessment) => assessment.subjectId === selection.subjectId);
        const areas = catalog.areas
          .filter((area) => area.subjectIds.includes(selection.subjectId))
          .map((area) => ({
            area,
            count: subjectAssessments.filter((assessment) => assessment.areaIds.includes(area.id)).length
          }))
          .filter((entry) => entry.count > 0);
        renderNavigationTiles("nav-area-tiles", areas.map(({ area, count }) => {
          const areaRecs = recommendations.filter(r => r.areaIds.includes(area.id) && r.state === "review");
          const reviewCount = areaRecs.length;
          const badgeHtml = reviewCount > 0 ? `<span class="quiet-badge" style="font-size: 0.85em; opacity: 0.8; margin-left: 6px;">${reviewCount} topics need review</span>` : "";
          return {
            id: area.id,
            label: area.title,
            description: area.description,
            count,
            selected: selection.areaId === area.id,
            disabled: false,
            badgeHtml: badgeHtml
          };
        }), (id) => selectNavigationStage("area", id));

        const areaAssessments = subjectAssessments.filter((assessment) => assessment.areaIds.includes(selection.areaId));
        const availableTopicIds = new Set(areaAssessments.flatMap((assessment) => assessment.topicIds));
        const topics = catalog.topics
          .filter((topic) => topic.subjectId === selection.subjectId && availableTopicIds.has(topic.id))
          .map((topic) => ({
            topic,
            count: areaAssessments.filter((assessment) => assessment.topicIds.includes(topic.id)).length
          }));
        renderNavigationTiles("nav-topic-tiles", topics.map(({ topic, count }) => {
          const rec = topicRecommendations.get(topic.id);
          let badgeHtml = "";
          if (rec) {
            if (rec.state === "review") badgeHtml = `<span class="badge review" style="background: #ffd600; color: #000;">Review</span>`;
            else if (rec.state === "evaluate") badgeHtml = `<span class="badge evaluate" style="background: #00c853; color: #fff;">Ready to Evaluate</span>`;
            else if (rec.provisionalMastery) badgeHtml = `<span class="badge provisional" style="background: #e0e0e0; color: #000;">Provisional</span>`;
          }
          return {
            id: topic.id,
            label: topic.title,
            description: topic.description,
            count,
            selected: selection.topicId === topic.id,
            disabled: false,
            badgeHtml: badgeHtml
          };
        }), (id) => selectNavigationStage("topic", id));

        const activeTopicRec = topicRecommendations.get(selection.topicId);
        const topicAssessments = areaAssessments.filter((assessment) => assessment.topicIds.includes(selection.topicId));
        renderNavigationTiles("nav-goal-tiles", catalog.goals.map((goal) => {
          const count = topicAssessments.filter((assessment) => assessment.learningGoal === goal.id).length;
          const isSuggested = activeTopicRec?.recommendedLearningGoal === goal.id;
          return {
            id: goal.id,
            label: goal.label,
            count,
            selected: selection.goalId === goal.id,
            disabled: count === 0,
            suggested: isSuggested
          };
        }), (id) => selectNavigationStage("goal", id));

        const goal = catalog.goals.find((candidate) => candidate.id === selection.goalId);
        const goalAssessments = topicAssessments.filter((assessment) => assessment.learningGoal === selection.goalId);
        const activities = (goal?.activityTypes ?? []).map((activityType) => ({
          id: activityType,
          label: activityTypeLabel(activityType),
          count: goalAssessments.filter((assessment) => assessment.activityType === activityType).length
        })).filter((activity) => activity.count > 0);
        renderNavigationTiles("nav-activity-tiles", activities.map((activity) => {
          const isSuggested = selection.goalId === activeTopicRec?.recommendedLearningGoal && 
                              activeTopicRec?.recommendedActivityTypes.includes(activity.id);
          return {
            ...activity,
            selected: selection.activityType === activity.id,
            disabled: false,
            suggested: isSuggested
          };
        }), (id) => selectNavigationStage("activity", id));

        const matchingAssessments = goalAssessments.filter((assessment) =>
          assessment.activityType === selection.activityType);
        const assessmentList = document.querySelector<HTMLDivElement>("#nav-assessment-list")!;
        assessmentList.innerHTML = matchingAssessments.map((assessment) => {
          const isSuggested = activeTopicRec?.suggestedAssessmentIds.includes(assessment.id);
          return `
          <button
            type="button"
            class="nav-assessment-item ${selection.assessmentId === assessment.id ? "selected" : ""}"
            data-navigation-assessment="${escapeHtml(assessment.id)}"
            role="option"
            aria-selected="${selection.assessmentId === assessment.id}"
          >
            <span class="nav-assessment-name">
              ${escapeHtml(assessment.title)}
              ${isSuggested ? `<span class="badge suggested" style="background: #2196f3; color: #fff; margin-left: 6px; padding: 2px 6px; border-radius: 4px; font-size: 0.8em;">Suggested</span>` : ""}
            </span>
            <span class="nav-assessment-meta">${escapeHtml(assessmentTypeLabel(assessment.assessmentType))} · ${escapeHtml(assessmentCountLabel(assessment))} items</span>
          </button>
        `}).join("");
        assessmentList.querySelectorAll<HTMLButtonElement>("[data-navigation-assessment]").forEach((button) => {
          button.addEventListener("click", () => selectNavigationStage("assessment", button.dataset.navigationAssessment ?? ""));
        });

        setNavigationStageVisible("area", Boolean(selection.subjectId));
        setNavigationStageVisible("topic", Boolean(selection.areaId));
        setNavigationStageVisible("goal", Boolean(selection.topicId));
        setNavigationStageVisible("activity", Boolean(selection.goalId));
        setNavigationStageVisible("assessments", Boolean(selection.activityType));
        navActions.hidden = !selection.assessmentId;
        renderNavigationBreadcrumb();
      }

      function renderNavigationTiles(
        containerId: string,
        items: Array<{
          id: string;
          label: string;
          description?: string | null;
          count?: number;
          selected?: boolean;
          disabled?: boolean;
          suggested?: boolean;
          badgeHtml?: string;
        }>,
        onSelect: (id: string) => void
      ) {
        const container = document.querySelector<HTMLDivElement>(`#${containerId}`)!;
        container.innerHTML = items.map((item) => `
          <button
            type="button"
            class="nav-tile ${item.selected ? "selected" : ""}"
            data-navigation-id="${escapeHtml(item.id)}"
            title="${escapeHtml(item.description ?? item.label)}"
            role="option"
            aria-selected="${item.selected ?? false}"
            ${item.disabled ? "disabled" : ""}
          >
            ${item.suggested ? `<div class="nav-tile-suggestion" style="background: #2196f3; color: #fff; font-size: 0.7em; padding: 2px 4px; border-radius: 3px; position: absolute; top: -8px; right: -8px;">Suggested</div>` : ""}
            <span class="nav-tile-label">${escapeHtml(item.label)} ${item.badgeHtml ?? ""}</span>
            <span class="nav-tile-count">${item.count} available</span>
          </button>
        `).join("");
        container.querySelectorAll<HTMLButtonElement>("[data-navigation-id]").forEach((button) => {
          button.addEventListener("click", () => onSelect(button.dataset.navigationId ?? ""));
        });
      }

      function selectNavigationStage(
        stage: "subject" | "area" | "topic" | "goal" | "activity" | "assessment",
        id: string
      ) {
        const selection = state.navigationSelection;
        if (stage === "subject") Object.assign(selection, { subjectId: id, areaId: "", topicId: "", goalId: "", activityType: "", assessmentId: "" });
        if (stage === "area") Object.assign(selection, { areaId: id, topicId: "", goalId: "", activityType: "", assessmentId: "" });
        if (stage === "topic") Object.assign(selection, { topicId: id, goalId: "", activityType: "", assessmentId: "" });
        if (stage === "goal") Object.assign(selection, { goalId: id, activityType: "", assessmentId: "" });
        if (stage === "activity") Object.assign(selection, { activityType: id, assessmentId: "" });
        if (stage === "assessment") selection.assessmentId = id;
        renderNavigation();
      }

      function renderNavigationBreadcrumb() {
        const catalog = state.navigationCatalog;
        if (!catalog) return;
        const selection = state.navigationSelection;

        const inProgress = state.attempt?.status === "inProgress";
        const compactBar = document.querySelector<HTMLElement>("#nav-compact-active-session");
        const classicPicker = document.querySelector<HTMLElement>("#classic-picker");
        const navStages = document.querySelector<HTMLElement>("#nav-stages");

        if (inProgress) {
          if (navStages) navStages.hidden = true;
          if (classicPicker) classicPicker.hidden = true;
          navActions.hidden = true;
          navBreadcrumb.hidden = true;

          if (compactBar) {
            compactBar.hidden = false;
            compactBar.innerHTML = `
              <div class="compact-bar">
                <span class="compact-bar-item">${escapeHtml(catalog.subjects.find(s => s.id === selection.subjectId)?.title ?? "")}</span>
                <span class="compact-bar-sep">›</span>
                <span class="compact-bar-item">${escapeHtml(catalog.areas.find(a => a.id === selection.areaId)?.title ?? "")}</span>
                <span class="compact-bar-sep">›</span>
                <span class="compact-bar-item">${escapeHtml(catalog.topics.find(t => t.id === selection.topicId)?.title ?? "")}</span>
                <span class="compact-bar-sep">›</span>
                <span class="compact-bar-item"><strong>${escapeHtml(state.assessment?.title ?? "")}</strong> (${escapeHtml(state.attempt?.mode ?? "")})</span>
                <button type="button" class="compact-bar-change secondary-action" id="btn-change-assessment">Change Assessment</button>
              </div>
            `;
            const changeBtn = compactBar.querySelector("#btn-change-assessment");
            if (changeBtn) {
              changeBtn.addEventListener("click", () => {
                if (confirm("Are you sure? Your current progress will be paused and saved, but you will leave this assessment.")) {
                  state.attempt = null;
                  state.assessment = null;
                  state.latestResults = null;
                  renderApp();
                }
              });
            }
          }
          return;
        } else {
          if (navStages) navStages.hidden = false;
          if (classicPicker) classicPicker.hidden = false;
          if (compactBar) compactBar.hidden = true;
          const stageSubject = document.querySelector<HTMLElement>("#nav-stage-subject");
          if (stageSubject) stageSubject.hidden = false;
        }


        const parts = [
          { stage: "subject", id: selection.subjectId, label: catalog.subjects.find((item) => item.id === selection.subjectId)?.title },
          { stage: "area", id: selection.areaId, label: catalog.areas.find((item) => item.id === selection.areaId)?.title },
          { stage: "topic", id: selection.topicId, label: catalog.topics.find((item) => item.id === selection.topicId)?.title },
          { stage: "goal", id: selection.goalId, label: catalog.goals.find((item) => item.id === selection.goalId)?.label },
          { stage: "activity", id: selection.activityType, label: activityTypeLabel(selection.activityType) }
        ].filter((part) => part.id && part.label);
        navBreadcrumb.hidden = parts.length === 0;
        navBreadcrumb.innerHTML = parts.map((part, index) => `
          <span class="nav-breadcrumb-item">
            ${index > 0 ? `<span class="nav-breadcrumb-sep">›</span>` : ""}
            <button type="button" data-navigation-back="${part.stage}">${escapeHtml(part.label ?? "")}</button>
          </span>
        `).join("");
        navBreadcrumb.querySelectorAll<HTMLButtonElement>("[data-navigation-back]").forEach((button) => {
          button.addEventListener("click", () => resetNavigationAfter(button.dataset.navigationBack ?? "subject"));
        });
      }

      function resetNavigationAfter(stage: string) {
        const selection = state.navigationSelection;
        if (stage === "subject") Object.assign(selection, { areaId: "", topicId: "", goalId: "", activityType: "", assessmentId: "" });
        if (stage === "area") Object.assign(selection, { topicId: "", goalId: "", activityType: "", assessmentId: "" });
        if (stage === "topic") Object.assign(selection, { goalId: "", activityType: "", assessmentId: "" });
        if (stage === "goal") Object.assign(selection, { activityType: "", assessmentId: "" });
        if (stage === "activity") selection.assessmentId = "";
        renderNavigation();
      }

      function setNavigationStageVisible(stage: string, visible: boolean) {
        const element = document.querySelector<HTMLElement>(`#nav-stage-${stage}`);
        if (element) element.hidden = !visible;
      }

      function activityTypeLabel(activityType: string) {
        return {
          conceptLesson: "Concept Lesson",
          guidedWorkedExample: "Guided Worked Example",
          interactiveExploration: "Interactive Exploration",
          recognitionDrill: "Recognition Drill",
          clozeDrill: "Cloze Drill",
          mixedRecallSet: "Mixed Recall Set",
          focusedPractice: "Focused Practice",
          mixedPractice: "Mixed Practice",
          guidedProject: "Guided Project",
          codingApplication: "Coding Application",
          circuitApplication: "Circuit Application",
          masteryCheck: "Mastery Check",
          formalTest: "Formal Test",
          selfReview: "Self Review"
        }[activityType] ?? activityType;
      }

      async function startAttempt() {
        const assessmentId = assessmentSelect.value;
        if (!assessmentId) return;

        const startButton = document.querySelector<HTMLButtonElement>("#start-attempt")!;
        const mode = document.querySelector<HTMLInputElement>("input[name='mode']:checked")!.value as AssessmentMode;
        await startSelectedAssessment(assessmentId, mode, startButton);
      }

      async function startNavigationAttempt() {
        const assessmentId = state.navigationSelection.assessmentId;
        if (!assessmentId) return;
        const startButton = document.querySelector<HTMLButtonElement>("#nav-start-attempt")!;
        const mode = document.querySelector<HTMLInputElement>("input[name='nav-mode']:checked")!.value as AssessmentMode;
        await startSelectedAssessment(assessmentId, mode, startButton);
      }

      async function startSelectedAssessment(
        assessmentId: string,
        mode: AssessmentMode,
        startButton: HTMLButtonElement
      ) {
        if (state.attempt?.status === "inProgress") {
          if (!confirm("Starting this assessment will permanently delete your current unsaved attempt. Continue?")) return;
          try {
            setBusy(startButton, "Deleting");
            await api(`/attempts/${encodeURIComponent(state.attempt.id)}`, { method: "DELETE" });
          } catch (e) {
            console.error(e);
            alert("Failed to delete the previous attempt.");
            clearBusy(startButton, "Start Selected");
            return;
          }
        }
        
        setBusy(startButton, "Loading");
        try {
          state.assessment = await api<Assessment>(`/assessments/${encodeURIComponent(assessmentId)}`);
          state.attempt = await api<Attempt>("/attempts", {
            method: "POST",
            body: JSON.stringify({ assessmentId, mode })
          });
          state.currentIndex = 0;
          state.latestResults = null;
          state.guidedProjectSession = null;
          state.guidedProjectActiveFile = "";
          updateActiveAttemptChip();
          updateModeControlLock();
          await renderCurrentQuestion();
          if (typeof loadRecommendations === "function") {
            await loadRecommendations();
          }
        } finally {
          clearBusy(startButton, "Start Selected");
        }
      }

      async function submitCurrentAnswer() {
        if (!state.attempt || !state.assessment) return;
        const question = getCurrentQuestion();
        const payload = readAnswer(question);
        const submitButton = document.querySelector<HTMLButtonElement>("#submit-answer");

        if (submitButton) setBusy(submitButton, "Saving");

        try {
          state.attempt = await api<Attempt>(`/attempts/${state.attempt.id}/answers`, {
            method: "POST",
            body: JSON.stringify(payload)
          });

          state.latestResults = await api<AttemptResults>(`/attempts/${state.attempt.id}/results`);
          if (state.latestResults.assessmentType === "workedExample") {
            state.currentIndex = firstUnansweredIndex(state.latestResults, state.attempt);
          }

          if (state.attempt.status === "completed") {
            updateActiveAttemptChip("Complete");
            updateModeControlLock();
            await renderResults(false);
            await loadGrades();
            return;
          }

          await renderCurrentQuestion();
        } finally {
          if (submitButton) clearBusy(submitButton, "Submit Answer");
        }
      }

      async function markFreeResponseSelfCheck(questionId: string, isCorrect: boolean) {
        if (!state.attempt || !state.latestResults) return;
        const result = state.latestResults.questions.find((candidate) => candidate.questionId === questionId)
          ?? state.latestResults.learningSections
            .map((section) => section.check)
            .find((candidate) => candidate?.questionId === questionId);
        if (!result?.submittedAnswer?.freeResponseText) return;

        state.attempt = await api<Attempt>(`/attempts/${state.attempt.id}/answers`, {
          method: "POST",
          body: JSON.stringify({
            questionId,
            choiceIds: [],
            freeResponseText: result.submittedAnswer.freeResponseText,
            selfCheckCorrect: isCorrect
          })
        });
        state.latestResults = await api<AttemptResults>(`/attempts/${state.attempt.id}/results`);
        if (state.latestResults.assessmentType === "workedExample") {
          state.currentIndex = firstUnansweredIndex(state.latestResults, state.attempt);
        }

        if (state.latestResults.status === "completed") {
          await renderResults(isAttemptCommitted(state.attempt.id));
        } else {
          await renderCurrentQuestion();
        }

        await loadGrades();
      }

      async function resumeAttemptSession(attemptId: string) {
        const session = await api<AttemptSessionResponse>(`/attempts/${encodeURIComponent(attemptId)}/resume`, {
          method: "POST"
        });
        await loadSession(session, true);
      }

      async function reviewAttemptSession(attemptId: string) {
        const session = await api<AttemptSessionResponse>(`/attempts/${encodeURIComponent(attemptId)}/session`);
        await loadSession(session, false);
      }

      async function loadSession(session: AttemptSessionResponse, preferFirstUnanswered: boolean) {
        state.assessment = session.assessment;
        state.attempt = session.attempt;
        state.latestResults = session.results;
        state.guidedProjectSession = null;
        state.guidedProjectActiveFile = "";
        state.currentIndex = preferFirstUnanswered ? firstUnansweredIndex(session.results, session.attempt) : 0;
        updateActiveAttemptChip(statusLabel(session.attempt.status));
        syncModeControlToAttempt();
        updateModeControlLock();
        activateTab("load");

        if (session.attempt.status === "completed") {
          await renderResults(isAttemptCommitted(session.attempt.id));
          return;
        }

        await renderCurrentQuestion();
      }

      async function refreshCurrentAssessment() {
        if (!state.assessment || !state.attempt || !IS_DEV) return;

        const refreshButton = document.querySelector<HTMLButtonElement>("[data-refresh-current-assessment]");
        const currentQuestionId = state.attempt.questionOrder[state.currentIndex] ?? "";
        if (refreshButton) setBusy(refreshButton, "Refreshing");

        try {
          const refreshedAssessment = await api<Assessment>(`/assessments/${encodeURIComponent(state.assessment.id)}`);
          state.assessment = refreshedAssessment;

          if (state.attempt.status !== "inProgress") {
            state.latestResults = await api<AttemptResults>(`/attempts/${state.attempt.id}/results`);
            await renderResults(isAttemptCommitted(state.attempt.id));
            return;
          }

          const refreshedQuestionIds = getAssessmentQuestionIds(refreshedAssessment);
          if (refreshedQuestionIds.length > 0 && !refreshedQuestionIds.includes(currentQuestionId)) {
            const fallbackIndex = state.attempt.questionOrder.findIndex((questionId) => refreshedQuestionIds.includes(questionId));
            state.currentIndex = Math.max(0, fallbackIndex);
          }

          await renderCurrentQuestion();
        } finally {
          if (refreshButton) clearBusy(refreshButton, "Refresh Assessment");
        }
      }

      async function pauseAttempt() {
        if (!state.attempt) return;
        await flushLearningSectionState();
        if (state.assessment?.assessmentType === "guidedProject") {
          await saveGuidedProjectFiles();
        }
        const response = await api<{ attempt: Attempt; results: AttemptResults }>(`/attempts/${state.attempt.id}/pause`, {
          method: "POST"
        });
        state.attempt = response.attempt;
        state.latestResults = response.results;
        updateActiveAttemptChip("Paused");
        updateModeControlLock();
        attemptContent.innerHTML = `
          <div class="empty-state">
            Progress saved. This attempt is paused and can be continued from Attempt Sessions.
          </div>
        `;
        await loadGrades();
      }

      async function abandonAttempt() {
        if (!state.attempt) return;
        if (!confirm("Quit this assessment early? This attempt and all unsaved progress will be permanently deleted.")) return;

        await api(`/attempts/${state.attempt.id}`, { method: "DELETE" });
        
        state.attempt = null;
        state.assessment = null;
        state.latestResults = null;
        state.guidedProjectSession = null;
        currentCodeEditor?.destroy();
        currentCodeEditor = null;
        currentCircuitCanvas?.destroy();
        currentCircuitCanvas = null;

        updateActiveAttemptChip();
        updateModeControlLock();
        attemptContent.innerHTML = `<div class="empty-state">Attempt deleted.</div>`;
        
        await loadGrades();
        if (typeof loadRecommendations === "function") {
           await loadRecommendations();
        }
      }

      async function deleteAttempt(attemptId: string) {
        if (!confirm("Delete this attempt and any linked grade entry? This cannot be undone.")) return;
        await api(`/attempts/${encodeURIComponent(attemptId)}`, { method: "DELETE" });
        if (state.attempt?.id === attemptId) {
          state.attempt = null;
          state.assessment = null;
          state.latestResults = null;
          updateActiveAttemptChip();
          updateModeControlLock();
          attemptContent.innerHTML = `<div class="empty-state">Attempt deleted.</div>`;
        }
        await loadGrades();
      }

      async function deleteGrade(attemptId: string) {
        if (!confirm("Delete this grade entry and its linked attempt? This cannot be undone.")) return;
        await api(`/grades/${encodeURIComponent(attemptId)}`, { method: "DELETE" });
        if (state.attempt?.id === attemptId) {
          state.attempt = null;
          state.assessment = null;
          state.latestResults = null;
          updateActiveAttemptChip();
          updateModeControlLock();
          attemptContent.innerHTML = `<div class="empty-state">Grade and linked attempt deleted.</div>`;
        }
        await loadGrades();
      }

      async function completeAttempt() {
        if (!state.attempt) return;
        if (state.assessment?.assessmentType === "guidedProject") {
          await completeGuidedProject();
          return;
        }
        const completeButton = document.querySelector<HTMLButtonElement>("#complete-attempt");

        if (completeButton) setBusy(completeButton, "Completing");

        try {
          const response = await api<{ results: AttemptResults; committedGrade: unknown | null }>(`/attempts/${state.attempt.id}/complete`, {
            method: "POST"
          });
          state.latestResults = response.results;
          updateActiveAttemptChip("Complete");
          updateModeControlLock();
          await renderResults(response.committedGrade !== null);
          await loadGrades();
        } finally {
          if (completeButton) clearBusy(completeButton, "Complete");
        }
      }

      async function commitGrade() {
        if (!state.attempt || state.latestResults?.assessmentType === "workedExample" || state.latestResults?.assessmentType === "guidedProject" || state.latestResults?.assessmentType === "recallDrill") return;
        await api("/grades/commit", {
          method: "POST",
          body: JSON.stringify({ attemptId: state.attempt.id })
        });
        await loadGrades();
        if (state.latestResults) await renderResults(true);
      }

      async function saveSettings(event: Event) {
        event.preventDefault();
        const form = new FormData(settingsForm);
        const settings: AppSettings = {
          schemaVersion: state.settings?.schemaVersion ?? 1,
          defaultMode: String(form.get("defaultMode")) as AssessmentMode,
          defaultQuestionOrder: String(form.get("defaultQuestionOrder")) as "randomized" | "static",
          defaultQuizLength: Number(form.get("defaultQuizLength")),
          defaultTestLength: Number(form.get("defaultTestLength")),
          questionTimerSeconds: nullableNumber(form.get("questionTimerSeconds")),
          assessmentTimerSeconds: nullableNumber(form.get("assessmentTimerSeconds")),
          commitScoredAttemptsAutomatically: form.get("commitScoredAttemptsAutomatically") === "on",
          codeRunnerBaseUrl: String(form.get("codeRunnerBaseUrl") ?? "http://localhost:2000/api/v2").trim(),
          codeRunnerCompileTimeoutMs: Number(form.get("codeRunnerCompileTimeoutMs") ?? 10000),
          codeRunnerRunTimeoutMs: Number(form.get("codeRunnerRunTimeoutMs") ?? 3000)
        };

        state.settings = await api<AppSettings>("/settings", {
          method: "PUT",
          body: JSON.stringify(settings)
        });
        settingsStatus.textContent = "Settings saved.";
      }

      async function loadGrades() {
        const [summary, analytics] = await Promise.all([
          api<{ entryCount: number; averagePercentScore: number | null; entries: GradeLogEntry[] }>("/grades/summary"),
          api<GradeAnalyticsSummary>("/analytics/grades")
        ]);
        state.analytics = analytics;
        state.committedAttemptIds = new Set(summary.entries.map((entry) => entry.attemptId));
        const currentAttemptIds = new Set(analytics.attempts.map((attempt) => attempt.attemptId));
        state.selectedAttemptIds.forEach((attemptId) => {
          if (!currentAttemptIds.has(attemptId)) state.selectedAttemptIds.delete(attemptId);
        });

        gradeSummary.innerHTML = renderAnalyticsDashboard(analytics, summary.entries);
        renderAttemptHistory();
        setupGradeLogInteractions();
      }

      function renderAnalyticsDashboard(analytics: GradeAnalyticsSummary, entries: GradeLogEntry[]) {
        const weakestCategory = analytics.weakestCategory ? `${analytics.weakestCategory.title} (${analytics.weakestCategory.averagePercent}%)` : "Not enough data";
        const weakestArea = analytics.weakestArea ? `${analytics.weakestArea.title} (${analytics.weakestArea.averagePercent}%)` : "Not enough data";
        const weakestQuestionType = analytics.weakestQuestionType ? `${questionTypeLabel(analytics.weakestQuestionType.questionType)} (${analytics.weakestQuestionType.correctPercent}%)` : "Not enough data";

        return `
          <section class="analytics-dashboard">
            <div class="metric-row analytics-metrics">
              <div><span>${analytics.committedEntryCount}</span><small>Committed scores</small></div>
              <div><span>${analytics.overallCommittedAverage ?? 0}%</span><small>Overall average</small></div>
              <div><span>${analytics.attempts.length}</span><small>Attempt sessions</small></div>
              <div><span>${analytics.weakAreas.length}</span><small>Focus signals</small></div>
            </div>
            <div class="analytics-focus-grid">
              <article><small>Weakest category</small><strong>${escapeHtml(weakestCategory)}</strong></article>
              <article><small>Weakest area</small><strong>${escapeHtml(weakestArea)}</strong></article>
              <article><small>Weakest question type</small><strong>${escapeHtml(weakestQuestionType)}</strong></article>
            </div>
            ${analytics.weakAreas.length > 0 ? `
              <div class="focus-callout">
                ${analytics.weakAreas.map((weak) => `<p>${escapeHtml(weak.message)}</p>`).join("")}
              </div>
            ` : `<div class="empty-state">Commit a few completed attempts to start surfacing weak topics.</div>`}
            <div class="analytics-table-grid">
              ${renderCategoryAnalyticsTable(analytics.categories)}
              ${renderAreaAnalyticsTable(analytics.areas)}
              ${renderQuestionTypeAnalyticsTable(analytics.questionTypes)}
            </div>
            <div class="analytics-table-grid recall-analytics-grid">
              ${renderRecallRatingAnalyticsTable(analytics.recallRatings)}
              ${renderRecallTagAnalyticsTable(analytics.recallTags)}
              ${renderRecallGroupAnalyticsTable("Recall Categories", analytics.recallCategories)}
            </div>
            ${renderCommittedEntries(entries)}
          </section>
        `;
      }

      function renderCommittedEntries(entries: GradeLogEntry[]) {
        if (entries.length === 0) {
          return `<section class="analytics-section"><h3>Committed Scores</h3><div class="empty-state">No committed scores yet.</div></section>`;
        }

        return `
          <section class="analytics-section">
            <h3>Committed Scores</h3>
            <table>
              <thead><tr><th>Assessment</th><th>Mode</th><th>Score</th><th>Committed</th><th>Actions</th></tr></thead>
              <tbody>
                ${entries.map((entry) => `
                  <tr>
                    <td>${escapeHtml(entry.assessmentTitle)}</td>
                    <td>${escapeHtml(modeLabel(entry.mode))}</td>
                    <td>${entry.correctCount}/${entry.totalQuestions} (${entry.percentScore}%)</td>
                    <td>${new Date(entry.committedAt).toLocaleString()}</td>
                    <td><button type="button" class="danger-light" data-delete-grade="${escapeHtml(entry.attemptId)}">Delete Grade</button></td>
                  </tr>
                `).join("")}
              </tbody>
            </table>
          </section>
        `;
      }

      function renderCategoryAnalyticsTable(categories: CategoryGradeAnalytics[]) {
        return renderMiniAnalyticsTable(
          "Category Averages",
          ["Category", "Attempts", "Average", "Last"],
          categories.map((category) => [
            category.categoryTitle,
            String(category.attemptCount),
            `${category.averagePercent}%`,
            category.lastPercent === null ? "-" : `${category.lastPercent}%`
          ]),
          "No category grade data yet.");
      }

      function renderAreaAnalyticsTable(areas: AreaGradeAnalytics[]) {
        return renderMiniAnalyticsTable(
          "Area Averages",
          ["Area", "Attempts", "Average", "Weakest subtopic"],
          areas.map((area) => [
            area.areaTitle,
            String(area.attemptCount),
            `${area.averagePercent}%`,
            area.weakestSubcategoryTitle ?? "-"
          ]),
          "No area mappings have committed scores yet.");
      }

      function renderQuestionTypeAnalyticsTable(questionTypes: QuestionTypePerformance[]) {
        return renderMiniAnalyticsTable(
          "Question Types",
          ["Type", "Answered", "Correct", "Needs review"],
          questionTypes.map((type) => [
            questionTypeLabel(type.questionType),
            String(type.answeredCount),
            `${type.correctPercent}%`,
            String(type.needsReviewCount)
          ]),
          "No completed question results yet.");
      }

      function renderRecallRatingAnalyticsTable(rows: RecallRatingAnalytics[]) {
        return renderMiniAnalyticsTable(
          "Recall Ratings",
          ["Rating", "Count"],
          rows.map((row) => [recallRatingLabel(row.rating), String(row.count)]),
          "Complete recall drills to see rating counts.");
      }

      function renderRecallTagAnalyticsTable(rows: RecallTagAnalytics[]) {
        return renderMiniAnalyticsTable(
          "Weak Recall Tags",
          ["Tag", "Avg", "Weak"],
          rows.slice(0, 8).map((row) => [row.tag, String(row.averageRating), String(row.weakCount)]),
          "Weak tags appear after recall items are rated.");
      }

      function renderRecallGroupAnalyticsTable(title: string, rows: RecallGroupAnalytics[]) {
        return renderMiniAnalyticsTable(
          title,
          ["Group", "Avg", "Weak"],
          rows.slice(0, 8).map((row) => [row.title, String(row.averageRating), String(row.weakCount)]),
          "No recall drill groups yet.");
      }

      function renderMiniAnalyticsTable(title: string, headers: string[], rows: string[][], emptyText: string) {
        return `
          <section class="analytics-card">
            <h3>${escapeHtml(title)}</h3>
            ${rows.length === 0 ? `<div class="empty-state compact">${escapeHtml(emptyText)}</div>` : `
              <table class="compact-table">
                <thead><tr>${headers.map((header) => `<th>${escapeHtml(header)}</th>`).join("")}</tr></thead>
                <tbody>
                  ${rows.map((row) => `<tr>${row.map((cell) => `<td>${escapeHtml(cell)}</td>`).join("")}</tr>`).join("")}
                </tbody>
              </table>
            `}
          </section>
        `;
      }

      function renderAttemptHistory() {
        const analytics = state.analytics;
        if (!analytics || analytics.attempts.length === 0) {
          attemptHistory.innerHTML = `<div class="empty-state">No attempts recorded yet.</div>`;
          return;
        }
        const rows = sortHistoryRows(filteredHistoryRows(analytics.attempts));
        const allVisibleSelected = rows.length > 0 && rows.every((row) => state.selectedAttemptIds.has(row.attemptId));

        attemptHistory.innerHTML = `
          <div class="history-toolbar">
            <details class="history-filters">
              <summary>Filters <span>${rows.length}/${analytics.attempts.length}</span></summary>
              <div class="history-filter-grid">
                ${renderHistorySelect("status", "Status", [["", "Any"], ["inProgress", "In progress"], ["paused", "Paused"], ["completed", "Complete"]])}
                ${renderHistorySelect("mode", "Mode", [["", "Any"], ["practice", "Practice"], ["scored", "Scored"]])}
                ${renderHistorySelect("assessmentType", "Type", [["", "Any"], ["quiz", "Quiz"], ["test", "Test"], ["workedExample", "Worked Example"], ["guidedProject", "Guided Project"], ["recallDrill", "Recall Drill"]])}
                ${renderHistorySelect("categoryId", "Category", [["", "Any"], ...uniqueOptions(analytics.attempts.map((row) => [row.categoryId, row.categoryTitle]))])}
                ${renderHistorySelect("areaId", "Area", [["", "Any"], ...uniqueOptions(analytics.attempts.flatMap((row) => row.areaIds.map((areaId, index) => [areaId, row.areaTitles[index] ?? areaId])))])}
                ${renderHistorySelect("questionType", "Question Type", [["", "Any"], ...uniqueOptions(analytics.attempts.flatMap((row) => row.questionTypes.map((type) => [type, questionTypeLabel(type)] as [string, string])))])}
                ${renderHistorySelect("committed", "Committed", [["", "Any"], ["yes", "Committed"], ["no", "Uncommitted"]])}
                ${renderHistorySelect("score", "Score", [["", "Any"], ["lt70", "Below 70%"], ["70to89", "70-89%"], ["gte90", "90%+"]])}
              </div>
            </details>
            <button type="button" class="danger-light" id="bulk-delete-attempts" ${state.selectedAttemptIds.size === 0 ? "disabled" : ""}>Delete Selected (${state.selectedAttemptIds.size})</button>
          </div>
          ${rows.length === 0 ? `<div class="empty-state">No attempts match the current filters.</div>` : `
            <table class="history-table">
              <thead>
                <tr>
                  <th><input type="checkbox" data-select-all-attempts ${allVisibleSelected ? "checked" : ""} aria-label="Select all visible attempts" /></th>
                  ${renderSortableHeader("assessmentTitle", "Assessment")}
                  ${renderSortableHeader("categoryTitle", "Category")}
                  ${renderSortableHeader("mode", "Mode")}
                  ${renderSortableHeader("status", "Status")}
                  ${renderSortableHeader("percentScore", "Score")}
                  ${renderSortableHeader("lastActivityAt", "Last activity")}
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                ${rows.map((attempt) => `
                  <tr>
                    <td><input type="checkbox" data-select-attempt="${escapeHtml(attempt.attemptId)}" ${state.selectedAttemptIds.has(attempt.attemptId) ? "checked" : ""} aria-label="Select ${escapeHtml(attempt.assessmentTitle)}" /></td>
                    <td>
                      <strong>${escapeHtml(attempt.assessmentTitle)}</strong>
                      <small>${escapeHtml(assessmentTypeLabel(attempt.assessmentType))}${attempt.isCommitted ? " · committed" : ""}</small>
                    </td>
                    <td>
                      ${escapeHtml(attempt.categoryTitle)}
                      ${attempt.areaTitles.length > 0 ? `<small>${attempt.areaTitles.map(escapeHtml).join(", ")}</small>` : ""}
                    </td>
                    <td>${escapeHtml(modeLabel(attempt.mode))}</td>
                    <td>${escapeHtml(statusLabel(attempt.status))}</td>
                    <td>${attempt.assessmentType === "recallDrill" ? `${attempt.answeredCount}/${attempt.totalQuestions} rated` : `${attempt.correctCount}/${attempt.totalQuestions} (${attempt.percentScore}%)`}<small>${attempt.answeredCount}/${attempt.totalQuestions} answered</small></td>
                    <td>${formatDate(attempt.lastActivityAt ?? attempt.startedAt)}</td>
                    <td class="table-actions">${renderAttemptActions(attempt)}</td>
                  </tr>
                `).join("")}
              </tbody>
            </table>
          `}
        `;
      }

      function setupGradeLogInteractions() {
        gradeSummary.querySelectorAll<HTMLButtonElement>("[data-delete-grade]").forEach((button) => {
          button.addEventListener("click", () => deleteGrade(button.dataset.deleteGrade ?? ""));
        });
        attemptHistory.querySelectorAll<HTMLButtonElement>("[data-attempt-action]").forEach((button) => {
          button.addEventListener("click", () => handleAttemptAction(button.dataset.attemptAction ?? "", button.dataset.attemptId ?? ""));
        });
        attemptHistory.querySelectorAll<HTMLSelectElement>("[data-history-filter]").forEach((select) => {
          select.addEventListener("change", () => {
            const key = select.dataset.historyFilter as keyof typeof state.historyFilters;
            state.historyFilters[key] = select.value;
            state.selectedAttemptIds.clear();
            renderAttemptHistory();
            setupGradeLogInteractions();
          });
        });
        attemptHistory.querySelectorAll<HTMLButtonElement>("[data-sort-history]").forEach((button) => {
          button.addEventListener("click", () => {
            const key = button.dataset.sortHistory ?? "lastActivityAt";
            state.historySort = {
              key,
              direction: state.historySort.key === key && state.historySort.direction === "asc" ? "desc" : "asc"
            };
            renderAttemptHistory();
            setupGradeLogInteractions();
          });
        });
        attemptHistory.querySelectorAll<HTMLInputElement>("[data-select-attempt]").forEach((checkbox) => {
          checkbox.addEventListener("change", () => {
            const attemptId = checkbox.dataset.selectAttempt ?? "";
            if (checkbox.checked) {
              state.selectedAttemptIds.add(attemptId);
            } else {
              state.selectedAttemptIds.delete(attemptId);
            }
            renderAttemptHistory();
            setupGradeLogInteractions();
          });
        });
        attemptHistory.querySelector<HTMLInputElement>("[data-select-all-attempts]")?.addEventListener("change", (event) => {
          const checked = (event.target as HTMLInputElement).checked;
          const rows = state.analytics ? filteredHistoryRows(state.analytics.attempts) : [];
          rows.forEach((row) => {
            if (checked) {
              state.selectedAttemptIds.add(row.attemptId);
            } else {
              state.selectedAttemptIds.delete(row.attemptId);
            }
          });
          renderAttemptHistory();
          setupGradeLogInteractions();
        });
        attemptHistory.querySelector<HTMLButtonElement>("#bulk-delete-attempts")?.addEventListener("click", bulkDeleteSelectedAttempts);
      }

      function renderAttemptActions(attempt: AttemptResults | AttemptHistoryRow) {
        const id = escapeHtml(attempt.attemptId);
        const actions: string[] = [];

        if (attempt.status === "inProgress" || attempt.status === "paused") {
          actions.push(`<button type="button" data-attempt-action="continue" data-attempt-id="${id}">Continue</button>`);
        }

        if (attempt.status === "inProgress") {
          actions.push(`<button type="button" data-attempt-action="pause" data-attempt-id="${id}">Save and Quit</button>`);
        }

        if (attempt.status === "inProgress" || attempt.status === "paused") {
          actions.push(`<button type="button" data-attempt-action="abandon" data-attempt-id="${id}">Quit Early</button>`);
        }

        if (attempt.status === "completed") {
          actions.push(`<button type="button" data-attempt-action="review" data-attempt-id="${id}">Review</button>`);
        }

        if (attempt.status === "completed" && attempt.assessmentType !== "workedExample" && attempt.assessmentType !== "guidedProject" && attempt.assessmentType !== "recallDrill" && !attempt.hasPendingSelfChecks && !isAttemptCommitted(attempt.attemptId)) {
          actions.push(`<button type="button" data-attempt-action="commit" data-attempt-id="${id}">Commit</button>`);
        }

        actions.push(`<button type="button" data-attempt-action="delete" data-attempt-id="${id}">Delete</button>`);
        return actions.join(" ");
      }

      async function handleAttemptAction(action: string, attemptId: string) {
        if (!attemptId) return;

        if (action === "continue") {
          await resumeAttemptSession(attemptId);
        } else if (action === "review") {
          await reviewAttemptSession(attemptId);
        } else if (action === "pause") {
          const response = await api<{ attempt: Attempt; results: AttemptResults }>(`/attempts/${encodeURIComponent(attemptId)}/pause`, { method: "POST" });
          if (state.attempt?.id === attemptId) {
            state.attempt = response.attempt;
            state.latestResults = response.results;
            updateActiveAttemptChip("Paused");
          }
          await loadGrades();
        } else if (action === "abandon") {
          if (!confirm("Quit this attempt early? It will be kept for review but cannot be committed to the grade log.")) return;
          const response = await api<{ attempt: Attempt; results: AttemptResults }>(`/attempts/${encodeURIComponent(attemptId)}/abandon`, { method: "POST" });
          if (state.attempt?.id === attemptId) {
            state.attempt = response.attempt;
            state.latestResults = response.results;
            updateActiveAttemptChip("Abandoned");
          }
          await loadGrades();
        } else if (action === "commit") {
          await api("/grades/commit", {
            method: "POST",
            body: JSON.stringify({ attemptId })
          });
          await loadGrades();
        } else if (action === "delete") {
          await deleteAttempt(attemptId);
        }
      }

      function firstUnansweredIndex(results: AttemptResults, attempt: Attempt) {
        if (results.assessmentType === "conceptLesson" || results.assessmentType === "interactiveExploration") {
          const firstIncomplete = results.learningSections.find((section) => section.unlocked && !section.completed);
          const index = attempt.questionOrder.findIndex((sectionId) => sectionId === firstIncomplete?.sectionId);
          return index < 0 ? 0 : index;
        }

        const firstUnansweredQuestion = results.assessmentType === "workedExample"
          ? results.questions.find((question) => question.isCorrect !== true)
          : results.questions.find((question) => !question.submittedAnswer);
        if (!firstUnansweredQuestion) return 0;
        const index = attempt.questionOrder.findIndex((questionId) => questionId === firstUnansweredQuestion.questionId);
        return index < 0 ? 0 : index;
      }

      function answeredCount(attempt: AttemptResults) {
        return attempt.questions.filter((question) => question.submittedAnswer).length;
      }

      function statusLabel(status: AttemptStatus) {
        return {
          inProgress: "In progress",
          paused: "Paused",
          completed: "Complete"
        }[status] ?? "In progress";
      }

      function isAttemptCommitted(attemptId: string) {
        return state.committedAttemptIds.has(attemptId);
      }

      async function bulkDeleteSelectedAttempts() {
        const attemptIds = Array.from(state.selectedAttemptIds);
        if (attemptIds.length === 0) return;
        if (!confirm(`Delete ${attemptIds.length} selected attempt(s) and any linked grade entries? This cannot be undone.`)) return;

        await api("/attempts/bulk-delete", {
          method: "POST",
          body: JSON.stringify({ attemptIds })
        });

        if (state.attempt && state.selectedAttemptIds.has(state.attempt.id)) {
          state.attempt = null;
          state.assessment = null;
          state.latestResults = null;
          updateActiveAttemptChip();
          updateModeControlLock();
          attemptContent.innerHTML = `<div class="empty-state">Selected attempt deleted.</div>`;
        }

        state.selectedAttemptIds.clear();
        await loadGrades();
      }

      function filteredHistoryRows(rows: AttemptHistoryRow[]) {
        const filters = state.historyFilters;
        return rows.filter((row) => {
          if (filters.status && row.status !== filters.status) return false;
          if (filters.mode && row.mode !== filters.mode) return false;
          if (filters.assessmentType && row.assessmentType !== filters.assessmentType) return false;
          if (filters.categoryId && row.categoryId !== filters.categoryId) return false;
          if (filters.areaId && !row.areaIds.includes(filters.areaId)) return false;
          if (filters.questionType && !row.questionTypes.includes(filters.questionType as QuestionType)) return false;
          if (filters.committed === "yes" && !row.isCommitted) return false;
          if (filters.committed === "no" && row.isCommitted) return false;
          if (filters.score === "lt70" && row.percentScore >= 70) return false;
          if (filters.score === "70to89" && (row.percentScore < 70 || row.percentScore >= 90)) return false;
          if (filters.score === "gte90" && row.percentScore < 90) return false;
          return true;
        });
      }

      function sortHistoryRows(rows: AttemptHistoryRow[]) {
        const { key, direction } = state.historySort;
        return [...rows].sort((a, b) => {
          const left = historySortValue(a, key);
          const right = historySortValue(b, key);
          const comparison = typeof left === "number" && typeof right === "number"
            ? left - right
            : String(left).localeCompare(String(right));
          return direction === "asc" ? comparison : -comparison;
        });
      }

      function historySortValue(row: AttemptHistoryRow, key: string) {
        if (key === "lastActivityAt") return new Date(row.lastActivityAt ?? row.startedAt).getTime();
        if (key === "percentScore") return row.percentScore;
        return String((row as unknown as Record<string, unknown>)[key] ?? "");
      }

      function renderSortableHeader(key: string, label: string) {
        const active = state.historySort.key === key;
        const direction = active ? (state.historySort.direction === "asc" ? "up" : "down") : "";
        return `<th><button type="button" class="sort-button ${active ? "active" : ""}" data-sort-history="${escapeHtml(key)}">${escapeHtml(label)}${direction ? ` ${direction}` : ""}</button></th>`;
      }

      function renderHistorySelect(name: keyof typeof state.historyFilters, label: string, options: [string, string][]) {
        return `
          <label class="field compact">
            <span>${escapeHtml(label)}</span>
            <select data-history-filter="${escapeHtml(name)}">
              ${options.map(([value, text]) => `<option value="${escapeHtml(value)}" ${state.historyFilters[name] === value ? "selected" : ""}>${escapeHtml(text)}</option>`).join("")}
            </select>
          </label>
        `;
      }

      function uniqueOptions(options: [string, string][]) {
        const seen = new Set<string>();
        return options.filter(([value]) => {
          if (!value || seen.has(value)) return false;
          seen.add(value);
          return true;
        }).sort((left, right) => left[1].localeCompare(right[1]));
      }

      function modeLabel(mode: AssessmentMode) {
        return {
          practice: "Practice",
          scored: "Scored"
        }[mode] ?? mode;
      }

      function questionTypeLabel(type: QuestionType) {
        return {
          multipleChoice: "Multiple choice",
          selectAll: "Select all",
          freeResponse: "Free response",
          numericResponse: "Numeric response",
          code: "Code",
          symbolicResponse: "Symbolic response"
        }[type] ?? type;
      }

      function formatDate(value: string | null | undefined) {
        return value ? new Date(value).toLocaleString() : "-";
      }

      function activateTab(tabName: string) {
        document.querySelectorAll(".tab").forEach((item) => item.classList.toggle("active", (item as HTMLButtonElement).dataset.tab === tabName));
        document.querySelectorAll(".view").forEach((item) => item.classList.remove("active"));
        document.querySelector(`#view-${tabName}`)?.classList.add("active");
