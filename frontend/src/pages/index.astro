              <label for="question-code-starter-${index}">Starter code</label>
              <textarea id="question-code-starter-${index}" data-question-field="starterCode" rows="6">${escapeHtml(question.starterCode ?? "")}</textarea>
            </div>
            <div class="field">
              <label for="question-code-tests-${index}">Tests JSON</label>
              <textarea id="question-code-tests-${index}" data-question-field="tests" rows="4">${escapeHtml(JSON.stringify(question.tests ?? [], null, 2))}</textarea>
