      async function initialize() {
        try {
          state.settings = await api<AppSettings>("/settings");
          state.categories = await api<Category[]>("/categories");
          fillSettingsForm(state.settings);
          renderCategories();
          renderCreateCategories();
          addDraftQuestion();
          await loadAssessments(categorySelect.value);
          await initializeNavigation();
          await loadGrades();
          setApiStatus("Backend online", "ok");
        } catch (error) {
          setApiStatus("Backend offline", "error");
          attemptContent.textContent = readableError(error);
        }
      }

      async function loadAssessments(categoryId: string) {
        if (!categoryId) {
          state.assessments = [];
          renderAssessmentOptions();
          return;
        }

        state.assessments = await api<AssessmentSummary[]>(`/assessments?categoryId=${encodeURIComponent(categoryId)}`);
        state.assessments.forEach(a => {
          a.hasCompletedAttempt = state.completedAssessmentIds.includes(a.id);
        });
        renderAssessmentOptions();
      }

      async function loadRecommendations() {
        try {
          state.navigationRecommendations = await api<NavigationRecommendation[]>("/navigation/recommendations");
        } catch (error) {
          console.error("Recommendations unavailable:", error);
          state.navigationRecommendations = [];
        }
      }

      async function initializeNavigation() {
        try {
          setupSearch();
          const catalog = await api<NavigationCatalog>("/navigation/catalog");
          if (!catalog.assessments.length) throw new Error("The assessment catalog is empty.");
          state.navigationCatalog = catalog;
          await loadRecommendations();
          navError.hidden = true;
          renderNavigation();
        } catch (error) {
          state.navigationCatalog = null;
          navError.textContent = `Guided navigation is unavailable. The classic picker remains ready. ${readableError(error)}`;
          navError.hidden = false;
          classicPicker.open = true;
        }
      }

      function setupSearch() {
        const searchInput = document.getElementById("assessment-search-input") as HTMLInputElement | null;
        const suggestionsBox = document.getElementById("search-suggestions");
        const resultsContainer = document.getElementById("search-results-container");
        const resultsList = document.getElementById("search-results-list");
        const navStages = document.getElementById("nav-stages");
        
        if (!searchInput || !suggestionsBox || !resultsContainer || !resultsList || !navStages) return;

        let debounceTimer: ReturnType<typeof setTimeout> | null = null;
        
        searchInput.addEventListener("input", () => {
          const query = searchInput.value.trim();
          if (debounceTimer) clearTimeout(debounceTimer);

          if (query.length === 0) {
            suggestionsBox.hidden = true;
            if (resultsContainer.hidden === false) {
               resultsContainer.hidden = true;
               navStages.style.display = ""; // restore stages
            }
            return;
          }

          debounceTimer = setTimeout(async () => {
            try {
              let url = `/search/suggestions?q=${encodeURIComponent(query)}`;
              if (state.navigationSelection.subjectId) url += `&subjectId=${encodeURIComponent(state.navigationSelection.subjectId)}`;
              const suggestions = await api<AssessmentSearchSuggestion[]>(url);
              
              if (suggestions.length > 0) {
                suggestionsBox.innerHTML = suggestions.map(s => `
                  <div class="search-suggestion-item" data-term="${escapeHtml(s.label)}" data-kind="${escapeHtml(s.kind)}">
                    <span class="suggestion-kind">${escapeHtml(s.kind)}</span>
                    <span class="suggestion-term">${escapeHtml(s.label)}</span>
                  </div>
                `).join("");
                suggestionsBox.hidden = false;
              } else {
                suggestionsBox.innerHTML = `<div class="search-suggestion-item muted">No suggestions found</div>`;
                suggestionsBox.hidden = false;
              }
            } catch (e) {
              console.error("Search suggestion failed", e);
            }
          }, 300);
        });

        suggestionsBox.addEventListener("click", (e) => {
          const item = (e.target as HTMLElement).closest(".search-suggestion-item");
          if (!item) return;
          const term = item.getAttribute("data-term");
          if (term) {
             searchInput.value = term;
             suggestionsBox.hidden = true;
             performSearch(term);
          }
        });

        searchInput.addEventListener("keydown", (e) => {
          if (e.key === "Enter") {
             e.preventDefault();
             suggestionsBox.hidden = true;
             performSearch(searchInput.value.trim());
          } else if (e.key === "Escape") {
             suggestionsBox.hidden = true;
          }
        });

        // Hide suggestions when clicking outside
        document.addEventListener("click", (e) => {
           if (!searchInput.contains(e.target as Node) && !suggestionsBox.contains(e.target as Node)) {
              suggestionsBox.hidden = true;
           }
        });

        async function performSearch(query: string) {
          if (!query) return;
          try {
            let url = `/search/assessments?q=${encodeURIComponent(query)}`;
            if (state.navigationSelection.subjectId) url += `&subjectId=${encodeURIComponent(state.navigationSelection.subjectId)}`;
            const results = await api<AssessmentSearchResult[]>(url);
            
            navStages.style.display = "none";
            resultsContainer.hidden = false;
            
            if (results.length === 0) {
              resultsList.innerHTML = `<p class="muted" style="padding: 1rem;">No assessments found matching "${escapeHtml(query)}".</p>`;
              return;
            }

            resultsList.innerHTML = results.map(r => {
              const tagsHtml = r.tags.map(t => `<span class="assessment-chip tag">${escapeHtml(t)}</span>`).join("");
              return `
              <div class="nav-tile" role="option" tabindex="0" data-assessment-id="${escapeHtml(r.id)}">
                <div class="tile-header">
                  <h4>${escapeHtml(r.title)}</h4>
                </div>
                <div class="tile-meta">
                  <span class="assessment-chip format">${escapeHtml(r.assessmentType)}</span>
                  <span class="assessment-chip count">${r.questionCount} questions</span>
                  ${tagsHtml}
                </div>
              </div>
            `}).join("");
          } catch (e) {
            console.error("Search failed", e);
            resultsList.innerHTML = `<p class="nav-error">Search failed: ${escapeHtml(readableError(e))}</p>`;
          }
        }

        // Handle clicking on search result
        resultsList.addEventListener("click", (e) => {
           const tile = (e.target as HTMLElement).closest(".nav-tile");
           if (!tile) return;
           const id = tile.getAttribute("data-assessment-id");
           if (id) {
               // Update selection state and unhide start button
               document.querySelectorAll("#search-results-list .nav-tile").forEach(t => t.classList.remove("selected"));
               tile.classList.add("selected");
               state.navigationSelection.assessmentId = id;
               navActions.hidden = false;
           }
        });
        
        resultsList.addEventListener("keydown", (e) => {
           if (e.key === "Enter" || e.key === " ") {
              e.preventDefault();
              (e.target as HTMLElement).click();
           }
        });
      }
