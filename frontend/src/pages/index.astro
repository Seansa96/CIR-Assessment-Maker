        if (question.type === "circuit") {
          const def = question.circuitQuestion || {
            interactionMode: "build",
            paletteSymbolIds: ["resistor", "battery", "capacitor", "junction"],
            editableProperties: ["value", "label", "rotation"],
            diagram: { width: 600, height: 400, components: [], nodes: [], wires: [], annotations: [] }
          };
          let promptNote = "";
          let toolbarHtml = "";

          if (def.interactionMode === "select") {
            promptNote = `<p class="input-help"><strong>Interaction Mode: Select.</strong> Click components, nodes, or wires in the diagram below to select them.</p>`;
          } else if (def.interactionMode === "meterPlacement") {
            promptNote = `<p class="input-help"><strong>Interaction Mode: Meter Placement.</strong> Select Voltmeter or Ammeter tool below, then place/drag probes onto the circuit terminals or nodes.</p>`;
            toolbarHtml = `
              <div class="circuit-meter-toolbar">
                <button type="button" class="meter-btn" id="tool-voltmeter">Voltmeter Probe Tool</button>
                <button type="button" class="meter-btn" id="tool-ammeter">Ammeter Tool</button>
                <button type="button" class="meter-btn" id="tool-clear-meter">Eraser/Reset Probes Tool</button>
              </div>
            `;
          } else if (def.interactionMode === "valueEntry") {
            promptNote = `<p class="input-help"><strong>Interaction Mode: Value Entry.</strong> Click components in the diagram to edit/enter their electrical values (e.g. 10k, 5V, 220).</p>`;
          } else if (def.interactionMode === "build") {
            promptNote = `<p class="input-help"><strong>Interaction Mode: Build.</strong> Drag components to position them. Click green terminal dots to draw connecting wires. Click to select items, and use the toolbar to rotate or delete.</p>`;
            const symbols = def.paletteSymbolIds?.length > 0 ? def.paletteSymbolIds : ["resistor", "battery", "capacitor", "junction"];
            toolbarHtml = `
              <div class="circuit-build-toolbar">
                <div class="palette-buttons">
                  ${symbols.map(sym => `<button type="button" class="palette-btn" data-symbol="${sym}">Add ${sym}</button>`).join(" ")}
                </div>
                <div class="tool-actions">
                  <button type="button" id="btn-circuit-rotate">Rotate Selected</button>
                  <button type="button" class="danger-light" id="btn-circuit-delete">Delete Selected</button>
                  <button type="button" id="btn-circuit-node">Add Junction Node</button>
                </div>
