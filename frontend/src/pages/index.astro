      function renderRecommendedPath(subjectId: string) {
        const container = document.getElementById("nav-recommended-path");
        const list = document.getElementById("recommended-path-list");
        if (!container || !list) return;

        if (!subjectId || !RECOMMENDED_PATHS[subjectId]) {
          container.hidden = true;
          return;
        }

        container.hidden = false;
        const path = RECOMMENDED_PATHS[subjectId];
        list.innerHTML = path.map((step, index) => `
          <div class="recommended-path-step">
            <div class="step-number">${index + 1}</div>
            <div class="step-content">
              <h4>${escapeHtml(step.label)}</h4>
              <p>${escapeHtml(step.desc)}</p>
            </div>
          </div>
        `).join("");
      }

      function renderNavigation() {
        const catalog = state.navigationCatalog;
        if (!catalog) return;
        const selection = state.navigationSelection;

        const inProgress = state.attempt?.status === "inProgress";
        const compactBar = document.querySelector<HTMLElement>("#nav-compact-active-session");
        const classicPicker = document.querySelector<HTMLElement>("#classic-picker");
        const navStages = document.querySelector<HTMLElement>("#nav-stages");

        if (inProgress) {
          if (navStages) navStages.hidden = true;
          if (classicPicker) classicPicker.hidden = true;
          navActions.hidden = true;
          navBreadcrumb.hidden = true;

          if (compactBar) {
            compactBar.hidden = false;
            compactBar.innerHTML = `
              <div class="compact-bar">
                <span class="compact-bar-item">${escapeHtml(catalog.subjects.find(s => s.id === selection.subjectId)?.title ?? "")}</span>
                <span class="compact-bar-sep">›</span>
                <span class="compact-bar-item">${escapeHtml(catalog.areas.find(a => a.id === selection.areaId)?.title ?? "")}</span>
                <span class="compact-bar-sep">›</span>
                <span class="compact-bar-item">${escapeHtml(catalog.topics.find(t => t.id === selection.topicId)?.title ?? "")}</span>
                <span class="compact-bar-sep">›</span>
                <span class="compact-bar-item"><strong>${escapeHtml(state.assessment?.title ?? "")}</strong> (${escapeHtml(state.attempt?.mode ?? "")})</span>
                <button type="button" class="compact-bar-change secondary-action" id="btn-change-assessment">Change Assessment</button>
              </div>
            `;
            const changeBtn = compactBar.querySelector("#btn-change-assessment");
            if (changeBtn) {
              changeBtn.addEventListener("click", () => {
                if (confirm("Are you sure? Your current progress will be paused and saved, but you will leave this assessment.")) {
                  state.attempt = null;
                  state.assessment = null;
                  state.latestResults = null;
                  renderApp();
                }
              });
            }
          }
          return;
        } else {
          if (navStages) navStages.hidden = false;
          if (classicPicker) classicPicker.hidden = false;
          if (compactBar) compactBar.hidden = true;
          const stageSubject = document.querySelector<HTMLElement>("#nav-stage-subject");
          if (stageSubject) stageSubject.hidden = false;
        }


        const recommendations = state.navigationRecommendations ?? [];
        const topicRecommendations = new Map(recommendations.map(r => [r.topicId, r]));

        const subjects = catalog.subjects
          .map((subject) => ({
            subject,
            count: catalog.assessments.filter((assessment) => assessment.subjectId === subject.id).length
          }))
          .filter((entry) => entry.count > 0);

        renderNavigationTiles("nav-subject-tiles", subjects.map(({ subject, count }) => ({
          id: subject.id,
          label: subject.title,
          description: subject.description,
          count,
          selected: selection.subjectId === subject.id,
          disabled: false
        })), (id) => selectNavigationStage("subject", id));

        const subjectAssessments = catalog.assessments.filter((assessment) => assessment.subjectId === selection.subjectId);
        const areas = catalog.areas
          .filter((area) => area.subjectIds.includes(selection.subjectId))
          .map((area) => ({
            area,
            count: subjectAssessments.filter((assessment) => assessment.areaId === area.id).length
          }))
          .filter((entry) => entry.count > 0);
        renderNavigationTiles("nav-area-tiles", areas.map(({ area, count }) => {
          const areaRecs = recommendations.filter(r => r.areaIds.includes(area.id) && r.state === "review");
          const reviewCount = areaRecs.length;
          const badgeHtml = reviewCount > 0 ? `<span class="review-badge">${reviewCount} needs review</span>` : "";
          const numberTagHtml = area.index > 0 ? `<span class="nav-tile-number">${area.index}</span>` : "";
          return {
            id: area.id,
            label: area.title,
            description: area.description,
            count,
            selected: selection.areaId === area.id,
            disabled: false,
            badgeHtml: badgeHtml,
            numberTagHtml: numberTagHtml
          };
        }), (id) => selectNavigationStage("area", id));

        const areaAssessments = subjectAssessments.filter((assessment) => assessment.areaId === selection.areaId);
        const availableTopicIds = new Set(areaAssessments.map((assessment) => assessment.topicId));
        const topics = catalog.topics
          .filter((topic) => topic.subjectId === selection.subjectId && availableTopicIds.has(topic.id))
          .map((topic) => ({
            topic,
            count: areaAssessments.filter((assessment) => assessment.topicId === topic.id).length
          }));
        renderNavigationTiles("nav-topic-tiles", topics.map(({ topic, count }) => {
          const rec = topicRecommendations.get(topic.id);
          let badgeHtml = "";
          if (rec) {
            if (rec.isNextRecommended) badgeHtml = `<span class="badge evaluate" style="background: #1565c0; color: #fff;">Next</span>`;
            else if (rec.isEligible === false) badgeHtml = `<span class="badge review" style="background: #6b7280; color: #fff;">Prerequisites</span>`;
            else if (rec.state === "review") badgeHtml = `<span class="badge review" style="background: #ffd600; color: #000;">Review</span>`;
            else if (rec.state === "evaluate") badgeHtml = `<span class="badge evaluate" style="background: #00c853; color: #fff;">Ready to Evaluate</span>`;
            else if (rec.provisionalMastery) badgeHtml = `<span class="badge provisional" style="background: #e0e0e0; color: #000;">Provisional</span>`;
          }
          return {
            id: topic.id,
            label: topic.title,
            description: rec?.progressionReason ?? topic.description,
            count,
            selected: selection.topicId === topic.id,
            disabled: false,
            badgeHtml: badgeHtml
          };
        }), (id) => selectNavigationStage("topic", id));

        const activeTopicRec = topicRecommendations.get(selection.topicId);
        const topicAssessments = areaAssessments.filter((assessment) => assessment.topicId === selection.topicId);
        renderNavigationTiles("nav-goal-tiles", catalog.goals.map((goal) => {
          const count = topicAssessments.filter((assessment) => assessment.learningGoal === goal.id).length;
          const isSuggested = activeTopicRec?.recommendedLearningGoal === goal.id;
          return {
            id: goal.id,
            label: goal.label,
            count,
            selected: selection.goalId === goal.id,
            disabled: count === 0,
            suggested: isSuggested
          };
        }), (id) => selectNavigationStage("goal", id));

        const goal = catalog.goals.find((candidate) => candidate.id === selection.goalId);
        const goalAssessments = topicAssessments.filter((assessment) => assessment.learningGoal === selection.goalId);
        const activities = (goal?.activityTypes ?? []).map((activityType) => ({
          id: activityType,
          label: activityTypeLabel(activityType),
          count: goalAssessments.filter((assessment) => assessment.activityType === activityType).length
        })).filter((activity) => activity.count > 0);
        renderNavigationTiles("nav-activity-tiles", activities.map((activity) => {
          const isSuggested = selection.goalId === activeTopicRec?.recommendedLearningGoal && 
                              activeTopicRec?.recommendedActivityTypes.includes(activity.id);
          return {
            ...activity,
            selected: selection.activityType === activity.id,
            disabled: false,
            suggested: isSuggested
          };
        }), (id) => selectNavigationStage("activity", id));

        const matchingAssessments = goalAssessments.filter((assessment) =>
          assessment.activityType === selection.activityType);
        const assessmentList = document.querySelector<HTMLDivElement>("#nav-assessment-list")!;
        assessmentList.innerHTML = matchingAssessments.map((assessment) => {
          const isSuggested = activeTopicRec?.suggestedAssessmentIds.includes(assessment.id);
          return `
          <button
            type="button"
            class="nav-assessment-item ${selection.assessmentId === assessment.id ? "selected" : ""}"
            data-navigation-assessment="${escapeHtml(assessment.id)}"
            role="option"
            aria-selected="${selection.assessmentId === assessment.id}"
          >
            <span class="nav-assessment-name">
              ${escapeHtml(assessment.title)}
              ${assessment.hasCompletedAttempt ? `<span class="nav-tile-completed" style="position: static; display: inline-flex; margin-left: 0.35rem; vertical-align: middle;">✔ Completed</span>` : ""}
              ${isSuggested ? `<span class="nav-tile-suggested" style="position: static; display: inline-flex; margin-left: 0.35rem; vertical-align: middle;">★ Suggested</span>` : ""}
            </span>
            <span class="nav-assessment-meta">${escapeHtml(assessmentTypeLabel(assessment.assessmentType))} · ${escapeHtml(assessmentCountLabel(assessment))} items</span>
          </button>
        `}).join("");
        assessmentList.querySelectorAll<HTMLButtonElement>("[data-navigation-assessment]").forEach((button) => {
          button.addEventListener("click", () => selectNavigationStage("assessment", button.dataset.navigationAssessment ?? ""));
          button.addEventListener("dblclick", () => {
            selectNavigationStage("assessment", button.dataset.navigationAssessment ?? "");
            startNavigationAttempt();
          });
        });

        setNavigationStageVisible("area", Boolean(selection.subjectId));
        setNavigationStageVisible("topic", Boolean(selection.areaId));
        setNavigationStageVisible("goal", Boolean(selection.topicId));
        setNavigationStageVisible("activity", Boolean(selection.goalId));
        setNavigationStageVisible("assessments", Boolean(selection.activityType));
        navActions.hidden = !selection.assessmentId;
        renderNavigationBreadcrumb();
        renderRecommendedPath(selection.subjectId);
      }

      function renderNavigationTiles(
        containerId: string,
        items: Array<{
          id: string;
          label: string;
          description?: string | null;
          count?: number;
          selected?: boolean;
          disabled?: boolean;
          suggested?: boolean;
          badgeHtml?: string;
          numberTagHtml?: string;
        }>,
        onSelect: (id: string) => void
      ) {
        const container = document.querySelector<HTMLDivElement>(`#${containerId}`)!;
        container.innerHTML = items.map((item) => {
          const descriptionId = `nav-description-${item.id}`;
          const descriptionHtml = item.description
            ? `
              <span class="nav-tile-description" aria-hidden="true">${escapeHtml(item.description)}</span>
              <span class="nav-tile-description-tooltip" id="${escapeHtml(descriptionId)}" role="tooltip">${escapeHtml(item.description)}</span>`
            : "";
          return `
          <button
            type="button"
            class="nav-tile ${item.selected ? "selected" : ""}"
            data-navigation-id="${escapeHtml(item.id)}"
            role="option"
            aria-selected="${item.selected ?? false}"
            ${item.description ? `aria-describedby="${escapeHtml(descriptionId)}"` : ""}
            ${item.disabled ? "disabled" : ""}
          >
            ${item.numberTagHtml ?? ""}
            ${item.suggested ? `<span class="nav-tile-suggested">★ Suggested</span>` : ""}
            <span class="nav-tile-label">${escapeHtml(item.label)} ${item.badgeHtml ?? ""}</span>
            ${descriptionHtml}
            <span class="nav-tile-count">${item.count} available</span>
          </button>
        `;
        }).join("");
        container.querySelectorAll<HTMLButtonElement>("[data-navigation-id]").forEach((button) => {
          button.addEventListener("click", () => onSelect(button.dataset.navigationId ?? ""));
        });
      }

      function selectNavigationStage(
        stage: "subject" | "area" | "topic" | "goal" | "activity" | "assessment",
        id: string
      ) {
        const selection = state.navigationSelection;
        if (stage === "subject") Object.assign(selection, { subjectId: id, areaId: "", topicId: "", goalId: "", activityType: "", assessmentId: "" });
        if (stage === "area") Object.assign(selection, { areaId: id, topicId: "", goalId: "", activityType: "", assessmentId: "" });
        if (stage === "topic") Object.assign(selection, { topicId: id, goalId: "", activityType: "", assessmentId: "" });
        if (stage === "goal") Object.assign(selection, { goalId: id, activityType: "", assessmentId: "" });
        if (stage === "activity") Object.assign(selection, { activityType: id, assessmentId: "" });
        if (stage === "assessment") selection.assessmentId = id;
        renderNavigation();
      }

      function renderNavigationBreadcrumb() {
        const catalog = state.navigationCatalog;
        if (!catalog) return;
        const selection = state.navigationSelection;

        const inProgress = state.attempt?.status === "inProgress";
        const compactBar = document.querySelector<HTMLElement>("#nav-compact-active-session");
        const classicPicker = document.querySelector<HTMLElement>("#classic-picker");
        const navStages = document.querySelector<HTMLElement>("#nav-stages");

        if (inProgress) {
          if (navStages) navStages.hidden = true;
          if (classicPicker) classicPicker.hidden = true;
          navActions.hidden = true;
          navBreadcrumb.hidden = true;

          if (compactBar) {
            compactBar.hidden = false;
            compactBar.innerHTML = `
              <div class="compact-bar">
                <span class="compact-bar-item">${escapeHtml(catalog.subjects.find(s => s.id === selection.subjectId)?.title ?? "")}</span>
                <span class="compact-bar-sep">›</span>
                <span class="compact-bar-item">${escapeHtml(catalog.areas.find(a => a.id === selection.areaId)?.title ?? "")}</span>
                <span class="compact-bar-sep">›</span>
                <span class="compact-bar-item">${escapeHtml(catalog.topics.find(t => t.id === selection.topicId)?.title ?? "")}</span>
                <span class="compact-bar-sep">›</span>
                <span class="compact-bar-item"><strong>${escapeHtml(state.assessment?.title ?? "")}</strong> (${escapeHtml(state.attempt?.mode ?? "")})</span>
                <button type="button" class="compact-bar-change secondary-action" id="btn-change-assessment">Change Assessment</button>
              </div>
            `;
            const changeBtn = compactBar.querySelector("#btn-change-assessment");
            if (changeBtn) {
              changeBtn.addEventListener("click", () => {
                if (confirm("Are you sure? Your current progress will be paused and saved, but you will leave this assessment.")) {
                  state.attempt = null;
                  state.assessment = null;
                  state.latestResults = null;
                  renderApp();
                }
              });
            }
          }
          return;
        } else {
          if (navStages) navStages.hidden = false;
          if (classicPicker) classicPicker.hidden = false;
          if (compactBar) compactBar.hidden = true;
          const stageSubject = document.querySelector<HTMLElement>("#nav-stage-subject");
          if (stageSubject) stageSubject.hidden = false;
        }


        const parts = [
          { stage: "subject", id: selection.subjectId, label: catalog.subjects.find((item) => item.id === selection.subjectId)?.title },
          { stage: "area", id: selection.areaId, label: catalog.areas.find((item) => item.id === selection.areaId)?.title },
          { stage: "topic", id: selection.topicId, label: catalog.topics.find((item) => item.id === selection.topicId)?.title },
          { stage: "goal", id: selection.goalId, label: catalog.goals.find((item) => item.id === selection.goalId)?.label },
          { stage: "activity", id: selection.activityType, label: activityTypeLabel(selection.activityType) }
        ].filter((part) => part.id && part.label);
        navBreadcrumb.hidden = parts.length === 0;
        navBreadcrumb.innerHTML = parts.map((part, index) => `
          <span class="nav-breadcrumb-item">
            ${index > 0 ? `<span class="nav-breadcrumb-sep">›</span>` : ""}
            <button type="button" data-navigation-back="${part.stage}">${escapeHtml(part.label ?? "")}</button>
          </span>
        `).join("");
        navBreadcrumb.querySelectorAll<HTMLButtonElement>("[data-navigation-back]").forEach((button) => {
          button.addEventListener("click", () => resetNavigationAfter(button.dataset.navigationBack ?? "subject"));
        });
      }

      function resetNavigationAfter(stage: string) {
        const selection = state.navigationSelection;
        if (stage === "subject") Object.assign(selection, { areaId: "", topicId: "", goalId: "", activityType: "", assessmentId: "" });
        if (stage === "area") Object.assign(selection, { topicId: "", goalId: "", activityType: "", assessmentId: "" });
        if (stage === "topic") Object.assign(selection, { goalId: "", activityType: "", assessmentId: "" });
        if (stage === "goal") Object.assign(selection, { activityType: "", assessmentId: "" });
        if (stage === "activity") selection.assessmentId = "";
        renderNavigation();
      }

      function setNavigationStageVisible(stage: string, visible: boolean) {
        const element = document.querySelector<HTMLElement>(`#nav-stage-${stage}`);
        if (element) element.hidden = !visible;
      }

      function activityTypeLabel(activityType: string) {
        return {
          conceptLesson: "Concept Lesson",
          glossary: "Glossary",
          guidedWorkedExample: "Guided Worked Example",
          interactiveExploration: "Interactive Exploration",
          recognitionDrill: "Recognition Drill",
          clozeDrill: "Cloze Drill",
          mixedRecallSet: "Mixed Recall Set",
          focusedPractice: "Focused Practice",
          mixedPractice: "Mixed Practice",
          guidedProject: "Guided Project",
          directedProject: "Directed Project",
          codingApplication: "Coding Application",
          circuitApplication: "Circuit Application",
          masteryCheck: "Mastery Check",
          formalTest: "Formal Test",
          selfReview: "Self Review"
        }[activityType] ?? activityType;
      }

      async function startAttempt() {
        const assessmentId = assessmentSelect.value;
        if (!assessmentId) return;

        const startButton = document.querySelector<HTMLButtonElement>("#start-attempt")!;
        const mode = document.querySelector<HTMLInputElement>("input[name='mode']:checked")!.value as AssessmentMode;
        await startSelectedAssessment(assessmentId, mode, startButton);
      }

      async function startNavigationAttempt() {
        const assessmentId = state.navigationSelection.assessmentId;
        if (!assessmentId) return;
        const startButton = document.querySelector<HTMLButtonElement>("#nav-start-attempt")!;
        const mode = document.querySelector<HTMLInputElement>("input[name='nav-mode']:checked")!.value as AssessmentMode;
        await startSelectedAssessment(assessmentId, mode, startButton);
      }

      async function startSelectedAssessment(
        assessmentId: string,
        mode: AssessmentMode,
        startButton: HTMLButtonElement
      ) {
        if (state.attempt?.status === "inProgress") {
          if (!confirm("Starting this assessment will permanently delete your current unsaved attempt. Continue?")) return;
          try {
            setBusy(startButton, "Deleting");
            await api(`/attempts/${encodeURIComponent(state.attempt.id)}`, { method: "DELETE" });
          } catch (e) {
            console.error(e);
            alert("Failed to delete the previous attempt.");
            clearBusy(startButton, "Start Selected");
            return;
          }
        }
        
        setBusy(startButton, "Loading");
        try {
          state.assessment = await api<Assessment>(`/assessments/${encodeURIComponent(assessmentId)}`);
          state.attempt = await api<Attempt>("/attempts", {
            method: "POST",
            body: JSON.stringify({ assessmentId, mode })
          });
          state.currentIndex = 0;
          state.latestResults = null;
          state.guidedProjectSession = null;
          state.guidedProjectActiveFile = "";
          if (state.sandboxTerminal) { state.sandboxTerminal.dispose(); state.sandboxTerminal = null; }
          updateActiveAttemptChip();
          updateModeControlLock();
          await renderCurrentQuestion();
          void prepareCodeRunnerForAttempt();
          if (typeof loadRecommendations === "function") {
            await loadRecommendations();
          }
          state.historyRows = [];
          

        } catch (e) {
          console.error(e);
          alert("Failed to load assessment.");
        } finally {
          clearBusy(startButton, "Start Selected");
        }
      }

      // Export a global helper to jump into a specific assessment (used from Grade Log Actionable Steps)
      (window as any).startAssessmentDirectly = async (assessmentId: string) => {
        // Just use a dummy button to satisfy the API
        const dummyButton = document.createElement("button");
        await startSelectedAssessment(assessmentId, "practice", dummyButton);
      };

      function assessmentHasCode(): boolean {
        return (state.assessment?.questions ?? []).some(question => question.type === "code")
          || (state.assessment?.workedExamples ?? []).some(example => example.steps.some(step => (step.question?.type ?? step.type) === "code"));
      }

      async function prepareCodeRunnerForAttempt() {
        if (!state.attempt || !assessmentHasCode()) {
          codeRunnerStatus = null;
          return;
        }

        codeRunnerStatus = { state: "starting", languages: [], message: "Preparing the local code runner.", updatedAt: new Date().toISOString() };
        await renderCurrentQuestion();
        try {
          codeRunnerStatus = await api<CodeRunnerStatus>(`/attempts/${encodeURIComponent(state.attempt.id)}/code-runner/prepare`, { method: "POST" });
        } catch (e) {
          codeRunnerStatus = { state: "failed", languages: [], message: e instanceof Error ? e.message : "Could not prepare the local code runner.", updatedAt: new Date().toISOString() };
        }
        await renderCurrentQuestion();
      }

      function renderCodeRunnerStatus(question: Question): string {
        if (question.type !== "code" || !codeRunnerStatus) return "";
        const ready = codeRunnerStatus.state === "ready";
        const message = escapeHtml(codeRunnerStatus.message ?? (ready ? "Code runner ready." : "Preparing code runner."));
        const diagnostics = renderCodeRunnerDiagnostics(codeRunnerStatus);
        return `<div class="feedback ${ready ? "correct" : "incorrect"} code-runner-status"><strong>${ready ? "Coding environment ready" : "Coding environment preparing"}</strong><br/>${message}${ready ? "" : ' <button type="button" id="refresh-code-runner">Retry</button>'}${diagnostics}</div>`;
      }

      function renderCodeRunnerDiagnostics(runner: CodeRunnerStatus): string {
        if (!IS_DEV || !runner.diagnostics) return "";
        const details = runner.diagnostics;
        const lines = [
          details.containerState ? `Container state: ${details.containerState}${details.containerExitCode !== null && details.containerExitCode !== undefined ? ` (exit ${details.containerExitCode})` : ""}` : "",
          details.containerImage ? `Image: ${details.containerImage}` : "",
          details.portBinding ? `Port: 127.0.0.1:${details.portBinding}` : "",
          details.lastProbeError ? `Readiness probe: ${details.lastProbeError}` : "",
          details.recentContainerLogs ? `Container logs:\n${details.recentContainerLogs}` : ""
        ].filter(Boolean);
        if (lines.length === 0) return "";
        return `<details class="code-runner-diagnostics"><summary>Developer diagnostics</summary><pre>${escapeHtml(lines.join("\n"))}</pre></details>`;
      }

      async function submitCurrentAnswer() {
        if (!state.attempt || !state.assessment) return;
        const question = getCurrentQuestion();
        const payload = readAnswer(question);
        const submitButton = document.querySelector<HTMLButtonElement>("#submit-answer");

        if (state.assessment.assessmentType === "workedExample"
          && question.type === "freeResponse"
          && !payload.freeResponseText?.trim()) {
          codeSubmitError = "Enter your setup and answer before continuing to the next step.";
          await renderCurrentQuestion();
          return;
        }

        if (submitButton) setBusy(submitButton, "Saving");

        try {
          codeSubmitError = null;
          state.attempt = await api<Attempt>(`/attempts/${state.attempt.id}/answers`, {
            method: "POST",
            body: JSON.stringify(payload)
          });

          state.latestResults = await api<AttemptResults>(`/attempts/${state.attempt.id}/results`);
          if (state.latestResults.assessmentType === "workedExample") {
            state.currentIndex = firstUnansweredIndex(state.latestResults, state.attempt);
          }

          if (state.attempt.status === "completed") {
            updateActiveAttemptChip("Complete");
            updateModeControlLock();
            await renderResults(false);
            await loadGrades();
            return;
          }

          await renderCurrentQuestion();
        } catch (e) {
          console.error(e);
          codeSubmitError = e instanceof Error ? e.message : "Code submission failed.";
          await renderCurrentQuestion();
        } finally {
          if (submitButton) clearBusy(submitButton, "Submit Answer");
        }
      }

      async function markFreeResponseSelfCheck(questionId: string, isCorrect: boolean, selectedIssueSignalIds: string[] = []) {
        if (!state.attempt || !state.latestResults) return;
        const questionResults = state.latestResults.questions.flatMap((candidate) => [candidate, ...(candidate.partResults ?? [])]);
        const result = questionResults.find((candidate) => candidate.questionId === questionId)
          ?? state.latestResults.learningSections
            .map((section) => section.check)
            .find((candidate) => candidate?.questionId === questionId);
        if (!result || result.submittedAnswer?.freeResponseText === null || result.submittedAnswer?.freeResponseText === undefined) return;

        state.attempt = await api<Attempt>(`/attempts/${state.attempt.id}/answers`, {
          method: "POST",
          body: JSON.stringify({
            questionId,
            choiceIds: [],
            freeResponseText: result.submittedAnswer.freeResponseText,
            selfCheckCorrect: isCorrect,
            selectedIssueSignalIds
          })
        });
        state.latestResults = await api<AttemptResults>(`/attempts/${state.attempt.id}/results`);
        if (state.latestResults.assessmentType === "workedExample") {
          state.currentIndex = firstUnansweredIndex(state.latestResults, state.attempt);
        }

        if (state.latestResults.status === "completed") {
          await renderResults(isAttemptCommitted(state.attempt.id));
        } else {
          await renderCurrentQuestion();
        }

        await loadGrades();
      }

      async function resumeAttemptSession(attemptId: string) {
        const session = await api<AttemptSessionResponse>(`/attempts/${encodeURIComponent(attemptId)}/resume`, {
          method: "POST"
        });
        await loadSession(session, true);
      }

      async function reviewAttemptSession(attemptId: string) {
        const session = await api<AttemptSessionResponse>(`/attempts/${encodeURIComponent(attemptId)}/session`);
        await loadSession(session, false);
      }

      async function loadSession(session: AttemptSessionResponse, preferFirstUnanswered: boolean) {
        state.assessment = session.assessment;
        state.attempt = session.attempt;
        state.latestResults = session.results;
        state.guidedProjectSession = null;
        state.guidedProjectActiveFile = "";
        if (state.sandboxTerminal) { state.sandboxTerminal.dispose(); state.sandboxTerminal = null; }
        state.currentIndex = preferFirstUnanswered ? firstUnansweredIndex(session.results, session.attempt) : 0;
        updateActiveAttemptChip(statusLabel(session.attempt.status));
        syncModeControlToAttempt();
        updateModeControlLock();
        activateTab("load");
        void prepareCodeRunnerForAttempt();

        if (session.attempt.status === "completed") {
          await renderResults(isAttemptCommitted(session.attempt.id));
          return;
        }

        await renderCurrentQuestion();
      }

      async function refreshCurrentAssessment() {
        if (!state.assessment || !state.attempt || !IS_DEV) return;

        const refreshButton = document.querySelector<HTMLButtonElement>("[data-refresh-current-assessment]");
        const currentQuestionId = state.attempt.questionOrder[state.currentIndex] ?? "";
        if (refreshButton) setBusy(refreshButton, "Refreshing");

        try {
          const refreshedAssessment = await api<Assessment>(`/assessments/${encodeURIComponent(state.assessment.id)}`);
          state.assessment = refreshedAssessment;

          if (state.attempt.status !== "inProgress") {
            state.latestResults = await api<AttemptResults>(`/attempts/${state.attempt.id}/results`);
            await renderResults(isAttemptCommitted(state.attempt.id));
            return;
          }

          const refreshedQuestionIds = getAssessmentQuestionIds(refreshedAssessment);
          if (refreshedQuestionIds.length > 0 && !refreshedQuestionIds.includes(currentQuestionId)) {
            const fallbackIndex = state.attempt.questionOrder.findIndex((questionId) => refreshedQuestionIds.includes(questionId));
            state.currentIndex = Math.max(0, fallbackIndex);
          }

          await renderCurrentQuestion();
        } finally {
          if (refreshButton) clearBusy(refreshButton, "Refresh Assessment");
        }
      }

      async function pauseAttempt() {
        if (!state.attempt) return;
        await flushLearningSectionState();
        if (state.assessment?.assessmentType === "guidedProject") {
          await saveGuidedProjectFiles();
        }
        const response = await api<{ attempt: Attempt; results: AttemptResults }>(`/attempts/${state.attempt.id}/pause`, {
          method: "POST"
        });
        state.attempt = response.attempt;
        state.latestResults = response.results;
        updateActiveAttemptChip("Paused");
        updateModeControlLock();
        attemptContent.innerHTML = `
          <div class="empty-state">
            <p>Progress saved. This attempt is paused and can be continued from Attempt Sessions.</p>
            <div class="button-row" style="justify-content: center; margin-top: 1rem;">
              <button type="button" class="chunky" id="close-assessment">Return to Catalog</button>
            </div>
          </div>
        `;
        document.querySelector<HTMLButtonElement>("#close-assessment")?.addEventListener("click", clearAssessmentView);
        await loadGrades();
      }

      async function abandonAttempt() {
        if (!state.attempt) return;

        // Show an inline three-option panel instead of a blocking confirm().
        // Capture identifiers now so they remain available in the click handlers.
        const attemptId = state.attempt.id;
        if (state.assessment?.assessmentType === "sandbox" && state.sandboxTerminal) {
          state.sandboxTerminal.dispose();
          state.sandboxTerminal = null;
        }

        attemptContent.innerHTML = `
          <div class="empty-state">
            <p><strong>Quit this assessment?</strong></p>
            <p class="muted">All unsaved progress will be permanently deleted.</p>
            <div class="button-row" style="justify-content: center; margin-top: 1.5rem; flex-wrap: wrap; gap: 0.5rem;">
              <button type="button" class="chunky danger-action" id="confirm-quit-attempt">Quit Assessment</button>
              <button type="button" class="chunky" id="confirm-reset-restart">Reset &amp; Restart</button>
              <button type="button" id="cancel-quit-attempt">Cancel</button>
            </div>
          </div>
        `;

        document.querySelector<HTMLButtonElement>("#confirm-quit-attempt")?.addEventListener("click", async () => {
          try {
            await api(`/attempts/${encodeURIComponent(attemptId)}`, { method: "DELETE" });
          } catch (e) {
            console.error(e);
          }
          state.attempt = null;
          state.assessment = null;
          state.latestResults = null;
          state.guidedProjectSession = null;
          currentProjectEditor = null;
          if (state.sandboxTerminal) { state.sandboxTerminal.dispose(); state.sandboxTerminal = null; }
          activeCircuitCanvases.clear();
          activeGraphingCanvases.clear();
          clearActiveWidgets();
          updateActiveAttemptChip();
          updateModeControlLock();
          attemptContent.innerHTML = `
            <div class="empty-state">
              <p>Attempt deleted.</p>
              <div class="button-row" style="justify-content: center; margin-top: 1rem;">
                <button type="button" class="chunky" id="close-assessment">Return to Catalog</button>
              </div>
            </div>
          `;
          document.querySelector<HTMLButtonElement>("#close-assessment")?.addEventListener("click", clearAssessmentView);
          await loadGrades();
          if (typeof loadRecommendations === "function") {
            await loadRecommendations();
          }
        });

        document.querySelector<HTMLButtonElement>("#confirm-reset-restart")?.addEventListener("click", async () => {
          await redoAssessment();
        });

        document.querySelector<HTMLButtonElement>("#cancel-quit-attempt")?.addEventListener("click", () => {
          void renderCurrentQuestion();
        });
      }

      async function redoAssessment() {
        if (!state.assessment) return;
        const assessmentId = state.assessment.id;
        const mode = state.attempt?.mode ?? "practice";

        const redoBtn = document.querySelector<HTMLButtonElement>("#redo-assessment");
        if (redoBtn) setBusy(redoBtn, "Starting");

        try {
          if (state.attempt) {
            await api(`/attempts/${encodeURIComponent(state.attempt.id)}`, { method: "DELETE" });
          }

          state.assessment = await api<Assessment>(`/assessments/${encodeURIComponent(assessmentId)}`);
          state.attempt = await api<Attempt>("/attempts", {
            method: "POST",
            body: JSON.stringify({ assessmentId, mode })
          });
          state.currentIndex = 0;
          state.latestResults = null;
          state.guidedProjectSession = null;
          state.guidedProjectActiveFile = "";
          if (state.sandboxTerminal) { state.sandboxTerminal.dispose(); state.sandboxTerminal = null; }
          currentProjectEditor = null;
          activeCircuitCanvases.clear();
          activeGraphingCanvases.clear();
          clearActiveWidgets();

          updateActiveAttemptChip();
          updateModeControlLock();
          await renderCurrentQuestion();

          if (typeof loadRecommendations === "function") {
            await loadRecommendations();
          }
          state.historyRows = [];
        } catch (e) {
          console.error(e);
          alert("Failed to restart the assessment.");
          if (redoBtn) clearBusy(redoBtn, "Redo Assessment");
        }
      }

      function clearAssessmentView() {
        state.attempt = null;
        state.assessment = null;
        state.latestResults = null;
        state.guidedProjectSession = null;
        currentProjectEditor = null;
        activeCircuitCanvases.clear();
        activeGraphingCanvases.clear();
        clearActiveWidgets();

        updateActiveAttemptChip();
        updateModeControlLock();
        attemptContent.innerHTML = `<div class="empty-state">Choose an assessment to begin.</div>`; renderNavigation();
      }

      async function deleteAttempt(attemptId: string) {
        if (!confirm("Delete this attempt and any linked grade entry? This cannot be undone.")) return;
        await api(`/attempts/${encodeURIComponent(attemptId)}`, { method: "DELETE" });
        if (state.attempt?.id === attemptId) {
          state.attempt = null;
          state.assessment = null;
          state.latestResults = null;
          updateActiveAttemptChip();
          updateModeControlLock();
          attemptContent.innerHTML = `<div class="empty-state">Attempt deleted.</div>`;
        }
        await loadGrades();
      }

      async function deleteGrade(attemptId: string) {
        if (!confirm("Delete this grade entry and its linked attempt? This cannot be undone.")) return;
        await api(`/grades/${encodeURIComponent(attemptId)}`, { method: "DELETE" });
        if (state.attempt?.id === attemptId) {
          state.attempt = null;
          state.assessment = null;
          state.latestResults = null;
          updateActiveAttemptChip();
          updateModeControlLock();
          attemptContent.innerHTML = `<div class="empty-state">Grade and linked attempt deleted.</div>`;
        }
        await loadGrades();
      }

      async function completeAttempt() {
        if (!state.attempt) return;
        if (state.assessment?.assessmentType === "guidedProject") {
          await completeGuidedProject();
          return;
        }
        const completeButton = document.querySelector<HTMLButtonElement>("#complete-attempt");

        if (completeButton) setBusy(completeButton, "Completing");

        try {
          const response = await api<{ results: AttemptResults; committedGrade: unknown | null }>(`/attempts/${state.attempt.id}/complete`, {
            method: "POST"
          });
          state.latestResults = response.results;
          updateActiveAttemptChip("Complete");
          updateModeControlLock();
          await renderResults(response.committedGrade !== null);
          await loadGrades();
        } finally {
          if (completeButton) clearBusy(completeButton, "Complete");
        }
      }

      async function commitGrade() {
        if (!state.attempt || state.latestResults?.assessmentType === "workedExample" || state.latestResults?.assessmentType === "guidedProject") return;
        const btn = document.querySelector<HTMLButtonElement>("#commit-grade");
        if (btn) setBusy(btn, "Committing");
        try {
          await api("/grades/commit", {
            method: "POST",
            body: JSON.stringify({ attemptId: state.attempt.id })
          });
          await loadGrades();
          if (state.latestResults) await renderResults(true);
        } catch (error) {
          console.error("Failed to commit grade:", error);
          alert("Failed to commit score. Please try again.");
        } finally {
          if (btn) clearBusy(btn, "Commit Score");
        }
      }

      async function saveSettings(event: Event) {
        event.preventDefault();
        const form = new FormData(settingsForm);
        const settings: AppSettings = {
          schemaVersion: state.settings?.schemaVersion ?? 1,
          defaultMode: String(form.get("defaultMode")) as AssessmentMode,
          defaultQuestionOrder: String(form.get("defaultQuestionOrder")) as "randomized" | "static",
          defaultQuizLength: Number(form.get("defaultQuizLength")),
          defaultTestLength: Number(form.get("defaultTestLength")),
          questionTimerSeconds: nullableNumber(form.get("questionTimerSeconds")),
          assessmentTimerSeconds: nullableNumber(form.get("assessmentTimerSeconds")),
          commitScoredAttemptsAutomatically: form.get("commitScoredAttemptsAutomatically") === "on",
          codeRunnerBaseUrl: String(form.get("codeRunnerBaseUrl") ?? "http://localhost:2000/api/v2").trim(),
          codeRunnerCompileTimeoutMs: Number(form.get("codeRunnerCompileTimeoutMs") ?? 10000),
          codeRunnerRunTimeoutMs: Number(form.get("codeRunnerRunTimeoutMs") ?? 3000)
        };

        state.settings = await api<AppSettings>("/settings", {
          method: "PUT",
          body: JSON.stringify(settings)
        });
        settingsStatus.textContent = "Settings saved.";
      }

      async function loadDiagnostics() {
        const result = await api<{ run: any; diagnostics: any[] }>("/navigation/catalog/diagnostics");
        
        const runInfo = document.getElementById("diagnostics-run-info");
        const table = document.getElementById("diagnostics-table");
        const tbody = document.getElementById("diagnostics-tbody");
        const emptyState = document.getElementById("diagnostics-empty");

        if (!runInfo || !table || !tbody || !emptyState) return;

        if (!result.run) {
          runInfo.textContent = "No import runs have occurred.";
          table.hidden = true;
          emptyState.hidden = false;
          return;
        }

        const date = result.run.startedAt ? new Date(result.run.startedAt).toLocaleString() : "Unknown";
        runInfo.textContent = `Last run: ${date} (${result.run.status}). ${result.diagnostics.length} diagnostic(s) found.`;

        if (result.diagnostics.length === 0) {
          table.hidden = true;
          emptyState.hidden = false;
        } else {
          emptyState.hidden = true;
          table.hidden = false;
          tbody.innerHTML = result.diagnostics.map((d: any) => `
            <tr>
              <td style="color: ${d.severity === 'Error' ? 'var(--color-error, #d32f2f)' : 'var(--color-warning, #f57c00)'}; font-weight: 600;">
                ${escapeHtml(d.severity || 'Unknown')}
              </td>
              <td><code style="font-size: 0.85em;">${escapeHtml(d.code || '-')}</code></td>
              <td>
                <div style="word-break: break-all;">${escapeHtml(d.path || d.assessmentId || '-')}</div>
                ${d.line ? `<div style="font-size: 0.8em; color: var(--text-muted); margin-top: 4px;">Line ${d.line}${d.column ? ` Col ${d.column}` : ''}</div>` : ''}
              </td>
              <td>
                <div style="margin-bottom: 4px;">${escapeHtml(d.message || '-')}</div>
                ${d.code === 'YAML_DESERIALIZATION' ? `<div style="font-size: 0.85em; color: var(--text-muted);">Correct the value at the reported YAML location, then refresh the catalog diagnostics.</div>` : ''}
                ${d.suggestedKey ? `<div style="font-size: 0.85em; color: var(--text-muted); padding: 4px; background: rgba(0,0,0,0.05); border-radius: 4px;">Found: <code>${escapeHtml(d.actualKey || '')}</code> &rarr; Try: <code>${escapeHtml(d.suggestedKey)}</code></div>` : ''}
              </td>
            </tr>
          `).join("");
        }
      }

      function assessmentReportFilterQuery() {
        const params = new URLSearchParams();
        const assessmentId = document.querySelector<HTMLSelectElement>("#assessment-report-assessment-filter")?.value ?? "";
        const kind = document.querySelector<HTMLSelectElement>("#assessment-report-kind-filter")?.value ?? "";
        const status = document.querySelector<HTMLSelectElement>("#assessment-report-status-filter")?.value ?? "";
        if (assessmentId) params.set("assessment", assessmentId);
        if (kind) params.set("kind", kind);
        if (status) params.set("status", status);
        const query = params.toString();
        return query ? `?${query}` : "";
      }

      async function loadAssessmentReports() {
        if (!IS_DEV) return;
        const statusElement = document.querySelector<HTMLParagraphElement>("#assessment-reports-status");
        if (statusElement) statusElement.textContent = "Loading assessment reports…";

        try {
          const dashboard = await api<AssessmentReportDashboard>(`/dev/assessment-reports${assessmentReportFilterQuery()}`);
          renderAssessmentReportDashboard(dashboard);
          if (statusElement) {
            statusElement.textContent = `${dashboard.entries.length} matching report${dashboard.entries.length === 1 ? "" : "s"} across ${dashboard.assessments.length} assessment${dashboard.assessments.length === 1 ? "" : "s"}.`;
          }
        } catch (error) {
          if (statusElement) statusElement.textContent = `Unable to load assessment reports: ${readableError(error)}`;
        }
      }

      function renderAssessmentReportDashboard(dashboard: AssessmentReportDashboard) {
        const assessmentFilter = document.querySelector<HTMLSelectElement>("#assessment-report-assessment-filter");
        if (assessmentFilter) {
          const selected = assessmentFilter.value;
          assessmentFilter.innerHTML = `<option value="">All assessments</option>${dashboard.assessments.map((group) => `
            <option value="${escapeHtml(group.assessmentId)}">${escapeHtml(group.assessmentTitle)} (${group.openCount} open)</option>
          `).join("")}`;
          assessmentFilter.value = dashboard.assessments.some((group) => group.assessmentId === selected) ? selected : "";
        }

        const summary = document.querySelector<HTMLDivElement>("#assessment-report-summary");
        if (summary) {
          summary.innerHTML = dashboard.assessments.map((group) => `
            <article class="assessment-report-summary-card">
              <strong>${escapeHtml(group.assessmentTitle)}</strong>
              <code>${escapeHtml(group.assessmentId)}</code>
              <span>${group.openCount} open · ${group.resolvedCount} resolved · ${group.totalCount} total</span>
              <span>${group.bugCount} bugs · ${group.improvementCount} improvements · ${group.commentCount} comments</span>
            </article>
          `).join("");
        }

        const table = document.querySelector<HTMLTableElement>("#assessment-reports-table");
        const tbody = document.querySelector<HTMLTableSectionElement>("#assessment-reports-tbody");
        const empty = document.querySelector<HTMLDivElement>("#assessment-reports-empty");
        if (!table || !tbody || !empty) return;

        table.hidden = dashboard.entries.length === 0;
        empty.hidden = dashboard.entries.length > 0;
        tbody.innerHTML = dashboard.entries.map((entry) => `
          <tr>
            <td><span class="assessment-report-status-badge" data-status="${entry.status}">${escapeHtml(entry.status)}</span></td>
            <td>${escapeHtml(entry.kind)}</td>
            <td><strong>${escapeHtml(entry.assessmentTitle)}</strong><br><code>${escapeHtml(entry.assessmentId)}</code></td>
            <td><code>${escapeHtml(entry.contextId ?? "Assessment")}</code></td>
            <td class="assessment-report-comment">${escapeHtml(entry.comment).replace(/\r?\n/g, "<br>")}</td>
            <td><code>${escapeHtml(entry.attemptId)}</code></td>
            <td>${escapeHtml(formatDate(entry.createdAt))}</td>
            <td><button type="button" data-assessment-report-id="${escapeHtml(entry.id)}" data-assessment-report-next-status="${entry.status === "open" ? "resolved" : "open"}">${entry.status === "open" ? "Resolve" : "Reopen"}</button></td>
          </tr>
        `).join("");

        tbody.querySelectorAll<HTMLButtonElement>("[data-assessment-report-id]").forEach((button) => {
          button.addEventListener("click", () => void updateAssessmentReportStatus(button));
        });
      }

      async function updateAssessmentReportStatus(button: HTMLButtonElement) {
        const reportId = button.dataset.assessmentReportId;
        const status = button.dataset.assessmentReportNextStatus as AssessmentReportStatus | undefined;
        if (!reportId || !status) return;

        setBusy(button, status === "resolved" ? "Resolving" : "Reopening");
        try {
          await api<AssessmentReportEntry>(`/dev/assessment-reports/${encodeURIComponent(reportId)}/status`, {
            method: "PATCH",
            body: JSON.stringify({ status })
          });
          await loadAssessmentReports();
        } catch (error) {
          const statusElement = document.querySelector<HTMLParagraphElement>("#assessment-reports-status");
          if (statusElement) statusElement.textContent = `Unable to update report: ${readableError(error)}`;
          clearBusy(button, status === "resolved" ? "Resolve" : "Reopen");
        }
      }

      async function copyAssessmentReportsMarkdown() {
        if (!IS_DEV) return;
        const button = document.querySelector<HTMLButtonElement>("#copy-assessment-reports-markdown");
        if (!button) return;

        setBusy(button, "Copying");
        try {
          const response = await fetch(`${API_BASE}/dev/assessment-reports/markdown${assessmentReportFilterQuery()}`);
          if (!response.ok) throw new Error(await response.text());
          await copyPlainText(await response.text());
          button.textContent = "Copied";
          window.setTimeout(() => clearBusy(button, "Copy Markdown"), 1000);
        } catch (error) {
          const statusElement = document.querySelector<HTMLParagraphElement>("#assessment-reports-status");
          if (statusElement) statusElement.textContent = `Unable to copy Markdown: ${readableError(error)}`;
          clearBusy(button, "Copy Markdown");
        }
      }

      async function copyPlainText(text: string) {
        if (navigator.clipboard?.writeText) {
          await navigator.clipboard.writeText(text);
          return;
        }

        const textarea = document.createElement("textarea");
        textarea.value = text;
        textarea.style.position = "fixed";
        textarea.style.opacity = "0";
        document.body.append(textarea);
        textarea.select();
        document.execCommand("copy");
        textarea.remove();
      }

      function openAssessmentReportDialog(contextId: string | null) {
        if (!IS_DEV || !state.assessment || !state.attempt) return;
        const dialog = document.querySelector<HTMLDialogElement>("#assessment-report-dialog");
        const comment = document.querySelector<HTMLTextAreaElement>("#assessment-report-comment");
        const kind = document.querySelector<HTMLSelectElement>("#assessment-report-kind");
        const preview = document.querySelector<HTMLParagraphElement>("#assessment-report-context-preview");
        const formStatus = document.querySelector<HTMLParagraphElement>("#assessment-report-form-status");
        if (!dialog || !comment || !kind || !preview || !formStatus) return;

        dialog.dataset.assessmentId = state.assessment.id;
        dialog.dataset.attemptId = state.attempt.id;
        dialog.dataset.contextId = contextId ?? "";
        preview.textContent = `${state.assessment.title} (${state.assessment.id}) · ${contextId ? `Context: ${contextId}` : "Assessment-level report"}`;
        kind.value = "bug";
        comment.value = "";
        formStatus.textContent = "";
        updateAssessmentReportCharacterCount();
        dialog.showModal();
        comment.focus();
      }

      function closeAssessmentReportDialog() {
        document.querySelector<HTMLDialogElement>("#assessment-report-dialog")?.close();
      }

      function updateAssessmentReportCharacterCount() {
        const comment = document.querySelector<HTMLTextAreaElement>("#assessment-report-comment");
        const count = document.querySelector<HTMLSpanElement>("#assessment-report-character-count");
        if (comment && count) count.textContent = `${comment.value.length} / 1000`;
      }

      async function submitAssessmentReport(event: SubmitEvent) {
        event.preventDefault();
        if (!IS_DEV) return;
        const dialog = document.querySelector<HTMLDialogElement>("#assessment-report-dialog");
        const kind = document.querySelector<HTMLSelectElement>("#assessment-report-kind");
        const comment = document.querySelector<HTMLTextAreaElement>("#assessment-report-comment");
        const status = document.querySelector<HTMLParagraphElement>("#assessment-report-form-status");
        const button = document.querySelector<HTMLButtonElement>("#submit-assessment-report");
        if (!dialog || !kind || !comment || !status || !button) return;

        const normalizedComment = comment.value.trim();
        if (!normalizedComment) {
          status.textContent = "Enter a short ticket or comment before saving.";
          comment.focus();
          return;
        }

        setBusy(button, "Saving");
        status.textContent = "";
        try {
          await api<AssessmentReportEntry>("/dev/assessment-reports", {
            method: "POST",
            body: JSON.stringify({
              assessmentId: dialog.dataset.assessmentId,
              attemptId: dialog.dataset.attemptId,
              contextId: dialog.dataset.contextId || null,
              kind: kind.value,
              comment: normalizedComment
            })
          });
          status.textContent = "Report saved.";
          await loadAssessmentReports();
          window.setTimeout(closeAssessmentReportDialog, 500);
        } catch (error) {
          status.textContent = `Unable to save report: ${readableError(error)}`;
        } finally {
          clearBusy(button, "Save Report");
        }
      }

      async function updateCompletedAssessments() {
        try {
          state.completedAssessmentIds = await api<string[]>("/attempts/completed-assessments");
          let updated = false;
          
          if (state.assessments) {
            state.assessments.forEach(a => {
              a.hasCompletedAttempt = state.completedAssessmentIds.includes(a.id);
            });
            updated = true;
          }
          
          if (state.navigationCatalog) {
            state.navigationCatalog.assessments.forEach(a => {
              a.hasCompletedAttempt = state.completedAssessmentIds.includes(a.id);
            });
            updated = true;
          }

          if (updated) {
            renderAssessmentOptions();
            if (state.navigationCatalog) {
              renderNavigation();
            }
          }
        } catch (err) {
          console.error("Failed to update completed assessments:", err);
        }
      }

      async function loadGrades() {
        const [summary, analytics] = await Promise.all([
          api<{ entryCount: number; averagePercentScore: number | null; entries: GradeLogEntry[] }>("/grades/summary"),
          api<GradeAnalyticsSummary>("/analytics/grades")
        ]);
        await updateCompletedAssessments();
        state.analytics = analytics;
        state.gradeLogEntries = summary.entries;
        state.committedAttemptIds = new Set(summary.entries.map((entry) => entry.attemptId));
        const currentAttemptIds = new Set(analytics.attempts.map((attempt) => attempt.attemptId));
        state.selectedAttemptIds.forEach((attemptId) => {
          if (!currentAttemptIds.has(attemptId)) state.selectedAttemptIds.delete(attemptId);
        });

        updateAnalyticsDashboard();
        renderAttemptHistory();
        setupGradeLogInteractions();
      }

      function renderMasteryBadge(tier: MasteryTier): string {
        switch (tier) {
          case MasteryTier.Mastered: return '<span class="mastery-badge mastered">Mastered</span>';
          case MasteryTier.Proficient: return '<span class="mastery-badge proficient">Proficient</span>';
          case MasteryTier.Developing: return '<span class="mastery-badge developing">Developing</span>';
          case MasteryTier.Novice: return '<span class="mastery-badge novice">Novice</span>';
          default: return '<span class="mastery-badge unknown">Unknown</span>';
        }
      }

      function renderAnalyticsDashboard(analytics: GradeAnalyticsSummary, entries: GradeLogEntry[]) {
        const navTilesHtml = `
          <button type="button" class="nav-tile ${state.activeAnalyticsCategory === null ? 'selected' : ''} analytics-category-btn" data-category-id="">
            <strong>Action Queue</strong>
            <div class="nav-tile-description">Intelligence & Overview</div>
          </button>
        ` + analytics.categories.map(c => `
          <button type="button" class="nav-tile ${state.activeAnalyticsCategory === c.categoryId ? 'selected' : ''} analytics-category-btn" data-category-id="${escapeHtml(c.categoryId)}">
            <strong>${escapeHtml(c.categoryTitle)}</strong>
            <div class="nav-tile-description">GPA: ${c.averagePercent}% | ${c.attemptCount} Sessions</div>
          </button>
        `).join("");

        let content = "";

        if (state.activeAnalyticsCategory === null) {
          const actionQueueHtml = (analytics.actionableNextSteps || [])
            .sort((a, b) => b.urgencyScore - a.urgencyScore)
            .slice(0, 10)
            .map((step, index) => {
              const urgencyClass = step.urgencyScore > 500 ? 'urgency-critical' : step.urgencyScore > 200 ? 'urgency-high' : 'urgency-medium';
              const tierBadge = renderMasteryBadge(step.tier);
              const playlistHtml = step.playlist.map((p, i) => `
                <li class="playlist-item">
                  <span class="playlist-step-num">${i + 1}</span>
                  <div class="playlist-details">
                    <strong>${escapeHtml(p.title)}</strong>
                    <small>${escapeHtml(p.activityType)}</small>
                  </div>
                  <button type="button" class="btn-small primary" onclick="window.startAssessmentDirectly('${escapeHtml(p.id)}')">Start</button>
                </li>
              `).join("");

              return `
                <div class="action-card ${urgencyClass}">
                  <div class="action-card-header">
                    <div class="action-card-title">
                      <h4>${escapeHtml(step.skillId)}</h4>
                      ${tierBadge}
                    </div>
                    <button type="button" class="btn-repair" onclick="this.closest('.action-card').classList.toggle('expanded')">Repair this now</button>
                  </div>
                  <p class="action-card-message">${escapeHtml(step.message)}</p>
                  <div class="action-card-playlist">
