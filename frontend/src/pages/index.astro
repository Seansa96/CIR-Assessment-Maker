---
import "katex/dist/katex.min.css";
import "../styles/global.css";

const isDev = import.meta.env.DEV;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>CIR Assessment Maker</title>
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/jsxgraph/distrib/jsxgraph.css" />
  </head>
  <body>
    <main class="app-shell">
      <header class="app-header">
        <div>
          <p class="eyebrow">Local STEM assessment loop</p>
          <h1>CIR Assessment Maker</h1>
        </div>
        <div class="api-status" id="api-status" role="status">Connecting</div>
      </header>

      <nav class="tabs" aria-label="Primary">
        <button class="tab active" data-tab="load">Load Assessment</button>
        <button class="tab" data-tab="curriculums">Category Curriculums</button>
        <button class="tab" data-tab="create">Create Quiz/Test</button>
        <button class="tab" data-tab="authoring">Authoring Workspace</button>
        <button class="tab" data-tab="settings">Settings</button>
        <button class="tab" data-tab="grades">Grade Log</button>
        <button class="tab" data-tab="sessions">Attempt Sessions</button>
        <button class="tab" data-tab="diagnostics">Diagnostics</button>
      </nav>

      <section class="view active" id="view-load" aria-labelledby="load-title">
        <!-- Progressive Assessment Navigator -->
        <section class="nav-explorer" id="nav-explorer" aria-label="Assessment Navigator">
          <div class="nav-header">
            <h2 id="load-title">Load Assessment</h2>
            <div class="attempt-chip" id="active-attempt-chip">No active attempt</div>
          </div>
          <p class="quiet-hint">Switch assessments whenever you need a different path.</p>

          <div class="nav-search" id="nav-search" role="search">
            <div class="search-input-wrapper">
               <input type="search" id="assessment-search-input" placeholder="Search topics, tags, or assessments..." autocomplete="off" aria-autocomplete="list" aria-controls="search-suggestions" />
               <div id="search-suggestions" class="search-suggestions" hidden role="listbox"></div>
            </div>
            <div id="search-filters" class="search-filters" hidden>
                <!-- populated by js -->
            </div>
          </div>

          <div id="search-results-container" class="search-results-container" hidden>
             <h3 class="nav-stage-label" id="search-results-label">Search Results</h3>
             <div id="search-results-list" class="nav-assessment-list" role="listbox" aria-label="Search results"></div>
          </div>

          <!-- Breadcrumb path -->
          <nav class="nav-breadcrumb" id="nav-breadcrumb" aria-label="Navigator path" hidden></nav>

          <!-- Compact Active Session -->
          <div id="nav-compact-active-session" class="compact-active-session" hidden></div>

          <!-- Step stages (each revealed after prior selection) -->
          <div class="nav-content-layout">
            <div class="nav-stages" id="nav-stages">
            <!-- Stage 0: Subject -->
            <div class="nav-stage active" id="nav-stage-subject" data-stage="subject">
              <h3 class="nav-stage-label">Subject</h3>
              <div class="nav-tile-grid" id="nav-subject-tiles" role="listbox" aria-label="Select subject"></div>
            </div>
            <!-- Stage 1: Area -->
            <div class="nav-stage" id="nav-stage-area" data-stage="area" hidden>
              <h3 class="nav-stage-label">Area</h3>
              <div class="nav-tile-grid" id="nav-area-tiles" role="listbox" aria-label="Select area"></div>
            </div>
            <!-- Stage 2: Topic -->
            <div class="nav-stage" id="nav-stage-topic" data-stage="topic" hidden>
              <h3 class="nav-stage-label">Topic</h3>
              <div class="nav-tile-grid" id="nav-topic-tiles" role="listbox" aria-label="Select topic"></div>
            </div>
            <!-- Stage 3: Learning Goal -->
            <div class="nav-stage" id="nav-stage-goal" data-stage="goal" hidden>
              <h3 class="nav-stage-label">Learning Goal</h3>
              <div class="nav-tile-grid" id="nav-goal-tiles" role="listbox" aria-label="Select learning goal"></div>
            </div>
            <!-- Stage 4: Activity Type -->
            <div class="nav-stage" id="nav-stage-activity" data-stage="activity" hidden>
              <h3 class="nav-stage-label">Activity Type</h3>
              <div class="nav-tile-grid" id="nav-activity-tiles" role="listbox" aria-label="Select activity type"></div>
            </div>
            <!-- Stage 5: Assessment list -->
            <div class="nav-stage" id="nav-stage-assessments" data-stage="assessments" hidden>
              <h3 class="nav-stage-label">Assessments</h3>
              <div id="nav-assessment-list" class="nav-assessment-list" role="listbox" aria-label="Select assessment"></div>
            </div>
            <!-- Recommended Path UI -->
            <aside class="nav-recommended-path" id="nav-recommended-path" hidden>
              <h3 class="nav-stage-label">Recommended Path</h3>
              <div class="recommended-path-list" id="recommended-path-list">
                <!-- Populated by JS -->
              </div>
            </aside>
          </div>

          <!-- Mode + Start -->
          <div class="nav-actions" id="nav-actions" hidden>
            <fieldset class="mode-control compact">
              <legend>Mode</legend>
              <div class="mode-segments">
                <label class="mode-segment">
                  <input type="radio" name="nav-mode" value="practice" checked />
                  <span>Practice</span>
                </label>
                <label class="mode-segment">
                  <input type="radio" name="nav-mode" value="scored" />
                  <span>Scored</span>
                </label>
              </div>
            </fieldset>
            <button class="primary action-button" id="nav-start-attempt">Start Selected</button>
            {isDev && <button class="action-button" id="nav-edit-metadata" style="margin-left: 0.5rem;">Edit Metadata (Dev)</button>}
          </div>

          <!-- Error fallback message -->
          <p class="nav-error" id="nav-error" hidden></p>
        </section>

        <!-- Classic picker (fallback / legacy) -->
        <details class="classic-picker" id="classic-picker">
          <summary>Classic assessment picker</summary>
          <section class="switcher" aria-labelledby="classic-picker-label">
            <div class="switcher-controls">
              <div class="field compact">
                <label for="category-select">Category</label>
                <select id="category-select"></select>
              </div>
              <div class="field compact wide">
                <label for="assessment-select">Assessment</label>
                <select id="assessment-select"></select>
              </div>
              <fieldset class="mode-control compact">
                <legend>Mode</legend>
                <div class="mode-segments">
                  <label class="mode-segment">
                    <input type="radio" name="mode" value="practice" checked />
                    <span>Practice</span>
                  </label>
                  <label class="mode-segment">
                    <input type="radio" name="mode" value="scored" />
                    <span>Scored</span>
                  </label>
                </div>
              </fieldset>
              <button class="primary action-button" id="start-attempt">Start Selected</button>
            </div>
          </section>
        </details>

        <section class="workspace" id="attempt-panel" aria-live="polite">
          <div id="attempt-content" class="empty-state">Choose an assessment to begin.</div>
        </section>
      </section>

      <section class="view" id="view-authoring" aria-labelledby="authoring-title">
        <section class="panel authoring-workspace">
          <h2 id="authoring-title">Source-to-Curriculum Workspace</h2>
          <p class="quiet-hint">Private sources stay in the local source library. Export source-cited packets for an agent, then import drafts for review before publishing any content.</p>
          <form id="authoring-import-form" class="authoring-import-grid">
            <div class="field wide"><label for="authoring-source-path">Local source path</label><input id="authoring-source-path" name="localPath" required placeholder="C:\\Course Materials\\chapter.pdf" /></div>
            <div class="field"><label for="authoring-source-title">Title</label><input id="authoring-source-title" name="title" placeholder="Optional display title" /></div>
            <div class="field"><label for="authoring-license-note">Reuse note</label><input id="authoring-license-note" name="licenseNote" placeholder="CC BY 4.0, personal reference, etc." /></div>
            <div class="button-row"><button class="primary" type="submit">Import source</button><button type="button" id="authoring-refresh">Refresh workspace</button></div>
          </form>
          <p id="authoring-status" class="form-status" aria-live="polite"></p>
          <div class="authoring-summary" id="authoring-summary"></div>
          <div class="authoring-columns">
            <section><h3>Private sources</h3><div id="authoring-sources" class="authoring-list empty-state">No private sources have been imported.</div></section>
            <section><h3>Review queue</h3><div id="authoring-drafts" class="authoring-list empty-state">No agent drafts are waiting for review.</div></section>
          </div>
          <section class="authoring-source-detail" id="authoring-source-detail" hidden aria-labelledby="authoring-source-detail-title">
            <div class="section-header">
              <div><h3 id="authoring-source-detail-title">Source chunks</h3><p id="authoring-source-detail-meta" class="muted"></p></div>
              <div class="button-row"><button type="button" id="authoring-select-visible">Select visible</button><button type="button" id="authoring-clear-chunks">Clear selection</button></div>
            </div>
            <div class="authoring-chunk-controls">
              <div class="field"><label for="authoring-chunk-search">Search this source</label><input id="authoring-chunk-search" type="search" placeholder="Search chunk text, locator, or ID" /></div>
              <p id="authoring-chunk-selection" class="muted" aria-live="polite">No chunks selected.</p>
            </div>
            <div id="authoring-outline" class="authoring-list empty-state">Build or open an outline to select a chapter.</div>
            <div id="authoring-chunk-list" class="authoring-chunk-list"></div>
          </section>
          <section class="authoring-packet-panel">
            <h3>Agent handoff</h3>
            <p class="muted">Select source chunks, then copy the packet into Codex or Gemini. Drafts must be imported and reviewed before their manifests can be approved.</p>
            <div class="authoring-import-grid">
              <div class="field"><label for="authoring-category">Category ID</label><input id="authoring-category" placeholder="physics-1" /></div>
              <div class="field"><label for="authoring-topic">Topic ID</label><input id="authoring-topic" placeholder="traveling-waves" /></div>
              <div class="field"><label for="authoring-target-tier">Target difficulty tier</label><select id="authoring-target-tier"><option value="unspecified">General content</option><option value="easy">Easy</option><option value="hard">Hard</option><option value="olympiad">Olympiad</option></select></div>
              <div class="field wide"><label for="authoring-objectives">Objective IDs (comma-separated)</label><input id="authoring-objectives" placeholder="wave-speed,interpret-wave-graph" /></div>
              <div class="field wide"><label for="authoring-chunks">Source chunk IDs (comma-separated)</label><input id="authoring-chunks" placeholder="src-...:chunk-0001" /></div>
            </div>
            <div class="button-row"><button id="authoring-export-packet" type="button">Create packet</button></div>
            <textarea id="authoring-packet-output" class="authoring-json" readonly placeholder="Generated packet appears here."></textarea>
            <div class="field"><label for="authoring-draft-input">Agent draft JSON</label><textarea id="authoring-draft-input" class="authoring-json" placeholder='{"contentManifests": [], "questionBlueprints": []}'></textarea></div>
            <div class="button-row"><button id="authoring-import-draft" type="button">Import draft for review</button></div>
          </section>
        </section>
      </section>

      <section class="view" id="view-curriculums" aria-labelledby="curriculums-title">
        <section class="panel">
          <h2 id="curriculums-title">Category Curriculums</h2>
          <p class="quiet-hint">Browse the intended path for each category and track your progress.</p>
          
          <div class="field compact" style="margin-top: 1rem; max-width: 300px;">
            <label for="curriculum-subject-select">Subject</label>
            <select id="curriculum-subject-select"></select>
          </div>

          <div id="curriculum-roadmap" class="curriculum-roadmap" style="margin-top: 2rem;">
            <!-- Rendered via JS -->
          </div>
        </section>
      </section>

      <section class="view" id="view-create" aria-labelledby="create-title">
        <section class="panel">
          <h2 id="create-title">Create Quiz/Test</h2>
          <p class="muted">Worked Examples are schema-only for now. Create them in YAML/JSON using the project documentation once that section is added.</p>
          <form id="create-form" class="authoring-grid">
            <div class="field">
              <label for="create-title-input">Title</label>
              <input id="create-title-input" name="title" required placeholder="Area Between Curves Practice" />
            </div>
            <div class="field">
              <label for="create-id-input">Stable ID</label>
              <input id="create-id-input" name="id" required placeholder="area-between-curves-practice" />
            </div>
            <div class="field">
              <label for="create-type">Type</label>
              <select id="create-type" name="assessmentType">
                <option value="quiz">Quiz</option>
                <option value="test">Test</option>
              </select>
            </div>
            <div class="field">
              <label for="create-category">Category</label>
              <select id="create-category" name="categoryId"></select>
            </div>
            <div class="field">
              <label for="create-subcategory">Subcategory</label>
              <select id="create-subcategory" name="subcategoryId"></select>
            </div>
            <div class="field">
              <label for="create-mode">Default mode</label>
              <select id="create-mode" name="modeDefault">
                <option value="practice">Practice</option>
                <option value="scored">Scored</option>
              </select>
            </div>
            <label class="checkbox-line">
              <input id="create-randomize" name="randomizeQuestions" type="checkbox" checked />
              Randomize question order
            </label>

            <section class="author-section">
              <div class="section-header">
                <h3>Questions</h3>
                <button type="button" id="add-question">Add Question</button>
              </div>
              <div id="question-editor-list" class="question-editor-list"></div>
            </section>

            <section class="author-section">
              <div class="section-header">
                <h3>Preview</h3>
                <button type="button" id="refresh-preview">Refresh Preview</button>
              </div>
              <pre id="assessment-preview" class="preview-panel"></pre>
            </section>

            <div class="button-row">
              <button class="primary chunky" type="submit">Save Assessment</button>
              <button type="button" id="validate-draft">Validate Draft</button>
            </div>
          </form>
          <p id="create-status" class="muted" role="status"></p>
        </section>
      </section>

      <section class="view" id="view-settings" aria-labelledby="settings-title">
        <section class="panel">
          <h2 id="settings-title">Settings</h2>
          <form id="settings-form" class="settings-grid">
            <div class="field">
              <label for="default-mode">Default mode</label>
              <select id="default-mode" name="defaultMode">
                <option value="practice">Practice</option>
                <option value="scored">Scored</option>
              </select>
            </div>
            <div class="field">
              <label for="default-question-order">Question order</label>
              <select id="default-question-order" name="defaultQuestionOrder">
                <option value="randomized">Randomized</option>
                <option value="static">Static</option>
              </select>
            </div>
            <div class="field">
              <label for="default-quiz-length">Default quiz length</label>
              <input id="default-quiz-length" name="defaultQuizLength" type="number" min="1" max="50" />
            </div>
            <div class="field">
              <label for="default-test-length">Default test length</label>
              <input id="default-test-length" name="defaultTestLength" type="number" min="1" max="200" />
            </div>
            <div class="field">
              <label for="question-timer">Question timer seconds</label>
              <input id="question-timer" name="questionTimerSeconds" type="number" min="0" placeholder="None" />
            </div>
            <div class="field">
              <label for="assessment-timer">Assessment timer seconds</label>
              <input id="assessment-timer" name="assessmentTimerSeconds" type="number" min="0" placeholder="None" />
            </div>
            <div class="field">
              <label for="code-runner-base-url">Code runner URL</label>
              <input id="code-runner-base-url" name="codeRunnerBaseUrl" placeholder="http://localhost:2000/api/v2" />
            </div>
            <div class="field">
              <label for="code-runner-compile-timeout">Compile timeout ms</label>
              <input id="code-runner-compile-timeout" name="codeRunnerCompileTimeoutMs" type="number" min="1" />
            </div>
            <div class="field">
              <label for="code-runner-run-timeout">Run timeout ms</label>
              <input id="code-runner-run-timeout" name="codeRunnerRunTimeoutMs" type="number" min="1" />
            </div>
            <label class="checkbox-line">
              <input id="commit-scored" name="commitScoredAttemptsAutomatically" type="checkbox" />
              Commit scored attempts automatically
            </label>
            <button class="primary" type="submit">Save Settings</button>
          </form>
          <p id="settings-status" class="muted" role="status"></p>
        </section>
      </section>

      <section class="view" id="view-grades" aria-labelledby="grades-title">
        <section class="panel">
          <div class="section-header">
            <h2 id="grades-title">Grade Log</h2>
            <button id="refresh-grades">Refresh</button>
          </div>
          <div id="grade-summary" class="empty-state">No grade entries loaded yet.</div>
        </section>
      </section>

      <section class="view" id="view-sessions" aria-labelledby="sessions-title">
        <section class="panel">
          <div class="section-header">
            <h2 id="sessions-title">Attempt Sessions</h2>
            <button id="refresh-sessions">Refresh</button>
          </div>
          <div id="attempt-history" class="empty-state">No attempts loaded yet.</div>
        </section>
      </section>

      <section class="view" id="view-diagnostics" aria-labelledby="diagnostics-title">
        <section class="panel">
          <div class="section-header">
            <h2 id="diagnostics-title">Catalog Diagnostics</h2>
            <button id="refresh-diagnostics">Refresh</button>
          </div>
          <p class="quiet-hint">View import errors for assessments that failed to load into the catalog.</p>
          <div id="diagnostics-run-info" style="margin-bottom: 1rem; font-size: 0.9em; color: var(--text-muted);"></div>
          <div class="table-container">
            <table class="data-table" id="diagnostics-table" hidden>
              <thead>
                <tr>
                  <th>Severity</th>
                  <th>Code</th>
                  <th>Path</th>
                  <th>Message</th>
                </tr>
              </thead>
              <tbody id="diagnostics-tbody"></tbody>
            </table>
          </div>
          <div id="diagnostics-empty" class="empty-state">No diagnostics available.</div>
        </section>
        {isDev && (
          <section class="panel assessment-reports-panel" aria-labelledby="assessment-reports-title">
            <div class="section-header">
              <div>
                <h2 id="assessment-reports-title">Assessment Reports</h2>
                <p class="quiet-hint">Aggregate bugs, improvements, and comments submitted during assessment sessions.</p>
              </div>
              <div class="button-row">
                <button type="button" id="copy-assessment-reports-markdown">Copy Markdown</button>
                <button type="button" id="refresh-assessment-reports">Refresh</button>
              </div>
            </div>
            <div class="assessment-report-filters" aria-label="Assessment report filters">
              <div class="field compact">
                <label for="assessment-report-status-filter">Status</label>
                <select id="assessment-report-status-filter">
                  <option value="open" selected>Open</option>
                  <option value="">All</option>
                  <option value="resolved">Resolved</option>
                </select>
              </div>
              <div class="field compact">
                <label for="assessment-report-kind-filter">Kind</label>
                <select id="assessment-report-kind-filter">
                  <option value="">All</option>
                  <option value="bug">Bug</option>
                  <option value="improvement">Improvement</option>
                  <option value="comment">Comment</option>
                </select>
              </div>
              <div class="field compact">
                <label for="assessment-report-assessment-filter">Assessment</label>
                <select id="assessment-report-assessment-filter">
                  <option value="">All assessments</option>
                </select>
              </div>
            </div>
            <p id="assessment-reports-status" class="quiet-hint" role="status"></p>
            <div id="assessment-report-summary" class="assessment-report-summary"></div>
            <div class="table-container">
              <table class="data-table" id="assessment-reports-table" hidden>
                <thead>
                  <tr>
                    <th>Status</th>
                    <th>Kind</th>
                    <th>Assessment</th>
                    <th>Context</th>
                    <th>Comment</th>
                    <th>Attempt</th>
                    <th>Created</th>
                    <th>Action</th>
                  </tr>
                </thead>
                <tbody id="assessment-reports-tbody"></tbody>
              </table>
            </div>
            <div id="assessment-reports-empty" class="empty-state">No assessment reports match these filters.</div>
          </section>
        )}
      </section>

      {isDev && (
        <section class="view" id="view-metadata-editor" aria-labelledby="metadata-editor-title" hidden>
           <div class="section-header">
             <h2 id="metadata-editor-title">Edit Assessment Metadata</h2>
             <div class="button-row">
                <button type="button" id="metadata-editor-cancel">Cancel</button>
                <button type="button" id="metadata-editor-save" class="primary action-button">Save Changes</button>
             </div>
           </div>
           <p id="metadata-editor-status" role="status" class="quiet-hint"></p>
           
           <div class="field">
             <label for="metadata-editor-skills">Assessment Skills (comma separated)</label>
             <input type="text" id="metadata-editor-skills" class="input" placeholder="e.g. algebra, limits" />
           </div>

           <div class="field">
             <label for="metadata-editor-tags">Assessment Tags (comma separated)</label>
             <input type="text" id="metadata-editor-tags" class="input" placeholder="e.g. review, midterm" />
           </div>

           <div id="metadata-editor-questions" style="margin-top: 2rem;"></div>
        </section>
      )}
    </main>

    {isDev && (
      <dialog id="assessment-report-dialog" class="assessment-report-dialog" aria-labelledby="assessment-report-dialog-title">
        <form id="assessment-report-form" method="dialog">
          <div class="section-header">
            <div>
              <p class="eyebrow">Developer report</p>
              <h2 id="assessment-report-dialog-title">Report this assessment</h2>
            </div>
            <button type="button" id="close-assessment-report-dialog" aria-label="Close assessment report dialog">Close</button>
          </div>
          <p id="assessment-report-context-preview" class="assessment-report-context-preview"></p>
          <div class="field">
            <label for="assessment-report-kind">Kind</label>
            <select id="assessment-report-kind" required>
              <option value="bug">Bug</option>
              <option value="improvement">Improvement</option>
              <option value="comment">Comment</option>
            </select>
          </div>
          <div class="field">
            <label for="assessment-report-comment">Short ticket or comment</label>
            <textarea id="assessment-report-comment" rows="6" maxlength="1000" required placeholder="Describe the problem or improvement clearly."></textarea>
            <div class="assessment-report-character-row">
              <span>Plain text, 1–1000 characters.</span>
              <span id="assessment-report-character-count">0 / 1000</span>
            </div>
          </div>
          <p id="assessment-report-form-status" class="quiet-hint" role="status"></p>
          <div class="button-row">
            <button type="submit" class="primary" id="submit-assessment-report">Save Report</button>
            <button type="button" id="cancel-assessment-report">Cancel</button>
          </div>
        </form>
      </dialog>
    )}

    <script>
      import { renderMarkdown } from "../scripts/markdownRenderer";
      import { EditorView, basicSetup } from "codemirror";
      import { createCodeEditor } from "../scripts/codeEditor";
      import { keymap } from "@codemirror/view";
      import { indentWithTab } from "@codemirror/commands";
      import { python } from "@codemirror/lang-python";
      import { cpp } from "@codemirror/lang-cpp";
      import { ComputeEngine } from "@cortex-js/compute-engine";
      import "mathlive";
      import { CircuitCanvas } from "../scripts/CircuitCanvas";
      import type { CircuitDiagram, CircuitComponent, CircuitNode, CircuitWire } from "../scripts/CircuitCanvas";
      import { GraphingCanvas } from "../scripts/GraphingCanvas";
      import type { SubmittedGraphAnswer, GraphPoint } from "../scripts/GraphingCanvas";
      import { SandboxTerminal } from "../scripts/sandboxTerminal";
      import { renderScoresOverTimeChart, renderCategoryMasteryChart, renderTopIssueSignalsChart, renderQuestionTypeChart } from "../scripts/analyticsCharts";

      type AssessmentMode = "practice" | "scored";
      type AssessmentType = "quiz" | "test" | "workedExample" | "guidedProject" | "recallDrill" | "glossary" | "conceptLesson" | "interactiveExploration" | "directedProject" | "sandbox";
