      function setupGradeLogInteractions() {
        gradeSummary.querySelectorAll<HTMLButtonElement>("[data-delete-grade]").forEach((button) => {
          button.addEventListener("click", () => deleteGrade(button.dataset.deleteGrade ?? ""));
        });
        
        gradeSummary.querySelectorAll<HTMLButtonElement>(".analytics-category-btn").forEach((button) => {
          button.addEventListener("click", () => {
            const categoryId = button.dataset.categoryId;
            state.activeAnalyticsCategory = categoryId ? categoryId : null;
            if (state.analytics) {
              updateAnalyticsDashboard();
              setupGradeLogInteractions();
            }
          });
        });

        attemptHistory.querySelectorAll<HTMLButtonElement>("[data-attempt-action]").forEach((button) => {
          button.addEventListener("click", () => handleAttemptAction(button.dataset.attemptAction ?? "", button.dataset.attemptId ?? ""));
        });
        attemptHistory.querySelectorAll<HTMLSelectElement>("[data-history-filter]").forEach((select) => {
          select.addEventListener("change", () => {
            const key = select.dataset.historyFilter as keyof typeof state.historyFilters;
            state.historyFilters[key] = select.value;
            state.selectedAttemptIds.clear();
            renderAttemptHistory();
            setupGradeLogInteractions();
          });
        });
        attemptHistory.querySelectorAll<HTMLButtonElement>("[data-sort-history]").forEach((button) => {
          button.addEventListener("click", () => {
            const key = button.dataset.sortHistory ?? "lastActivityAt";
            state.historySort = {
              key,
              direction: state.historySort.key === key && state.historySort.direction === "asc" ? "desc" : "asc"
            };
            renderAttemptHistory();
            setupGradeLogInteractions();
          });
        });
        attemptHistory.querySelectorAll<HTMLInputElement>("[data-select-attempt]").forEach((checkbox) => {
          checkbox.addEventListener("change", () => {
            const attemptId = checkbox.dataset.selectAttempt ?? "";
            if (checkbox.checked) {
              state.selectedAttemptIds.add(attemptId);
            } else {
              state.selectedAttemptIds.delete(attemptId);
            }
            renderAttemptHistory();
            setupGradeLogInteractions();
          });
        });
        attemptHistory.querySelector<HTMLInputElement>("[data-select-all-attempts]")?.addEventListener("change", (event) => {
          const checked = (event.target as HTMLInputElement).checked;
          const rows = state.analytics ? filteredHistoryRows(state.analytics.attempts) : [];
          rows.forEach((row) => {
            if (checked) {
              state.selectedAttemptIds.add(row.attemptId);
            } else {
              state.selectedAttemptIds.delete(row.attemptId);
            }
          });
          renderAttemptHistory();
          setupGradeLogInteractions();
        });
        attemptHistory.querySelector<HTMLButtonElement>("#bulk-delete-attempts")?.addEventListener("click", bulkDeleteSelectedAttempts);
      }

      function renderAttemptActions(attempt: AttemptResults | AttemptHistoryRow) {
        const id = escapeHtml(attempt.attemptId);
        const actions: string[] = [];

        if (attempt.status === "inProgress" || attempt.status === "paused") {
          actions.push(`<button type="button" data-attempt-action="continue" data-attempt-id="${id}">Continue</button>`);
        }

        if (attempt.status === "inProgress") {
          actions.push(`<button type="button" data-attempt-action="pause" data-attempt-id="${id}">Save and Quit</button>`);
        }

        if (attempt.status === "inProgress" || attempt.status === "paused") {
          actions.push(`<button type="button" data-attempt-action="abandon" data-attempt-id="${id}">Quit Early</button>`);
        }

        if (attempt.status === "completed") {
          actions.push(`<button type="button" data-attempt-action="review" data-attempt-id="${id}">Review</button>`);
        }

        if (attempt.status === "completed" && attempt.assessmentType !== "workedExample" && attempt.assessmentType !== "guidedProject" && !isAttemptCommitted(attempt.attemptId)) {
          actions.push(`<button type="button" data-attempt-action="commit" data-attempt-id="${id}">Commit</button>`);
        }

        actions.push(`<button type="button" data-attempt-action="delete" data-attempt-id="${id}">Delete</button>`);
        return actions.join(" ");
      }

      async function handleAttemptAction(action: string, attemptId: string) {
        if (!attemptId) return;

        if (action === "continue") {
          await resumeAttemptSession(attemptId);
        } else if (action === "review") {
          await reviewAttemptSession(attemptId);
        } else if (action === "pause") {
          const response = await api<{ attempt: Attempt; results: AttemptResults }>(`/attempts/${encodeURIComponent(attemptId)}/pause`, { method: "POST" });
          if (state.attempt?.id === attemptId) {
            state.attempt = response.attempt;
            state.latestResults = response.results;
            updateActiveAttemptChip("Paused");
          }
          await loadGrades();
        } else if (action === "abandon") {
          if (!confirm("Quit this attempt early? It will be kept for review but cannot be committed to the grade log.")) return;
          const response = await api<{ attempt: Attempt; results: AttemptResults }>(`/attempts/${encodeURIComponent(attemptId)}/abandon`, { method: "POST" });
          if (state.attempt?.id === attemptId) {
            state.attempt = response.attempt;
            state.latestResults = response.results;
            updateActiveAttemptChip("Abandoned");
          }
          await loadGrades();
        } else if (action === "commit") {
          await api("/grades/commit", {
            method: "POST",
            body: JSON.stringify({ attemptId })
          });
          await loadGrades();
        } else if (action === "delete") {
          await deleteAttempt(attemptId);
        }
      }

      function firstUnansweredIndex(results: AttemptResults, attempt: Attempt) {
        if (results.assessmentType === "glossary") {
          const sections = state.assessment?.glossary?.sections ?? [];
          const firstIncomplete = results.learningSections.find((section) => section.unlocked && !section.completed);
          if (firstIncomplete) {
            const index = sections.findIndex((section) => section.id === firstIncomplete.sectionId);
            return index < 0 ? 0 : index;
          }
          const firstUnrated = attempt.questionOrder.findIndex((itemId) =>
            results.recallItems.find((item) => item.itemId === itemId)?.rating === "unknown");
          return firstUnrated < 0 ? 0 : firstUnrated;
        }

        if (results.assessmentType === "conceptLesson" || results.assessmentType === "interactiveExploration") {
          const firstIncomplete = results.learningSections.find((section) => section.unlocked && !section.completed);
          const index = attempt.questionOrder.findIndex((sectionId) => sectionId === firstIncomplete?.sectionId);
          return index < 0 ? 0 : index;
        }

        const firstUnansweredQuestion = results.assessmentType === "workedExample"
          ? results.questions.find((question) => question.isCorrect !== true)
          : results.questions.find((question) => !question.submittedAnswer);
        if (!firstUnansweredQuestion) return 0;
        const index = attempt.questionOrder.findIndex((questionId) => questionId === firstUnansweredQuestion.questionId);
        return index < 0 ? 0 : index;
      }

      function answeredCount(attempt: AttemptResults) {
        return attempt.questions.filter((question) => question.submittedAnswer).length;
      }

      function statusLabel(status: AttemptStatus) {
        return {
          inProgress: "In progress",
          paused: "Paused",
          completed: "Complete"
        }[status] ?? "In progress";
      }

      function isAttemptCommitted(attemptId: string) {
        return state.committedAttemptIds.has(attemptId);
      }

      async function bulkDeleteSelectedAttempts() {
        const attemptIds = Array.from(state.selectedAttemptIds);
        if (attemptIds.length === 0) return;
        if (!confirm(`Delete ${attemptIds.length} selected attempt(s) and any linked grade entries? This cannot be undone.`)) return;

        await api("/attempts/bulk-delete", {
          method: "POST",
          body: JSON.stringify({ attemptIds })
        });

        if (state.attempt && state.selectedAttemptIds.has(state.attempt.id)) {
          state.attempt = null;
          state.assessment = null;
          state.latestResults = null;
          updateActiveAttemptChip();
          updateModeControlLock();
          attemptContent.innerHTML = `<div class="empty-state">Selected attempt deleted.</div>`;
        }

        state.selectedAttemptIds.clear();
        await loadGrades();
      }

      function filteredHistoryRows(rows: AttemptHistoryRow[]) {
        const filters = state.historyFilters;
        return rows.filter((row) => {
          if (filters.status && row.status !== filters.status) return false;
          if (filters.mode && row.mode !== filters.mode) return false;
          if (filters.assessmentType && row.assessmentType !== filters.assessmentType) return false;
          if (filters.categoryId && row.categoryId !== filters.categoryId) return false;
          if (filters.areaId && !row.areaIds.includes(filters.areaId)) return false;
          if (filters.questionType && !row.questionTypes.includes(filters.questionType as QuestionType)) return false;
          if (filters.committed === "yes" && !row.isCommitted) return false;
          if (filters.committed === "no" && row.isCommitted) return false;
          if (filters.score === "lt70" && row.percentScore >= 70) return false;
          if (filters.score === "70to89" && (row.percentScore < 70 || row.percentScore >= 90)) return false;
          if (filters.score === "gte90" && row.percentScore < 90) return false;
          return true;
        });
      }

      function sortHistoryRows(rows: AttemptHistoryRow[]) {
        const { key, direction } = state.historySort;
        return [...rows].sort((a, b) => {
          const left = historySortValue(a, key);
          const right = historySortValue(b, key);
          const comparison = typeof left === "number" && typeof right === "number"
            ? left - right
            : String(left).localeCompare(String(right));
          return direction === "asc" ? comparison : -comparison;
        });
      }

      function historySortValue(row: AttemptHistoryRow, key: string) {
        if (key === "lastActivityAt") return new Date(row.lastActivityAt ?? row.startedAt).getTime();
        if (key === "percentScore") return row.percentScore;
        return String((row as unknown as Record<string, unknown>)[key] ?? "");
      }

      function renderSortableHeader(key: string, label: string) {
        const active = state.historySort.key === key;
        const direction = active ? (state.historySort.direction === "asc" ? "up" : "down") : "";
        return `<th><button type="button" class="sort-button ${active ? "active" : ""}" data-sort-history="${escapeHtml(key)}">${escapeHtml(label)}${direction ? ` ${direction}` : ""}</button></th>`;
      }

      function renderHistorySelect(name: keyof typeof state.historyFilters, label: string, options: [string, string][]) {
        return `
          <label class="field compact">
            <span>${escapeHtml(label)}</span>
            <select data-history-filter="${escapeHtml(name)}">
              ${options.map(([value, text]) => `<option value="${escapeHtml(value)}" ${state.historyFilters[name] === value ? "selected" : ""}>${escapeHtml(text)}</option>`).join("")}
            </select>
          </label>
        `;
      }

      function uniqueOptions(options: [string, string][]) {
        const seen = new Set<string>();
        return options.filter(([value]) => {
          if (!value || seen.has(value)) return false;
          seen.add(value);
          return true;
        }).sort((left, right) => left[1].localeCompare(right[1]));
      }

      function modeLabel(mode: AssessmentMode) {
        return {
          practice: "Practice",
          scored: "Scored"
        }[mode] ?? mode;
      }

      function questionTypeLabel(type: QuestionType) {
        return {
          multipleChoice: "Multiple choice",
          selectAll: "Select all",
          freeResponse: "Free response",
          numericResponse: "Numeric response",
          code: "Code",
          symbolicResponse: "Symbolic response",
          circuit: "Circuit interaction",
        graphingResponse: "Graphing interaction"
        }[type] ?? type;
      }

      function formatDate(value: string | null | undefined) {
        return value ? new Date(value).toLocaleString() : "-";
      }

      function activateTab(tabName: string) {
        document.querySelectorAll(".tab").forEach((item) => item.classList.toggle("active", (item as HTMLButtonElement).dataset.tab === tabName));
        document.querySelectorAll(".view").forEach((item) => item.classList.remove("active"));
        document.querySelector(`#view-${tabName}`)?.classList.add("active");

        if (tabName === "curriculums") {
          renderCurriculumSubjects();
        }
        if (tabName === "diagnostics" && IS_DEV) {
          void loadAssessmentReports();
        }
        if (tabName === "authoring") void loadAuthoringWorkspace();
      }

      function authoringValues(id: string) {
        return (document.querySelector<HTMLInputElement>(id)?.value ?? "").split(",").map(value => value.trim()).filter(Boolean);
      }

      async function loadAuthoringWorkspace() {
        try {
          const [sources, drafts, coverage] = await Promise.all([
            api<any[]>("/authoring/sources"), api<any[]>("/authoring/drafts"), api<any[]>("/authoring/coverage")
          ]);
          authoringSources.classList.remove("empty-state");
          authoringSources.innerHTML = sources.length ? sources.map(source => `
            <article class="authoring-card"><div><strong>${escapeHtml(source.title)}</strong><span class="authoring-state" data-state="${escapeHtml(source.extractionStatus)}">${escapeHtml(source.format)} · ${escapeHtml(source.extractionStatus)}</span></div>
            <p>${escapeHtml(source.originalFileName)} · ${source.chunkCount} chunks</p><p class="muted">${escapeHtml(source.licenseNote)}</p>
            ${source.warnings?.length ? `<details><summary>Extraction warnings</summary><p>${escapeHtml(source.warnings.join(" "))}</p></details>` : ""}
            <div class="button-row"><button type="button" data-authoring-open-source="${escapeHtml(source.id)}">Browse chunks</button><button type="button" data-authoring-outline="${escapeHtml(source.id)}">Build/rebuild outline</button><button type="button" data-authoring-retry="${escapeHtml(source.id)}">Retry extraction</button></div></article>`).join("") : "No private sources have been imported.";
          authoringDrafts.classList.remove("empty-state");
          authoringDrafts.innerHTML = drafts.length ? drafts.map(draft => `
            <article class="authoring-card"><div><strong>${escapeHtml(draft.id)}</strong><span class="authoring-state" data-state="${escapeHtml(draft.reviewState)}">${escapeHtml(draft.reviewState)}</span></div>
            <p>Packet ${escapeHtml(draft.packetId)} · ${escapeHtml(formatDate(draft.importedAt))}</p>
            ${draft.diagnostics?.length ? `<p class="warning-text">${escapeHtml(draft.diagnostics.join(" "))}</p>` : ""}
            <button type="button" data-authoring-state="approved" data-authoring-draft="${escapeHtml(draft.id)}">Approve reviewed draft</button>
            <button type="button" data-authoring-state="quarantined" data-authoring-draft="${escapeHtml(draft.id)}">Quarantine</button></article>`).join("") : "No agent drafts are waiting for review.";
          authoringSummary.textContent = `${sources.length} private source${sources.length === 1 ? "" : "s"} · ${drafts.filter(draft => draft.reviewState === "needsReview").length} draft(s) need review · ${coverage.filter(row => !row.meetsContentRequirement || !row.meetsPracticeRequirement).length} curriculum coverage gap(s).`;
          document.querySelectorAll<HTMLButtonElement>("[data-authoring-retry]").forEach(button => button.addEventListener("click", () => void retryAuthoringSource(button.dataset.authoringRetry!)));
          document.querySelectorAll<HTMLButtonElement>("[data-authoring-open-source]").forEach(button => button.addEventListener("click", () => void openAuthoringSource(button.dataset.authoringOpenSource!)));
          document.querySelectorAll<HTMLButtonElement>("[data-authoring-outline]").forEach(button => button.addEventListener("click", () => void rebuildAuthoringOutline(button.dataset.authoringOutline!)));
          document.querySelectorAll<HTMLButtonElement>("[data-authoring-draft]").forEach(button => button.addEventListener("click", () => void setAuthoringDraftState(button.dataset.authoringDraft!, button.dataset.authoringState!)));
        } catch (error) { authoringStatus.textContent = readableError(error); }
      }

      async function importAuthoringSource() {
        const form = new FormData(authoringImportForm);
        const submit = authoringImportForm.querySelector<HTMLButtonElement>('button[type="submit"]');
        try {
          submit?.setAttribute("disabled", "disabled");
          authoringStatus.textContent = "Import queued. Copying, extracting, and indexing the source…";
          const job = await api<any>("/authoring/sources", { method: "POST", body: JSON.stringify({ localPath: String(form.get("localPath") ?? ""), title: String(form.get("title") ?? ""), licenseNote: String(form.get("licenseNote") ?? "") }) });
          await pollAuthoringImport(job.id); authoringImportForm.reset(); await loadAuthoringWorkspace();
        } catch (error) { authoringStatus.textContent = readableError(error); }
        finally { submit?.removeAttribute("disabled"); }
      }
      async function pollAuthoringImport(jobId: string) {
        while (true) {
          const job = await api<any>(`/authoring/import-jobs/${encodeURIComponent(jobId)}`);
          authoringStatus.textContent = job.state === "completed" ? `${job.stage}.` : `${job.stage}${job.progressPercent != null ? ` (${job.progressPercent}%)` : ""}…`;
          if (job.state === "completed") return;
          if (job.state === "failed") throw new Error(job.error || "Source import failed.");
          await new Promise(resolve => window.setTimeout(resolve, 1000));
        }
      }
      async function retryAuthoringSource(sourceId: string) { try { await api(`/authoring/sources/${encodeURIComponent(sourceId)}/retry`, { method: "POST" }); authoringStatus.textContent = "Extraction retried."; await loadAuthoringWorkspace(); } catch (error) { authoringStatus.textContent = readableError(error); } }
      async function openAuthoringSource(sourceId: string) {
        try {
          state.authoringSource = await api<any>(`/authoring/sources/${encodeURIComponent(sourceId)}`);
          state.authoringSelectedChunkIds.clear();
          state.authoringOutline = await api<any>(`/authoring/sources/${encodeURIComponent(sourceId)}/outline`).catch(() => null);
          authoringChunkSearch.value = "";
          authoringSourceDetail.hidden = false;
          syncAuthoringChunkSelection();
          renderAuthoringChunks();
          renderAuthoringOutline();
          authoringSourceDetail.scrollIntoView({ behavior: "smooth", block: "start" });
        } catch (error) { authoringStatus.textContent = readableError(error); }
      }
      async function rebuildAuthoringOutline(sourceId: string) { try { authoringStatus.textContent = "Building source outline…"; state.authoringOutline = await api<any>(`/authoring/sources/${encodeURIComponent(sourceId)}/outline/rebuild`, { method: "POST" }); authoringStatus.textContent = "Source outline built."; if (state.authoringSource?.manifest.id === sourceId) renderAuthoringOutline(); } catch (error) { authoringStatus.textContent = readableError(error); } }
      function renderAuthoringOutline() {
        const outline = state.authoringOutline;
        if (!outline) { authoringOutline.textContent = "No outline has been built for this source. Use Build/rebuild outline."; return; }
        const render = (node: any) => `<li><button type="button" data-authoring-outline-node="${escapeHtml(node.id)}">${escapeHtml(node.title)}</button> <span class="muted">pp. ${node.startPage || "?"}–${node.endPage || "?"} · ${node.chunkIds.length} chunks${node.warnings?.length ? " · review suggested" : ""}</span>${node.children?.length ? `<ul>${node.children.map(render).join("")}</ul>` : ""}</li>`;
        authoringOutline.classList.remove("empty-state"); authoringOutline.innerHTML = `<strong>Source outline</strong>${outline.warnings?.length ? `<p class="warning-text">${escapeHtml(outline.warnings.join(" "))}</p>` : ""}<ul>${outline.root.children.map(render).join("")}</ul>`;
        document.querySelectorAll<HTMLButtonElement>("[data-authoring-outline-node]").forEach(button => button.addEventListener("click", () => { const find = (node: any): any => node.id === button.dataset.authoringOutlineNode ? node : (node.children || []).map(find).find(Boolean); const node = find(outline.root); state.authoringSelectedChunkIds.clear(); node.chunkIds.forEach((id: string) => state.authoringSelectedChunkIds.add(id)); syncAuthoringChunkSelection(); renderAuthoringChunks(); }));
      }
      function visibleAuthoringChunks() {
        const source = state.authoringSource;
        if (!source) return [];
        const query = authoringChunkSearch.value.trim().toLowerCase();
        return (source.chunks as any[]).filter(chunk => !query || [chunk.id, chunk.locator, chunk.kind, chunk.text].some(value => String(value ?? "").toLowerCase().includes(query))).slice(0, 80);
      }
      function renderAuthoringChunks() {
        const source = state.authoringSource;
        if (!source) return;
        const visible = visibleAuthoringChunks();
        const totalMatches = (source.chunks as any[]).filter(chunk => {
          const query = authoringChunkSearch.value.trim().toLowerCase();
          return !query || [chunk.id, chunk.locator, chunk.kind, chunk.text].some(value => String(value ?? "").toLowerCase().includes(query));
        }).length;
        document.querySelector<HTMLElement>("#authoring-source-detail-title")!.textContent = source.manifest.title;
        document.querySelector<HTMLElement>("#authoring-source-detail-meta")!.textContent = `${source.manifest.id} · ${source.chunks.length} chunks · showing ${visible.length} of ${totalMatches} matching chunks`;
        authoringChunkList.innerHTML = visible.length ? visible.map(chunk => `
          <article class="authoring-chunk"><label class="authoring-chunk-check"><input type="checkbox" data-authoring-chunk-id="${escapeHtml(chunk.id)}" ${state.authoringSelectedChunkIds.has(chunk.id) ? "checked" : ""} /><span>Select</span></label>
            <div><strong>${escapeHtml(chunk.locator)} <span class="authoring-chunk-kind">${escapeHtml(chunk.kind)}</span></strong><code>${escapeHtml(chunk.id)}</code>
            <pre>${escapeHtml(String(chunk.text).slice(0, 1200))}${String(chunk.text).length > 1200 ? "…" : ""}</pre></div>
          </article>`).join("") : "<p class=\"empty-state\">No source chunks match that search.</p>";
        document.querySelectorAll<HTMLInputElement>("[data-authoring-chunk-id]").forEach(input => input.addEventListener("change", () => {
          const id = input.dataset.authoringChunkId!;
          input.checked ? state.authoringSelectedChunkIds.add(id) : state.authoringSelectedChunkIds.delete(id);
          syncAuthoringChunkSelection();
        }));
      }
      function syncAuthoringChunkSelection() {
        const selected = [...state.authoringSelectedChunkIds];
        document.querySelector<HTMLInputElement>("#authoring-chunks")!.value = selected.join(",");
        authoringChunkSelection.textContent = selected.length ? `${selected.length} chunk${selected.length === 1 ? "" : "s"} selected and ready for the packet.` : "No chunks selected.";
      }
      function selectVisibleAuthoringChunks() { visibleAuthoringChunks().forEach(chunk => state.authoringSelectedChunkIds.add(chunk.id)); syncAuthoringChunkSelection(); renderAuthoringChunks(); }
      function clearAuthoringChunkSelection() { state.authoringSelectedChunkIds.clear(); syncAuthoringChunkSelection(); renderAuthoringChunks(); }
      async function exportAuthoringPacket() {
        try {
          const packet = await api<any>("/authoring/packets", { method: "POST", body: JSON.stringify({ categoryId: (document.querySelector<HTMLInputElement>("#authoring-category")?.value ?? "").trim(), topicId: (document.querySelector<HTMLInputElement>("#authoring-topic")?.value ?? "").trim(), targetDifficultyTier: (document.querySelector<HTMLSelectElement>("#authoring-target-tier")?.value ?? "unspecified"), objectiveIds: authoringValues("#authoring-objectives"), chunkIds: authoringValues("#authoring-chunks") }) });
          document.querySelector<HTMLTextAreaElement>("#authoring-packet-output")!.value = JSON.stringify(packet, null, 2); authoringStatus.textContent = "Packet created. Copy it into your authoring agent.";
        } catch (error) { authoringStatus.textContent = readableError(error); }
      }
      async function importAuthoringDraft() {
        const packet = document.querySelector<HTMLTextAreaElement>("#authoring-packet-output")!.value; const payloadJson = document.querySelector<HTMLTextAreaElement>("#authoring-draft-input")!.value;
        try { const packetId = JSON.parse(packet).id; await api("/authoring/drafts", { method: "POST", body: JSON.stringify({ packetId, payloadJson }) }); authoringStatus.textContent = "Draft queued for review."; document.querySelector<HTMLTextAreaElement>("#authoring-draft-input")!.value = ""; await loadAuthoringWorkspace(); } catch (error) { authoringStatus.textContent = readableError(error); }
      }
      async function setAuthoringDraftState(draftId: string, state: string) { try { await api(`/authoring/drafts/${encodeURIComponent(draftId)}`, { method: "PATCH", body: JSON.stringify({ state }) }); authoringStatus.textContent = `Draft marked ${state}.`; await loadAuthoringWorkspace(); } catch (error) { authoringStatus.textContent = readableError(error); } }

      function renderCurriculumSubjects() {
        const catalog = state.navigationCatalog;
        if (!catalog) return;
        const select = document.getElementById("curriculum-subject-select") as HTMLSelectElement;
        const currentVal = select.value;
        select.innerHTML = catalog.subjects.map(s => `<option value="${escapeHtml(s.id)}">${escapeHtml(s.title)}</option>`).join("");
        
        if (currentVal && catalog.subjects.some(s => s.id === currentVal)) {
          select.value = currentVal;
        } else if (catalog.subjects.length > 0) {
          select.value = catalog.subjects[0].id;
        }

        select.onchange = () => renderCurriculumRoadmap(select.value);
        if (select.value) {
          renderCurriculumRoadmap(select.value);
        }
      }

      function renderCurriculumRoadmap(subjectId: string) {
        const catalog = state.navigationCatalog;
        const container = document.getElementById("curriculum-roadmap");
        if (!catalog || !container) return;

        const subjectAreas = catalog.areas
          .filter(a => a.subjectIds.includes(subjectId))
          .sort((a, b) => a.index - b.index);

        const subjectTopics = catalog.topics.filter(t => t.subjectId === subjectId);
        const subjectAssessments = catalog.assessments.filter(a => a.subjectId === subjectId);
        
        const completedIds = new Set(state.completedAssessmentIds);
        let foundNext = false;

        let html = "";
        for (const area of subjectAreas) {
          html += `
            <div class="roadmap-area">
              <h3>
                ${area.index > 0 ? `<div class="roadmap-area-number">${area.index}</div>` : ""}
                ${escapeHtml(area.title)}
              </h3>
          `;

          const areaTopics = subjectTopics
            .filter(t => subjectAssessments.some(a => a.topicId === t.id && a.areaId === area.id))
            .sort((a, b) => a.title.localeCompare(b.title));

          for (const topic of areaTopics) {
            const topicAssessments = subjectAssessments
              .filter(a => a.topicId === topic.id && a.areaId === area.id);

            if (topicAssessments.length === 0) continue;

            html += `
              <div class="roadmap-topic">
                <h4>${escapeHtml(topic.title)}</h4>
                <div class="roadmap-assessments">
            `;

            for (const assessment of topicAssessments) {
              const isCompleted = completedIds.has(assessment.id);
              let isNext = false;
              if (!isCompleted && !foundNext) {
                isNext = true;
                foundNext = true;
              }

              html += `
                <div class="roadmap-assessment-chip ${isCompleted ? "completed" : ""} ${isNext ? "next-up" : ""}">
                  ${isCompleted ? "✓" : (isNext ? "▶" : "○")} ${escapeHtml(assessment.title)}
                  ${isNext ? `<span class="next-up-badge">Up Next</span>` : ""}
                </div>
              `;
            }

            html += `
                </div>
              </div>
            `;
          }

          html += `</div>`;
        }

        if (!html) {
          html = `<p class="muted">No roadmap available for this subject.</p>`;
        }

        container.innerHTML = html;
      }

      function renderCategories() {
        categorySelect.innerHTML = state.categories
          .map((category) => `<option value="${escapeHtml(category.id)}">${escapeHtml(category.title)}</option>`)
          .join("");
      }

      function renderAssessmentOptions() {
        assessmentSelect.innerHTML = state.assessments
          .map((assessment) => `<option value="${escapeHtml(assessment.id)}">${escapeHtml(assessment.title)} - ${assessmentTypeLabel(assessment.assessmentType)} (${assessmentCountLabel(assessment)})</option>`)
          .join("");
      }

      function assessmentCountLabel(assessment: AssessmentSummary) {
        const authoredCount = assessment.authoredQuestionCount ?? assessment.questionCount;
        if (assessment.attemptQuestionCount && authoredCount > assessment.questionCount) {
          return `${assessment.questionCount} of ${authoredCount}`;
        }

        return String(assessment.questionCount);
      }

      function renderCreateCategories() {
        createCategory.innerHTML = state.categories
          .map((category) => `<option value="${escapeHtml(category.id)}">${escapeHtml(category.title)}</option>`)
          .join("");
        renderCreateSubcategories();
      }

      function renderCreateSubcategories() {
        const category = state.categories.find((candidate) => candidate.id === createCategory.value);
        createSubcategory.innerHTML = (category?.subcategories ?? [])
          .map((subcategory) => `<option value="${escapeHtml(subcategory.id)}">${escapeHtml(subcategory.title)}</option>`)
          .join("");
      }

      function addDraftQuestion(type: QuestionType = "multipleChoice") {
        const nextNumber = state.draftQuestions.length + 1;
        const id = `q${String(nextNumber).padStart(3, "0")}`;
        const question = createEmptyQuestion(id, type);
        state.draftQuestions = [...state.draftQuestions, question];
        renderQuestionEditors();
        renderAssessmentPreview();
      }

      function createEmptyQuestion(id: string, type: QuestionType): Question {
        if (type === "freeResponse") {
          return {
            id,
            type,
            prompt: "",
            choices: [],
            media: [],
            answer: { expected: "", gradingMode: "selfCheck", keyPoints: [] },
            explanation: ""
          };
        }

        if (type === "numericResponse") {
          return {
            id,
            type,
            prompt: "",
            choices: [],
            media: [],
            answer: { numericValue: 0, numericTolerance: 0 },
            explanation: ""
          };
        }

        if (type === "symbolicResponse") {
          return {
            id,
            type,
            prompt: "",
            choices: [],
            media: [],
            answer: {
              expectedLatex: "",
              equivalenceMode: "expression",
              variables: ["x"],
              tolerance: 0.000001
            },
            explanation: ""
          };
        }

        if (type === "circuit") {
          return {
            id,
            type,
            prompt: "",
            choices: [],
            media: [],
            circuitQuestion: {
              schemaVersion: 1,
              catalogVersion: 1,
              interactionMode: "build",
              paletteSymbolIds: ["resistor", "battery", "capacitor", "junction"],
              editableProperties: ["value", "label", "rotation"],
              diagram: { width: 600, height: 400, components: [], nodes: [], wires: [], annotations: [] }
            },
            answer: {
              circuitAnswer: {
                topology: { requiredComponents: [], connectionMode: "anyValidNetlist" },
                selectedTargetIds: [],
                meterPlacement: null,
                expectedValues: {}
              }
            },
            explanation: ""
          };
        }

        if (type === "graphingResponse") {
          return {
            id,
            type,
            prompt: "",
            choices: [],
            media: [],
            answer: {
              graphingAnswer: { features: [] }
            },
            explanation: ""
          };
        }

        if (type === "code") {
          return {
            id,
            type,
            prompt: "",
            choices: [],
            media: [],
            answer: { choiceId: null, choiceIds: [] },
            codeQuestion: {
              language: "python",
              functionName: "square",
              executionMode: "function",
              starterCode: "def square(n):\n    return n * n",
              tests: [{ input: "3", expected: "9" }]
            },
            explanation: ""
          };
        }

        const choices = [
          { id: "a", text: "", media: [] },
          { id: "b", text: "", media: [] },
          { id: "c", text: "", media: [] },
          { id: "d", text: "", media: [] }
        ];

        return {
          id,
          type,
          prompt: "",
          choices,
          media: [],
          answer: type === "multipleChoice" ? { choiceId: "a" } : { choiceIds: [] },
          explanation: ""
        };
      }

      function renderQuestionEditors() {
        questionEditorList.innerHTML = state.draftQuestions.map((question, index) => `
          <article class="question-editor" data-question-index="${index}">
            <div class="section-header">
              <h4>Question ${index + 1}</h4>
              <button type="button" data-remove-question="${index}">Remove</button>
            </div>
            <div class="settings-grid">
              <div class="field">
                <label for="question-id-${index}">Question ID</label>
                <input id="question-id-${index}" data-question-field="id" value="${escapeHtml(question.id)}" />
              </div>
              <div class="field">
                <label for="question-type-${index}">Type</label>
                <select id="question-type-${index}" data-question-field="type">
                  <option value="multipleChoice" ${question.type === "multipleChoice" ? "selected" : ""}>Multiple choice</option>
                  <option value="selectAll" ${question.type === "selectAll" ? "selected" : ""}>Select all</option>
                  <option value="freeResponse" ${question.type === "freeResponse" ? "selected" : ""}>Free response</option>
                  <option value="numericResponse" ${question.type === "numericResponse" ? "selected" : ""}>Numeric response</option>
                  <option value="symbolicResponse" ${question.type === "symbolicResponse" ? "selected" : ""}>Symbolic response</option>
                  <option value="code" ${question.type === "code" ? "selected" : ""}>Code</option>
                  <option value="circuit" ${question.type === "circuit" ? "selected" : ""}>Circuit</option>
                  <option value="graphingResponse" ${question.type === "graphingResponse" ? "selected" : ""}>Graphing</option>
                </select>
              </div>
            </div>
            <div class="field">
              <label for="question-prompt-${index}">Prompt</label>
              <textarea id="question-prompt-${index}" data-question-field="prompt" rows="3">${escapeHtml(question.prompt)}</textarea>
            </div>
            ${renderQuestionAnswerEditor(question, index)}
            <div class="field">
              <label for="question-explanation-${index}">Explanation</label>
              <textarea id="question-explanation-${index}" data-question-field="explanation" rows="2">${escapeHtml(question.explanation ?? "")}</textarea>
            </div>
          </article>
        `).join("");

        questionEditorList.querySelectorAll<HTMLButtonElement>("[data-remove-question]").forEach((button) => {
          button.addEventListener("click", () => {
            const index = Number(button.dataset.removeQuestion);
            state.draftQuestions = state.draftQuestions.filter((_, candidateIndex) => candidateIndex !== index);
            renderQuestionEditors();
            renderAssessmentPreview();
          });
        });

        questionEditorList.querySelectorAll<HTMLSelectElement>("[data-question-field='type']").forEach((select) => {
          select.addEventListener("change", () => {
            const editor = select.closest<HTMLElement>("[data-question-index]")!;
            const index = Number(editor.dataset.questionIndex);
            const existingId = state.draftQuestions[index].id;
            state.draftQuestions[index] = createEmptyQuestion(existingId, select.value as QuestionType);
            renderQuestionEditors();
            renderAssessmentPreview();
          });
        });
      }

