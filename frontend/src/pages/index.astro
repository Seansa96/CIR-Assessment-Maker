---
import "katex/dist/katex.min.css";
import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>CIR Assessment Maker</title>
  </head>
  <body>
    <main class="app-shell">
      <header class="app-header">
        <div>
          <p class="eyebrow">Local STEM assessment loop</p>
          <h1>CIR Assessment Maker</h1>
        </div>
        <div class="api-status" id="api-status" role="status">Connecting</div>
      </header>

      <nav class="tabs" aria-label="Primary">
        <button class="tab active" data-tab="load">Load Quiz/Test</button>
        <button class="tab" data-tab="create">Create Quiz/Test</button>
        <button class="tab" data-tab="settings">Settings</button>
        <button class="tab" data-tab="grades">Grade Log</button>
      </nav>

      <section class="view active" id="view-load" aria-labelledby="load-title">
        <section class="switcher" aria-labelledby="load-title">
          <div class="switcher-heading">
            <div>
              <h2 id="load-title">Load Quiz/Test</h2>
              <p class="quiet-hint">Switch assessments whenever you need a different path.</p>
            </div>
            <div class="attempt-chip" id="active-attempt-chip">No active attempt</div>
          </div>

          <div class="switcher-controls">
            <div class="field compact">
              <label for="category-select">Category</label>
              <select id="category-select"></select>
            </div>
            <div class="field compact wide">
              <label for="assessment-select">Assessment</label>
              <select id="assessment-select"></select>
            </div>
            <fieldset class="mode-control compact">
              <legend>Mode</legend>
              <div class="mode-segments">
                <label class="mode-segment">
                  <input type="radio" name="mode" value="practice" checked />
                  <span>Practice</span>
                </label>
                <label class="mode-segment">
                  <input type="radio" name="mode" value="scored" />
                  <span>Scored</span>
                </label>
              </div>
            </fieldset>
            <button class="primary action-button" id="start-attempt">Start Selected</button>
          </div>
        </section>

        <section class="workspace" id="attempt-panel" aria-live="polite">
          <div id="attempt-content" class="empty-state">Choose an assessment to begin.</div>
        </section>
      </section>

      <section class="view" id="view-create" aria-labelledby="create-title">
        <section class="panel">
          <h2 id="create-title">Create Quiz/Test</h2>
          <form id="create-form" class="authoring-grid">
            <div class="field">
              <label for="create-title-input">Title</label>
              <input id="create-title-input" name="title" required placeholder="Area Between Curves Practice" />
            </div>
            <div class="field">
              <label for="create-id-input">Stable ID</label>
              <input id="create-id-input" name="id" required placeholder="area-between-curves-practice" />
            </div>
            <div class="field">
              <label for="create-type">Type</label>
              <select id="create-type" name="assessmentType">
                <option value="quiz">Quiz</option>
                <option value="test">Test</option>
              </select>
            </div>
            <div class="field">
              <label for="create-category">Category</label>
              <select id="create-category" name="categoryId"></select>
            </div>
            <div class="field">
              <label for="create-subcategory">Subcategory</label>
              <select id="create-subcategory" name="subcategoryId"></select>
            </div>
            <div class="field">
              <label for="create-mode">Default mode</label>
              <select id="create-mode" name="modeDefault">
                <option value="practice">Practice</option>
                <option value="scored">Scored</option>
              </select>
            </div>
            <label class="checkbox-line">
              <input id="create-randomize" name="randomizeQuestions" type="checkbox" checked />
              Randomize question order
            </label>

            <section class="author-section">
              <div class="section-header">
                <h3>Questions</h3>
                <button type="button" id="add-question">Add Question</button>
              </div>
              <div id="question-editor-list" class="question-editor-list"></div>
            </section>

            <section class="author-section">
              <div class="section-header">
                <h3>Preview</h3>
                <button type="button" id="refresh-preview">Refresh Preview</button>
              </div>
              <pre id="assessment-preview" class="preview-panel"></pre>
            </section>

            <div class="button-row">
              <button class="primary chunky" type="submit">Save Assessment</button>
              <button type="button" id="validate-draft">Validate Draft</button>
            </div>
          </form>
          <p id="create-status" class="muted" role="status"></p>
        </section>
      </section>

      <section class="view" id="view-settings" aria-labelledby="settings-title">
        <section class="panel">
          <h2 id="settings-title">Settings</h2>
          <form id="settings-form" class="settings-grid">
            <div class="field">
              <label for="default-mode">Default mode</label>
              <select id="default-mode" name="defaultMode">
                <option value="practice">Practice</option>
                <option value="scored">Scored</option>
              </select>
            </div>
            <div class="field">
              <label for="default-question-order">Question order</label>
              <select id="default-question-order" name="defaultQuestionOrder">
                <option value="randomized">Randomized</option>
                <option value="static">Static</option>
              </select>
            </div>
            <div class="field">
              <label for="default-quiz-length">Default quiz length</label>
              <input id="default-quiz-length" name="defaultQuizLength" type="number" min="1" max="50" />
            </div>
            <div class="field">
              <label for="default-test-length">Default test length</label>
              <input id="default-test-length" name="defaultTestLength" type="number" min="1" max="200" />
            </div>
            <div class="field">
              <label for="question-timer">Question timer seconds</label>
              <input id="question-timer" name="questionTimerSeconds" type="number" min="0" placeholder="None" />
            </div>
            <div class="field">
              <label for="assessment-timer">Assessment timer seconds</label>
              <input id="assessment-timer" name="assessmentTimerSeconds" type="number" min="0" placeholder="None" />
            </div>
            <div class="field">
              <label for="code-runner-base-url">Code runner URL</label>
              <input id="code-runner-base-url" name="codeRunnerBaseUrl" placeholder="http://localhost:2000/api/v2" />
            </div>
            <div class="field">
              <label for="code-runner-compile-timeout">Compile timeout ms</label>
              <input id="code-runner-compile-timeout" name="codeRunnerCompileTimeoutMs" type="number" min="1" />
            </div>
            <div class="field">
              <label for="code-runner-run-timeout">Run timeout ms</label>
              <input id="code-runner-run-timeout" name="codeRunnerRunTimeoutMs" type="number" min="1" />
            </div>
            <label class="checkbox-line">
              <input id="commit-scored" name="commitScoredAttemptsAutomatically" type="checkbox" />
              Commit scored attempts automatically
            </label>
            <button class="primary" type="submit">Save Settings</button>
          </form>
          <p id="settings-status" class="muted" role="status"></p>
        </section>
      </section>

      <section class="view" id="view-grades" aria-labelledby="grades-title">
        <section class="panel">
          <div class="section-header">
            <h2 id="grades-title">Grade Log</h2>
            <button id="refresh-grades">Refresh</button>
          </div>
          <div id="grade-summary" class="empty-state">No grade entries loaded yet.</div>
          <section class="author-section">
            <h3>Attempt History</h3>
            <div id="attempt-history" class="empty-state">No attempts loaded yet.</div>
          </section>
        </section>
      </section>
    </main>

    <script>
      import { unified } from "unified";
      import remarkParse from "remark-parse";
      import remarkMath from "remark-math";
      import remarkRehype from "remark-rehype";
      import rehypeKatex from "rehype-katex";
      import rehypeStringify from "rehype-stringify";

      type AssessmentMode = "practice" | "scored";
      type QuestionType = "multipleChoice" | "selectAll" | "freeResponse" | "numericResponse" | "code";
      type AttemptStatus = "inProgress" | "paused" | "completed" | "abandoned";

      interface AppSettings {
        schemaVersion: number;
        defaultMode: AssessmentMode;
        defaultQuestionOrder: "randomized" | "static";
        defaultQuizLength: number;
        defaultTestLength: number;
        questionTimerSeconds: number | null;
        assessmentTimerSeconds: number | null;
        commitScoredAttemptsAutomatically: boolean;
        codeRunnerBaseUrl: string;
        codeRunnerCompileTimeoutMs: number;
        codeRunnerRunTimeoutMs: number;
      }

      interface Category {
        id: string;
        title: string;
        subcategories: SubCategory[];
      }

      interface SubCategory {
        id: string;
        title: string;
      }

      interface AssessmentSummary {
        id: string;
        title: string;
        assessmentType: "quiz" | "test";
        questionCount: number;
      }

      interface MediaAsset {
        type: "image";
        src: string;
        alt: string;
        caption?: string | null;
      }

      interface ChoiceOption {
        id: string;
        text: string;
        media?: MediaAsset[];
      }

      interface Question {
        id: string;
        type: QuestionType;
        prompt: string;
        choices: ChoiceOption[];
        media?: MediaAsset[];
        answer?: {
          choiceId?: string;
          choiceIds?: string[];
          expected?: string;
          gradingMode?: string;
          numericValue?: number | null;
          numericTolerance?: number | null;
          media?: MediaAsset[];
        };
        language?: "python" | "cpp";
        functionName?: string;
        starterCode?: string;
        tests?: CodeQuestionTest[];
        explanation?: string | null;
      }

      interface CodeQuestionTest {
        input: string;
        expected: string;
      }

      interface Assessment {
        id: string;
        title: string;
        questions: Question[];
      }

      interface Attempt {
        id: string;
        assessmentId: string;
        mode: AssessmentMode;
        status: AttemptStatus;
        questionOrder: string[];
      }

      interface SubmittedAnswer {
        questionId: string;
        choiceId: string | null;
        choiceIds: string[];
        freeResponseText: string | null;
        selfCheckCorrect: boolean | null;
        numericValue: number | null;
        codeText: string | null;
      }

      interface CodeFeedback {
        tests: CodeFeedbackTest[];
        compileOutput: string | null;
        runOutput: string | null;
        error: string | null;
      }

      interface CodeFeedbackTest {
        index: number;
        input: string;
        expected: string;
        actual: string | null;
        passed: boolean;
      }

      interface QuestionResult {
        questionId: string;
        prompt: string;
        type: QuestionType;
        media?: MediaAsset[];
        submittedAnswer: SubmittedAnswer | null;
        isCorrect: boolean | null;
        explanation: string | null;
        expectedAnswer: string | null;
        codeFeedback: CodeFeedback | null;
      }

      interface AttemptResults {
        attemptId: string;
        assessmentTitle: string;
        mode: AssessmentMode;
        correctCount: number;
        totalQuestions: number;
        percentScore: number;
        isComplete: boolean;
        questions: QuestionResult[];
      }

      interface AttemptSessionResponse {
        attempt: Attempt;
        assessment: Assessment;
        results: AttemptResults;
      }

      interface GradeLogEntry {
        attemptId: string;
        assessmentTitle: string;
        mode: AssessmentMode;
        correctCount: number;
        totalQuestions: number;
        percentScore: number;
        committedAt: string;
      }

      const API_BASE = import.meta.env.PUBLIC_API_BASE ?? "http://localhost:5000/api";
      const markdownProcessor = unified()
        .use(remarkParse)
        .use(remarkMath)
        .use(remarkRehype)
        .use(rehypeKatex)
        .use(rehypeStringify);

      const state: {
        settings: AppSettings | null;
        categories: Category[];
        assessments: AssessmentSummary[];
        assessment: Assessment | null;
        attempt: Attempt | null;
        currentIndex: number;
        latestResults: AttemptResults | null;
        committedAttemptIds: Set<string>;
        draftQuestions: Question[];
      } = {
        settings: null,
        categories: [],
        assessments: [],
        assessment: null,
        attempt: null,
        currentIndex: 0,
        latestResults: null,
        committedAttemptIds: new Set(),
        draftQuestions: []
      };

      const apiStatus = document.querySelector<HTMLDivElement>("#api-status")!;
      const categorySelect = document.querySelector<HTMLSelectElement>("#category-select")!;
      const assessmentSelect = document.querySelector<HTMLSelectElement>("#assessment-select")!;
      const attemptContent = document.querySelector<HTMLDivElement>("#attempt-content")!;
      const activeAttemptChip = document.querySelector<HTMLDivElement>("#active-attempt-chip")!;
      const createForm = document.querySelector<HTMLFormElement>("#create-form")!;
      const createCategory = document.querySelector<HTMLSelectElement>("#create-category")!;
      const createSubcategory = document.querySelector<HTMLSelectElement>("#create-subcategory")!;
      const createTitleInput = document.querySelector<HTMLInputElement>("#create-title-input")!;
      const createIdInput = document.querySelector<HTMLInputElement>("#create-id-input")!;
      const questionEditorList = document.querySelector<HTMLDivElement>("#question-editor-list")!;
      const assessmentPreview = document.querySelector<HTMLPreElement>("#assessment-preview")!;
      const createStatus = document.querySelector<HTMLParagraphElement>("#create-status")!;
      const settingsForm = document.querySelector<HTMLFormElement>("#settings-form")!;
      const settingsStatus = document.querySelector<HTMLParagraphElement>("#settings-status")!;
      const gradeSummary = document.querySelector<HTMLDivElement>("#grade-summary")!;
      const attemptHistory = document.querySelector<HTMLDivElement>("#attempt-history")!;

      document.querySelectorAll<HTMLButtonElement>(".tab").forEach((tab) => {
        tab.addEventListener("click", () => {
          activateTab(tab.dataset.tab ?? "load");
        });
      });

      categorySelect.addEventListener("change", () => loadAssessments(categorySelect.value));
      document.querySelector<HTMLButtonElement>("#start-attempt")!.addEventListener("click", startAttempt);
      document.querySelector<HTMLButtonElement>("#refresh-grades")!.addEventListener("click", loadGrades);
      settingsForm.addEventListener("submit", saveSettings);
      document.addEventListener("keydown", handleAnswerShortcut);
      createForm.addEventListener("submit", saveDraftAssessment);
      createCategory.addEventListener("change", () => {
        renderCreateSubcategories();
        renderAssessmentPreview();
      });
      createTitleInput.addEventListener("input", () => {
        if (!createIdInput.dataset.touched) {
          createIdInput.value = slugify(createTitleInput.value);
        }
        renderAssessmentPreview();
      });
      createIdInput.addEventListener("input", () => {
        createIdInput.dataset.touched = "true";
        renderAssessmentPreview();
      });
      createForm.addEventListener("input", (event) => {
        if ((event.target as HTMLElement).closest(".question-editor-list")) {
          syncDraftQuestionsFromDom();
        }
        renderAssessmentPreview();
      });
      document.querySelector<HTMLButtonElement>("#add-question")!.addEventListener("click", () => addDraftQuestion());
      document.querySelector<HTMLButtonElement>("#refresh-preview")!.addEventListener("click", renderAssessmentPreview);
      document.querySelector<HTMLButtonElement>("#validate-draft")!.addEventListener("click", validateDraftAssessment);

      await initialize();

      async function initialize() {
        try {
          state.settings = await api<AppSettings>("/settings");
          state.categories = await api<Category[]>("/categories");
          fillSettingsForm(state.settings);
          renderCategories();
          renderCreateCategories();
          addDraftQuestion();
          await loadAssessments(categorySelect.value);
          await loadGrades();
          setApiStatus("Connected", "ok");
        } catch (error) {
          setApiStatus("Backend offline", "error");
          attemptContent.textContent = readableError(error);
        }
      }

      async function loadAssessments(categoryId: string) {
        if (!categoryId) {
          state.assessments = [];
          renderAssessmentOptions();
          return;
        }

        state.assessments = await api<AssessmentSummary[]>(`/assessments?categoryId=${encodeURIComponent(categoryId)}`);
        renderAssessmentOptions();
      }

      async function startAttempt() {
        const assessmentId = assessmentSelect.value;
        if (!assessmentId) return;

        const startButton = document.querySelector<HTMLButtonElement>("#start-attempt")!;
        const mode = document.querySelector<HTMLInputElement>("input[name='mode']:checked")!.value as AssessmentMode;
        setBusy(startButton, "Loading");

        try {
          state.assessment = await api<Assessment>(`/assessments/${encodeURIComponent(assessmentId)}`);
          state.attempt = await api<Attempt>("/attempts", {
            method: "POST",
            body: JSON.stringify({ assessmentId, mode })
          });
          state.currentIndex = 0;
          state.latestResults = null;
          updateActiveAttemptChip();
          await renderCurrentQuestion();
        } finally {
          clearBusy(startButton, "Start Selected");
        }
      }

      async function submitCurrentAnswer() {
        if (!state.attempt || !state.assessment) return;
        const question = getCurrentQuestion();
        const payload = readAnswer(question);
        const submitButton = document.querySelector<HTMLButtonElement>("#submit-answer");

        if (submitButton) setBusy(submitButton, "Saving");

        try {
          state.attempt = await api<Attempt>(`/attempts/${state.attempt.id}/answers`, {
            method: "POST",
            body: JSON.stringify(payload)
          });

          if (state.attempt.mode === "practice") {
            state.latestResults = await api<AttemptResults>(`/attempts/${state.attempt.id}/results`);
          }

          await renderCurrentQuestion();
        } finally {
          if (submitButton) clearBusy(submitButton, "Submit Answer");
        }
      }

      async function resumeAttemptSession(attemptId: string) {
        const session = await api<AttemptSessionResponse>(`/attempts/${encodeURIComponent(attemptId)}/resume`, {
          method: "POST"
        });
        await loadSession(session, true);
      }

      async function reviewAttemptSession(attemptId: string) {
        const session = await api<AttemptSessionResponse>(`/attempts/${encodeURIComponent(attemptId)}/session`);
        await loadSession(session, false);
      }

      async function loadSession(session: AttemptSessionResponse, preferFirstUnanswered: boolean) {
        state.assessment = session.assessment;
        state.attempt = session.attempt;
        state.latestResults = session.results;
        state.currentIndex = preferFirstUnanswered ? firstUnansweredIndex(session.results, session.attempt) : 0;
        updateActiveAttemptChip(statusLabel(session.attempt.status));
        activateTab("load");

        if (session.attempt.status === "completed" || session.attempt.status === "abandoned") {
          await renderResults(isAttemptCommitted(session.attempt.id));
          return;
        }

        await renderCurrentQuestion();
      }

      async function pauseAttempt() {
        if (!state.attempt) return;
        const response = await api<{ attempt: Attempt; results: AttemptResults }>(`/attempts/${state.attempt.id}/pause`, {
          method: "POST"
        });
        state.attempt = response.attempt;
        state.latestResults = response.results;
        updateActiveAttemptChip("Paused");
        attemptContent.innerHTML = `
          <div class="empty-state">
            Progress saved. This attempt is paused and can be continued from Attempt Sessions.
          </div>
        `;
        await loadGrades();
      }

      async function abandonAttempt() {
        if (!state.attempt) return;
        if (!confirm("Quit this attempt early? It will be kept for review but cannot be committed to the grade log.")) return;

        const response = await api<{ attempt: Attempt; results: AttemptResults }>(`/attempts/${state.attempt.id}/abandon`, {
          method: "POST"
        });
        state.attempt = response.attempt;
        state.latestResults = response.results;
        updateActiveAttemptChip("Abandoned");
        await renderResults(false);
        await loadGrades();
      }

      async function deleteAttempt(attemptId: string) {
        if (!confirm("Delete this attempt and any linked grade entry? This cannot be undone.")) return;
        await api(`/attempts/${encodeURIComponent(attemptId)}`, { method: "DELETE" });
        if (state.attempt?.id === attemptId) {
          state.attempt = null;
          state.assessment = null;
          state.latestResults = null;
          updateActiveAttemptChip();
          attemptContent.innerHTML = `<div class="empty-state">Attempt deleted.</div>`;
        }
        await loadGrades();
      }

      async function deleteGrade(attemptId: string) {
        if (!confirm("Delete this grade entry and its linked attempt? This cannot be undone.")) return;
        await api(`/grades/${encodeURIComponent(attemptId)}`, { method: "DELETE" });
        if (state.attempt?.id === attemptId) {
          state.attempt = null;
          state.assessment = null;
          state.latestResults = null;
          updateActiveAttemptChip();
          attemptContent.innerHTML = `<div class="empty-state">Grade and linked attempt deleted.</div>`;
        }
        await loadGrades();
      }

      async function completeAttempt() {
        if (!state.attempt) return;
        const completeButton = document.querySelector<HTMLButtonElement>("#complete-attempt");

        if (completeButton) setBusy(completeButton, "Completing");

        try {
          const response = await api<{ results: AttemptResults; committedGrade: unknown | null }>(`/attempts/${state.attempt.id}/complete`, {
            method: "POST"
          });
          state.latestResults = response.results;
          updateActiveAttemptChip("Complete");
          await renderResults(response.committedGrade !== null);
          await loadGrades();
        } finally {
          if (completeButton) clearBusy(completeButton, "Complete");
        }
      }

      async function commitGrade() {
        if (!state.attempt) return;
        await api("/grades/commit", {
          method: "POST",
          body: JSON.stringify({ attemptId: state.attempt.id })
        });
        await loadGrades();
        if (state.latestResults) await renderResults(true);
      }

      async function saveSettings(event: Event) {
        event.preventDefault();
        const form = new FormData(settingsForm);
        const settings: AppSettings = {
          schemaVersion: state.settings?.schemaVersion ?? 1,
          defaultMode: String(form.get("defaultMode")) as AssessmentMode,
          defaultQuestionOrder: String(form.get("defaultQuestionOrder")) as "randomized" | "static",
          defaultQuizLength: Number(form.get("defaultQuizLength")),
          defaultTestLength: Number(form.get("defaultTestLength")),
          questionTimerSeconds: nullableNumber(form.get("questionTimerSeconds")),
          assessmentTimerSeconds: nullableNumber(form.get("assessmentTimerSeconds")),
          commitScoredAttemptsAutomatically: form.get("commitScoredAttemptsAutomatically") === "on",
          codeRunnerBaseUrl: String(form.get("codeRunnerBaseUrl") ?? "http://localhost:2000/api/v2").trim(),
          codeRunnerCompileTimeoutMs: Number(form.get("codeRunnerCompileTimeoutMs") ?? 10000),
          codeRunnerRunTimeoutMs: Number(form.get("codeRunnerRunTimeoutMs") ?? 3000)
        };

        state.settings = await api<AppSettings>("/settings", {
          method: "PUT",
          body: JSON.stringify(settings)
        });
        settingsStatus.textContent = "Settings saved.";
      }

      async function loadGrades() {
        const summary = await api<{ entryCount: number; averagePercentScore: number | null; entries: GradeLogEntry[] }>("/grades/summary");
        const attempts = await api<AttemptResults[]>("/attempts");
        state.committedAttemptIds = new Set(summary.entries.map((entry) => entry.attemptId));

        if (summary.entryCount === 0) {
          gradeSummary.innerHTML = `<div class="empty-state">No committed scores yet.</div>`;
        } else {
          gradeSummary.innerHTML = `
            <div class="metric-row">
              <div><span>${summary.entryCount}</span><small>Entries</small></div>
              <div><span>${summary.averagePercentScore ?? 0}%</span><small>Average</small></div>
            </div>
            <table>
              <thead><tr><th>Assessment</th><th>Mode</th><th>Score</th><th>Committed</th><th>Actions</th></tr></thead>
              <tbody>
                ${summary.entries.map((entry) => `
                  <tr>
                    <td>${escapeHtml(entry.assessmentTitle)}</td>
                    <td>${escapeHtml(entry.mode)}</td>
                    <td>${entry.correctCount}/${entry.totalQuestions} (${entry.percentScore}%)</td>
                    <td>${new Date(entry.committedAt).toLocaleString()}</td>
                    <td><button type="button" data-delete-grade="${escapeHtml(entry.attemptId)}">Delete Grade</button></td>
                  </tr>
                `).join("")}
              </tbody>
            </table>
          `;
        }

        if (attempts.length === 0) {
          attemptHistory.innerHTML = `<div class="empty-state">No attempts recorded yet.</div>`;
          return;
        }

        attemptHistory.innerHTML = `
          <table>
            <thead><tr><th>Assessment</th><th>Mode</th><th>Status</th><th>Progress</th><th>Score</th><th>Actions</th></tr></thead>
            <tbody>
              ${attempts.map((attempt) => `
                <tr>
                  <td>${escapeHtml(attempt.assessmentTitle)}</td>
                  <td>${escapeHtml(attempt.mode)}</td>
                  <td>${escapeHtml(statusLabel(attempt.status))}</td>
                  <td>${answeredCount(attempt)}/${attempt.totalQuestions}</td>
                  <td>${attempt.correctCount}/${attempt.totalQuestions} (${attempt.percentScore}%)</td>
                  <td class="table-actions">${renderAttemptActions(attempt)}</td>
                </tr>
              `).join("")}
            </tbody>
          </table>
        `;

        gradeSummary.querySelectorAll<HTMLButtonElement>("[data-delete-grade]").forEach((button) => {
          button.addEventListener("click", () => deleteGrade(button.dataset.deleteGrade ?? ""));
        });
        attemptHistory.querySelectorAll<HTMLButtonElement>("[data-attempt-action]").forEach((button) => {
          button.addEventListener("click", () => handleAttemptAction(button.dataset.attemptAction ?? "", button.dataset.attemptId ?? ""));
        });
      }

      function renderAttemptActions(attempt: AttemptResults) {
        const id = escapeHtml(attempt.attemptId);
        const actions: string[] = [];

        if (attempt.status === "inProgress" || attempt.status === "paused") {
          actions.push(`<button type="button" data-attempt-action="continue" data-attempt-id="${id}">Continue</button>`);
        }

        if (attempt.status === "inProgress") {
          actions.push(`<button type="button" data-attempt-action="pause" data-attempt-id="${id}">Save and Quit</button>`);
        }

        if (attempt.status === "inProgress" || attempt.status === "paused") {
          actions.push(`<button type="button" data-attempt-action="abandon" data-attempt-id="${id}">Quit Early</button>`);
        }

        if (attempt.status === "completed" || attempt.status === "abandoned") {
          actions.push(`<button type="button" data-attempt-action="review" data-attempt-id="${id}">Review</button>`);
        }

        if (attempt.status === "completed" && !isAttemptCommitted(attempt.attemptId)) {
          actions.push(`<button type="button" data-attempt-action="commit" data-attempt-id="${id}">Commit</button>`);
        }

        actions.push(`<button type="button" data-attempt-action="delete" data-attempt-id="${id}">Delete</button>`);
        return actions.join(" ");
      }

      async function handleAttemptAction(action: string, attemptId: string) {
        if (!attemptId) return;

        if (action === "continue") {
          await resumeAttemptSession(attemptId);
        } else if (action === "review") {
          await reviewAttemptSession(attemptId);
        } else if (action === "pause") {
          const response = await api<{ attempt: Attempt; results: AttemptResults }>(`/attempts/${encodeURIComponent(attemptId)}/pause`, { method: "POST" });
          if (state.attempt?.id === attemptId) {
            state.attempt = response.attempt;
            state.latestResults = response.results;
            updateActiveAttemptChip("Paused");
          }
          await loadGrades();
        } else if (action === "abandon") {
          if (!confirm("Quit this attempt early? It will be kept for review but cannot be committed to the grade log.")) return;
          const response = await api<{ attempt: Attempt; results: AttemptResults }>(`/attempts/${encodeURIComponent(attemptId)}/abandon`, { method: "POST" });
          if (state.attempt?.id === attemptId) {
            state.attempt = response.attempt;
            state.latestResults = response.results;
            updateActiveAttemptChip("Abandoned");
          }
          await loadGrades();
        } else if (action === "commit") {
          await api("/grades/commit", {
            method: "POST",
            body: JSON.stringify({ attemptId })
          });
          await loadGrades();
        } else if (action === "delete") {
          await deleteAttempt(attemptId);
        }
      }

      function firstUnansweredIndex(results: AttemptResults, attempt: Attempt) {
        const firstUnansweredQuestion = results.questions.find((question) => !question.submittedAnswer);
        if (!firstUnansweredQuestion) return 0;
        const index = attempt.questionOrder.findIndex((questionId) => questionId === firstUnansweredQuestion.questionId);
        return index < 0 ? 0 : index;
      }

      function answeredCount(attempt: AttemptResults) {
        return attempt.questions.filter((question) => question.submittedAnswer).length;
      }

      function statusLabel(status: AttemptStatus) {
        return {
          inProgress: "In progress",
          paused: "Paused",
          completed: "Complete",
          abandoned: "Abandoned"
        }[status] ?? "In progress";
      }

      function isAttemptCommitted(attemptId: string) {
        return state.committedAttemptIds.has(attemptId);
      }

      function activateTab(tabName: string) {
        document.querySelectorAll(".tab").forEach((item) => item.classList.toggle("active", (item as HTMLButtonElement).dataset.tab === tabName));
        document.querySelectorAll(".view").forEach((item) => item.classList.remove("active"));
        document.querySelector(`#view-${tabName}`)?.classList.add("active");
      }

      function renderCategories() {
        categorySelect.innerHTML = state.categories
          .map((category) => `<option value="${escapeHtml(category.id)}">${escapeHtml(category.title)}</option>`)
          .join("");
      }

      function renderAssessmentOptions() {
        assessmentSelect.innerHTML = state.assessments
          .map((assessment) => `<option value="${escapeHtml(assessment.id)}">${escapeHtml(assessment.title)} (${assessment.questionCount})</option>`)
          .join("");
      }

      function renderCreateCategories() {
        createCategory.innerHTML = state.categories
          .map((category) => `<option value="${escapeHtml(category.id)}">${escapeHtml(category.title)}</option>`)
          .join("");
        renderCreateSubcategories();
      }

      function renderCreateSubcategories() {
        const category = state.categories.find((candidate) => candidate.id === createCategory.value);
        createSubcategory.innerHTML = (category?.subcategories ?? [])
          .map((subcategory) => `<option value="${escapeHtml(subcategory.id)}">${escapeHtml(subcategory.title)}</option>`)
          .join("");
      }

      function addDraftQuestion(type: QuestionType = "multipleChoice") {
        const nextNumber = state.draftQuestions.length + 1;
        const id = `q${String(nextNumber).padStart(3, "0")}`;
        const question = createEmptyQuestion(id, type);
        state.draftQuestions = [...state.draftQuestions, question];
        renderQuestionEditors();
        renderAssessmentPreview();
      }

      function createEmptyQuestion(id: string, type: QuestionType): Question {
        if (type === "freeResponse") {
          return {
            id,
            type,
            prompt: "",
            choices: [],
            media: [],
            answer: { expected: "", gradingMode: "selfCheck" },
            explanation: ""
          };
        }

        if (type === "numericResponse") {
          return {
            id,
            type,
            prompt: "",
            choices: [],
            media: [],
            answer: { numericValue: 0, numericTolerance: 0 },
            explanation: ""
          };
        }

        if (type === "code") {
          return {
            id,
            type,
            prompt: "",
            choices: [],
            media: [],
            answer: { choiceId: null, choiceIds: [] },
            language: "python",
            functionName: "square",
            starterCode: "def square(n):\n    return n * n",
            tests: [{ input: "3", expected: "9" }],
            explanation: ""
          };
        }

        const choices = [
          { id: "a", text: "", media: [] },
          { id: "b", text: "", media: [] },
          { id: "c", text: "", media: [] },
          { id: "d", text: "", media: [] }
        ];

        return {
          id,
          type,
          prompt: "",
          choices,
          media: [],
          answer: type === "multipleChoice" ? { choiceId: "a" } : { choiceIds: [] },
          explanation: ""
        };
      }

      function renderQuestionEditors() {
        questionEditorList.innerHTML = state.draftQuestions.map((question, index) => `
          <article class="question-editor" data-question-index="${index}">
            <div class="section-header">
              <h4>Question ${index + 1}</h4>
              <button type="button" data-remove-question="${index}">Remove</button>
            </div>
            <div class="settings-grid">
              <div class="field">
                <label for="question-id-${index}">Question ID</label>
                <input id="question-id-${index}" data-question-field="id" value="${escapeHtml(question.id)}" />
              </div>
              <div class="field">
                <label for="question-type-${index}">Type</label>
                <select id="question-type-${index}" data-question-field="type">
                  <option value="multipleChoice" ${question.type === "multipleChoice" ? "selected" : ""}>Multiple choice</option>
                  <option value="selectAll" ${question.type === "selectAll" ? "selected" : ""}>Select all</option>
                  <option value="freeResponse" ${question.type === "freeResponse" ? "selected" : ""}>Free response</option>
                  <option value="numericResponse" ${question.type === "numericResponse" ? "selected" : ""}>Numeric response</option>
                  <option value="code" ${question.type === "code" ? "selected" : ""}>Code</option>
                </select>
              </div>
            </div>
            <div class="field">
              <label for="question-prompt-${index}">Prompt</label>
              <textarea id="question-prompt-${index}" data-question-field="prompt" rows="3">${escapeHtml(question.prompt)}</textarea>
            </div>
            ${renderQuestionAnswerEditor(question, index)}
            <div class="field">
              <label for="question-explanation-${index}">Explanation</label>
              <textarea id="question-explanation-${index}" data-question-field="explanation" rows="2">${escapeHtml(question.explanation ?? "")}</textarea>
            </div>
          </article>
        `).join("");

        questionEditorList.querySelectorAll<HTMLButtonElement>("[data-remove-question]").forEach((button) => {
          button.addEventListener("click", () => {
            const index = Number(button.dataset.removeQuestion);
            state.draftQuestions = state.draftQuestions.filter((_, candidateIndex) => candidateIndex !== index);
            renderQuestionEditors();
            renderAssessmentPreview();
          });
        });

        questionEditorList.querySelectorAll<HTMLSelectElement>("[data-question-field='type']").forEach((select) => {
          select.addEventListener("change", () => {
            const editor = select.closest<HTMLElement>("[data-question-index]")!;
            const index = Number(editor.dataset.questionIndex);
            const existingId = state.draftQuestions[index].id;
            state.draftQuestions[index] = createEmptyQuestion(existingId, select.value as QuestionType);
            renderQuestionEditors();
            renderAssessmentPreview();
          });
        });
      }

      function renderQuestionAnswerEditor(question: Question, index: number) {
        if (question.type === "freeResponse") {
          return `
            <div class="field">
              <label for="question-expected-${index}">Expected answer</label>
              <textarea id="question-expected-${index}" data-question-field="expected" rows="2">${escapeHtml(question.answer?.expected ?? "")}</textarea>
            </div>
          `;
        }

        if (question.type === "numericResponse") {
          return `
            <div class="settings-grid">
              <div class="field">
                <label for="question-numeric-value-${index}">Correct value</label>
                <input id="question-numeric-value-${index}" data-question-field="numericValue" type="number" step="any" value="${escapeHtml(String(question.answer?.numericValue ?? 0))}" />
              </div>
              <div class="field">
                <label for="question-numeric-tolerance-${index}">Tolerance</label>
                <input id="question-numeric-tolerance-${index}" data-question-field="numericTolerance" type="number" step="any" min="0" value="${escapeHtml(String(question.answer?.numericTolerance ?? 0))}" />
              </div>
            </div>
          `;
        }

        if (question.type === "code") {
          return `
            <div class="settings-grid">
              <div class="field">
                <label for="question-code-language-${index}">Language</label>
                <select id="question-code-language-${index}" data-question-field="language">
                  <option value="python" ${question.language === "python" ? "selected" : ""}>Python</option>
                  <option value="cpp" ${question.language === "cpp" ? "selected" : ""}>C++</option>
                </select>
              </div>
              <div class="field">
                <label for="question-code-function-${index}">Function name</label>
                <input id="question-code-function-${index}" data-question-field="functionName" value="${escapeHtml(question.functionName ?? "")}" />
              </div>
            </div>
            <div class="field">
              <label for="question-code-starter-${index}">Starter code</label>
              <textarea id="question-code-starter-${index}" data-question-field="starterCode" rows="6">${escapeHtml(question.starterCode ?? "")}</textarea>
            </div>
            <div class="field">
              <label for="question-code-tests-${index}">Tests JSON</label>
              <textarea id="question-code-tests-${index}" data-question-field="tests" rows="4">${escapeHtml(JSON.stringify(question.tests ?? [], null, 2))}</textarea>
            </div>
          `;
        }

        return `
          <div class="choice-editor-grid">
            ${question.choices.map((choice) => `
              <div class="field">
                <label>${choice.id.toUpperCase()} choice</label>
                <input data-choice-id="${escapeHtml(choice.id)}" value="${escapeHtml(choice.text)}" />
              </div>
            `).join("")}
          </div>
          <div class="field">
            <label for="question-answer-${index}">Correct answer ${question.type === "selectAll" ? "(comma separated IDs)" : ""}</label>
            <input id="question-answer-${index}" data-question-field="answer" value="${escapeHtml(question.type === "multipleChoice" ? question.answer?.choiceId ?? "a" : (question.answer?.choiceIds ?? []).join(", "))}" />
          </div>
        `;
      }

      function syncDraftQuestionsFromDom() {
        const editors = Array.from(questionEditorList.querySelectorAll<HTMLElement>("[data-question-index]"));
        state.draftQuestions = editors.map((editor) => {
          const type = editor.querySelector<HTMLSelectElement>("[data-question-field='type']")!.value as QuestionType;
          const choices = Array.from(editor.querySelectorAll<HTMLInputElement>("[data-choice-id]"))
            .map((input) => ({ id: input.dataset.choiceId ?? "", text: input.value }));
          const answerValue = editor.querySelector<HTMLInputElement>("[data-question-field='answer']")?.value ?? "";

          return {
            id: editor.querySelector<HTMLInputElement>("[data-question-field='id']")!.value.trim(),
            type,
            prompt: editor.querySelector<HTMLTextAreaElement>("[data-question-field='prompt']")!.value.trim(),
            choices: type === "freeResponse" || type === "numericResponse" || type === "code" ? [] : choices,
            answer: buildDraftAnswer(type, answerValue, editor),
            language: type === "code" ? editor.querySelector<HTMLSelectElement>("[data-question-field='language']")?.value as "python" | "cpp" : undefined,
            functionName: type === "code" ? editor.querySelector<HTMLInputElement>("[data-question-field='functionName']")?.value.trim() : undefined,
            starterCode: type === "code" ? editor.querySelector<HTMLTextAreaElement>("[data-question-field='starterCode']")?.value : undefined,
            tests: type === "code" ? parseCodeTests(editor.querySelector<HTMLTextAreaElement>("[data-question-field='tests']")?.value ?? "[]") : undefined,
            explanation: editor.querySelector<HTMLTextAreaElement>("[data-question-field='explanation']")!.value.trim()
          };
        });
      }

      function buildDraftAnswer(type: QuestionType, answerValue: string, editor: HTMLElement) {
        if (type === "freeResponse") {
          return {
            choiceId: null,
            choiceIds: [],
            expected: editor.querySelector<HTMLTextAreaElement>("[data-question-field='expected']")?.value.trim() ?? "",
            gradingMode: "selfCheck"
          };
        }

        if (type === "selectAll") {
          return {
            choiceId: null,
            choiceIds: answerValue.split(",").map((value) => value.trim()).filter(Boolean)
          };
        }

        if (type === "numericResponse") {
          return {
            choiceId: null,
            choiceIds: [],
            numericValue: nullableNumber(editor.querySelector<HTMLInputElement>("[data-question-field='numericValue']")?.value ?? ""),
            numericTolerance: nullableNumber(editor.querySelector<HTMLInputElement>("[data-question-field='numericTolerance']")?.value ?? "")
          };
        }

        if (type === "code") {
          return {
            choiceId: null,
            choiceIds: []
          };
        }

        return { choiceId: answerValue.trim(), choiceIds: [] };
      }

      function parseCodeTests(value: string): CodeQuestionTest[] {
        try {
          const parsed = JSON.parse(value);
          return Array.isArray(parsed)
            ? parsed.map((test) => ({ input: String(test.input ?? ""), expected: String(test.expected ?? "") }))
            : [];
        } catch {
          return [];
        }
      }

      function buildDraftAssessment() {
        syncDraftQuestionsFromDom();
        const form = new FormData(createForm);
        return {
          id: String(form.get("id") ?? "").trim(),
          title: String(form.get("title") ?? "").trim(),
          assessmentType: String(form.get("assessmentType") ?? "quiz"),
          categoryId: String(form.get("categoryId") ?? "").trim(),
          subcategoryIds: [String(form.get("subcategoryId") ?? "").trim()].filter(Boolean),
          modeDefault: String(form.get("modeDefault") ?? "practice"),
          randomizeQuestions: form.get("randomizeQuestions") === "on",
          questionTimerSeconds: null,
          assessmentTimerSeconds: null,
          questions: state.draftQuestions
        };
      }

      function validateDraftLocally(assessment: ReturnType<typeof buildDraftAssessment>) {
        const errors: string[] = [];
        if (!assessment.id) errors.push("Assessment ID is required.");
        if (!assessment.title) errors.push("Title is required.");
        if (!assessment.categoryId) errors.push("Category is required.");

        const questionIds = new Set<string>();
        assessment.questions.forEach((question, index) => {
          if (!question.id) errors.push(`Question ${index + 1} needs an ID.`);
          if (questionIds.has(question.id)) errors.push(`Question ID '${question.id}' is duplicated.`);
          questionIds.add(question.id);
          if (!question.prompt) errors.push(`Question ${index + 1} needs a prompt.`);
          if (question.type === "numericResponse" && (question.answer?.numericValue === null || question.answer?.numericValue === undefined)) {
            errors.push(`Question ${index + 1} needs a numeric answer value.`);
          }
          if (question.type === "numericResponse" && ((question.answer?.numericTolerance ?? -1) < 0)) {
            errors.push(`Question ${index + 1} needs a non-negative tolerance.`);
          }
          if (question.type === "code") {
            if (!question.language || !["python", "cpp"].includes(question.language)) errors.push(`Question ${index + 1} needs Python or C++.`);
            if (!question.functionName) errors.push(`Question ${index + 1} needs a function name.`);
            if (!question.starterCode) errors.push(`Question ${index + 1} needs starter code.`);
            if (!question.tests || question.tests.length === 0) errors.push(`Question ${index + 1} needs at least one code test.`);
          }
        });

        return errors;
      }

      function renderAssessmentPreview() {
        assessmentPreview.textContent = JSON.stringify(buildDraftAssessment(), null, 2);
      }

      function validateDraftAssessment() {
        const errors = validateDraftLocally(buildDraftAssessment());
        createStatus.textContent = errors.length === 0 ? "Draft looks ready to save." : errors.join(" ");
      }

      async function saveDraftAssessment(event: Event) {
        event.preventDefault();
        const assessment = buildDraftAssessment();
        const errors = validateDraftLocally(assessment);
        if (errors.length > 0) {
          createStatus.textContent = errors.join(" ");
          return;
        }

        await api("/assessments", {
          method: "POST",
          body: JSON.stringify(assessment)
        });
        createStatus.textContent = "Assessment saved. It is now available in Load Quiz/Test.";
        await loadAssessments(categorySelect.value);
      }

      async function renderCurrentQuestion() {
        if (!state.attempt || !state.assessment) return;
        if (state.attempt.status !== "inProgress") {
          attemptContent.innerHTML = `<div class="empty-state">This attempt is ${escapeHtml(statusLabel(state.attempt.status).toLowerCase())}. Continue it from Attempt Sessions to make changes.</div>`;
          return;
        }

        const question = getCurrentQuestion();
        const results = state.latestResults?.questions.find((result) => result.questionId === question.id);
        const progress = `${state.currentIndex + 1} of ${state.attempt.questionOrder.length}`;
        const promptHtml = await renderMarkdown(question.prompt);
        const feedbackExplanation = results?.explanation ? await renderMarkdown(results.explanation) : "";
        const feedback = results?.isCorrect === null || results?.isCorrect === undefined
          ? ""
          : `<div class="feedback ${results.isCorrect ? "correct" : "incorrect"}">
              ${results.isCorrect ? "Correct" : "Needs review"}
              ${renderCodeFeedback(results.codeFeedback)}
              ${feedbackExplanation ? `<details><summary>Explanation</summary><div class="markdown">${feedbackExplanation}</div></details>` : ""}
            </div>`;

        attemptContent.innerHTML = `
          <div class="question-shell">
            <div class="question-header">
              <span>${progress}</span>
              <strong>${escapeHtml(state.assessment.title)}</strong>
            </div>
            <div class="question-prompt markdown">${promptHtml}</div>
            ${renderMedia(question.media ?? [])}
          </div>
          <form id="answer-form" class="answer-form">
            ${await renderAnswerInput(question, results?.submittedAnswer ?? null)}
            <div class="button-row">
              <button class="primary chunky" id="submit-answer" type="submit">Submit Answer</button>
              <button type="button" id="previous-question" ${state.currentIndex === 0 ? "disabled" : ""}>Previous</button>
              <button type="button" id="next-question" ${state.currentIndex === state.attempt.questionOrder.length - 1 ? "disabled" : ""}>Next</button>
              <button class="chunky secondary-action" type="button" id="complete-attempt">Complete</button>
              <button type="button" id="pause-attempt">Save and Quit</button>
              <button type="button" id="abandon-attempt">Quit Early</button>
            </div>
          </form>
          ${feedback}
        `;

        document.querySelector<HTMLFormElement>("#answer-form")!.addEventListener("submit", (event) => {
          event.preventDefault();
          submitCurrentAnswer();
        });
        document.querySelector<HTMLButtonElement>("#previous-question")!.addEventListener("click", () => {
          state.currentIndex -= 1;
          void renderCurrentQuestion();
        });
        document.querySelector<HTMLButtonElement>("#next-question")!.addEventListener("click", () => {
          state.currentIndex += 1;
          void renderCurrentQuestion();
        });
        document.querySelector<HTMLButtonElement>("#complete-attempt")!.addEventListener("click", completeAttempt);
        document.querySelector<HTMLButtonElement>("#pause-attempt")!.addEventListener("click", pauseAttempt);
        document.querySelector<HTMLButtonElement>("#abandon-attempt")!.addEventListener("click", abandonAttempt);
        setupChoiceCards(question);
      }

      async function renderResults(alreadyCommitted: boolean) {
        if (!state.latestResults) return;
        const results = state.latestResults;
        const questionHtml = await Promise.all(results.questions.map(async (question) => {
          const promptHtml = await renderMarkdown(question.prompt);
          const expectedHtml = question.expectedAnswer ? await renderMarkdown(question.expectedAnswer) : "";
          const explanationHtml = question.explanation ? await renderMarkdown(question.explanation) : "";

          return `
            <article class="result-item ${question.isCorrect ? "correct" : "incorrect"}">
              <div class="markdown">${promptHtml}</div>
              ${renderMedia(question.media ?? [])}
              <p><strong>${question.isCorrect ? "Correct" : "Needs review"}</strong></p>
              ${renderCodeFeedback(question.codeFeedback)}
              ${expectedHtml ? `<div class="result-detail"><strong>Expected:</strong><div class="markdown">${expectedHtml}</div></div>` : ""}
              ${explanationHtml ? `<details open><summary>Explanation</summary><div class="markdown">${explanationHtml}</div></details>` : ""}
            </article>
          `;
        }));

        attemptContent.innerHTML = `
          <div class="results-header">
            <h2>${escapeHtml(results.assessmentTitle)}</h2>
            <div class="score-badge">${results.percentScore}%</div>
          </div>
          <p class="muted">${results.correctCount} correct out of ${results.totalQuestions} questions. Status: ${escapeHtml(statusLabel(results.status))}.</p>
          <div class="result-list">
            ${questionHtml.join("")}
          </div>
          ${alreadyCommitted ? `<p class="feedback correct">Score committed to grade log.</p>` : ""}
          ${!alreadyCommitted && results.status === "completed" ? `<button class="primary chunky" id="commit-grade">Commit Score</button>` : ""}
        `;

        document.querySelector<HTMLButtonElement>("#commit-grade")?.addEventListener("click", commitGrade);
      }

      async function renderAnswerInput(question: Question, submittedAnswer: SubmittedAnswer | null = null) {
        if (question.type === "multipleChoice") {
          const choices = await Promise.all(question.choices.map((choice, index) => renderChoiceCard(choice, index, "radio", submittedAnswer)));
          return `
            <div class="choice-card-list" role="radiogroup" aria-label="Answer choices">
              ${choices.join("")}
            </div>
          `;
        }

        if (question.type === "selectAll") {
          const choices = await Promise.all(question.choices.map((choice, index) => renderChoiceCard(choice, index, "checkbox", submittedAnswer)));
          return `
            <div class="choice-card-list" role="group" aria-label="Select all that apply">
              ${choices.join("")}
            </div>
          `;
        }

        if (question.type === "numericResponse") {
          return `
            <div class="field numeric-response-field">
              <label for="numeric-response">Numeric response</label>
              <input id="numeric-response" name="numericValue" type="number" step="any" inputmode="decimal" value="${escapeHtml(String(submittedAnswer?.numericValue ?? ""))}" />
            </div>
          `;
        }

        if (question.type === "code") {
          return `
            <div class="field code-response-field">
              <label for="code-response">${escapeHtml((question.language ?? "code").toUpperCase())} response</label>
              <textarea id="code-response" name="codeText" rows="10" spellcheck="false">${escapeHtml(submittedAnswer?.codeText ?? question.starterCode ?? "")}</textarea>
            </div>
          `;
        }

        return `
          <div class="field">
            <label for="free-response">Your response</label>
            <textarea id="free-response" name="freeResponseText" rows="5">${escapeHtml(submittedAnswer?.freeResponseText ?? "")}</textarea>
          </div>
          <label class="checkbox-line">
            <input type="checkbox" name="selfCheckCorrect" ${submittedAnswer?.selfCheckCorrect ? "checked" : ""} />
            My response matches the expected idea
          </label>
        `;
      }

      async function renderChoiceCard(choice: ChoiceOption, index: number, role: "radio" | "checkbox", submittedAnswer: SubmittedAnswer | null) {
        const isSelectAll = role === "checkbox";
        const shortcut = choiceShortcut(index);
        const choiceHtml = await renderMarkdown(choice.text);
        const selected = isSelectAll
          ? submittedAnswer?.choiceIds?.includes(choice.id) == true
          : submittedAnswer?.choiceId === choice.id;

        return `
          <button
            type="button"
            class="choice-card ${isSelectAll ? "select-card" : ""} ${selected ? "selected" : ""}"
            role="${role}"
            aria-checked="${selected}"
            data-choice-id="${escapeHtml(choice.id)}"
            data-shortcut="${shortcut}"
          >
            <span class="choice-key" aria-hidden="true">${shortcut}</span>
            <span class="choice-text markdown">${choiceHtml}${renderMedia(choice.media ?? [])}</span>
            ${isSelectAll ? `<span class="choice-check" aria-hidden="true">&#10003;</span>` : ""}
          </button>
        `;
      }

      function renderCodeFeedback(feedback: CodeFeedback | null | undefined) {
        if (!feedback) return "";

        const testRows = feedback.tests.map((test) => `
          <tr>
            <td>${test.index}</td>
            <td>${escapeHtml(test.input)}</td>
            <td>${escapeHtml(test.expected)}</td>
            <td>${escapeHtml(test.actual ?? "")}</td>
            <td>${test.passed ? "Pass" : "Fail"}</td>
          </tr>
        `).join("");

        return `
          <div class="code-feedback">
            <table>
              <thead><tr><th>#</th><th>Input</th><th>Expected</th><th>Actual</th><th>Result</th></tr></thead>
              <tbody>${testRows}</tbody>
            </table>
            ${feedback.compileOutput ? `<pre>${escapeHtml(feedback.compileOutput)}</pre>` : ""}
            ${feedback.runOutput && feedback.tests.some((test) => !test.passed) ? `<pre>${escapeHtml(feedback.runOutput)}</pre>` : ""}
            ${feedback.error ? `<pre>${escapeHtml(feedback.error)}</pre>` : ""}
          </div>
        `;
      }

      function readAnswer(question: Question) {
        const form = new FormData(document.querySelector<HTMLFormElement>("#answer-form")!);
        const selectedCards = Array.from(document.querySelectorAll<HTMLButtonElement>(".choice-card.selected"));

        return {
          questionId: question.id,
          choiceId: question.type === "multipleChoice" ? selectedCards[0]?.dataset.choiceId ?? null : null,
          choiceIds: question.type === "selectAll" ? selectedCards.map((card) => card.dataset.choiceId ?? "") : [],
          freeResponseText: form.get("freeResponseText"),
          selfCheckCorrect: form.get("selfCheckCorrect") === "on",
          numericValue: question.type === "numericResponse" ? nullableNumber(form.get("numericValue")) : null,
          codeText: question.type === "code" ? String(form.get("codeText") ?? "") : null
        };
      }

      function setupChoiceCards(question: Question) {
        if (question.type !== "multipleChoice" && question.type !== "selectAll") return;

        const form = document.querySelector<HTMLFormElement>("#answer-form")!;
        const cards = Array.from(form.querySelectorAll<HTMLButtonElement>(".choice-card"));

        cards.forEach((card) => {
          card.addEventListener("click", () => {
            if (question.type === "multipleChoice") {
              selectSingleChoice(cards, card);
              return;
            }

            toggleChoiceCard(card);
          });
        });
      }

      function handleAnswerShortcut(event: KeyboardEvent) {
        if (!state.attempt || !state.assessment) return;

        const target = event.target as HTMLElement;
        if (target.matches("input, textarea, select")) return;

        const question = getCurrentQuestion();
        if (question.type !== "multipleChoice" && question.type !== "selectAll") return;

        const key = event.key.toUpperCase();
        const card = document.querySelector<HTMLButtonElement>(`.choice-card[data-shortcut="${key}"]`);
        if (!card) return;

        event.preventDefault();
        card.click();
        card.focus();
      }

      function selectSingleChoice(cards: HTMLButtonElement[], selectedCard: HTMLButtonElement) {
        cards.forEach((card) => {
          const isSelected = card === selectedCard;
          card.classList.toggle("selected", isSelected);
          card.setAttribute("aria-checked", String(isSelected));
        });
      }

      function toggleChoiceCard(card: HTMLButtonElement) {
        const isSelected = !card.classList.contains("selected");
        card.classList.toggle("selected", isSelected);
        card.setAttribute("aria-checked", String(isSelected));
      }

      function choiceShortcut(index: number) {
        return String.fromCharCode(65 + index);
      }

      function getCurrentQuestion() {
        const questionId = state.attempt!.questionOrder[state.currentIndex];
        return state.assessment!.questions.find((question) => question.id === questionId)!;
      }

      function fillSettingsForm(settings: AppSettings) {
        settingsForm.defaultMode.value = settings.defaultMode;
        settingsForm.defaultQuestionOrder.value = settings.defaultQuestionOrder;
        settingsForm.defaultQuizLength.value = String(settings.defaultQuizLength);
        settingsForm.defaultTestLength.value = String(settings.defaultTestLength);
        settingsForm.questionTimerSeconds.value = settings.questionTimerSeconds?.toString() ?? "";
        settingsForm.assessmentTimerSeconds.value = settings.assessmentTimerSeconds?.toString() ?? "";
        settingsForm.codeRunnerBaseUrl.value = settings.codeRunnerBaseUrl ?? "http://localhost:2000/api/v2";
        settingsForm.codeRunnerCompileTimeoutMs.value = String(settings.codeRunnerCompileTimeoutMs ?? 10000);
        settingsForm.codeRunnerRunTimeoutMs.value = String(settings.codeRunnerRunTimeoutMs ?? 3000);
        settingsForm.commitScoredAttemptsAutomatically.checked = settings.commitScoredAttemptsAutomatically;
      }

      function updateActiveAttemptChip(status = "Active") {
        if (!state.assessment || !state.attempt) {
          activeAttemptChip.textContent = "No active attempt";
          activeAttemptChip.dataset.state = "empty";
          return;
        }

        activeAttemptChip.textContent = `${status}: ${state.assessment.title}`;
        activeAttemptChip.dataset.state = status === "Complete" ? "complete" : "active";
      }

      function setBusy(button: HTMLButtonElement, label: string) {
        button.disabled = true;
        button.dataset.originalLabel = button.textContent ?? "";
        button.textContent = label;
        button.classList.add("is-busy");
      }

      function clearBusy(button: HTMLButtonElement, fallback: string) {
        button.disabled = false;
        button.textContent = button.dataset.originalLabel || fallback;
        button.classList.remove("is-busy");
      }

      async function renderMarkdown(value: string | null | undefined) {
        const processed = await markdownProcessor.process(value ?? "");
        return String(processed);
      }

      function renderMedia(media: MediaAsset[]) {
        return media
          .filter((item) => item.type === "image" && item.src)
          .map((item) => `
            <figure class="media-block">
              <img src="${escapeHtml(item.src)}" alt="${escapeHtml(item.alt ?? "")}" loading="lazy" />
              ${item.caption ? `<figcaption>${escapeHtml(item.caption)}</figcaption>` : ""}
            </figure>
          `)
          .join("");
      }

      async function api<T>(path: string, init?: RequestInit): Promise<T> {
        const response = await fetch(`${API_BASE}${path}`, {
          headers: { "Content-Type": "application/json" },
          ...init
        });

        if (!response.ok) {
          throw new Error(await response.text());
        }

        if (response.status === 204) {
          return undefined as T;
        }

        const text = await response.text();
        return text ? JSON.parse(text) : undefined as T;
      }

      function nullableNumber(value: FormDataEntryValue | null) {
        const text = String(value ?? "").trim();
        return text === "" ? null : Number(text);
      }

      function setApiStatus(text: string, tone: "ok" | "error") {
        apiStatus.textContent = text;
        apiStatus.dataset.tone = tone;
      }

      function readableError(error: unknown) {
        return error instanceof Error ? error.message : "Something went wrong.";
      }

      function escapeHtml(value: string) {
        return value.replace(/[&<>"']/g, (character) => ({
          "&": "&amp;",
          "<": "&lt;",
          ">": "&gt;",
          "\"": "&quot;",
          "'": "&#039;"
        }[character]!));
      }
    </script>
  </body>
</html>
