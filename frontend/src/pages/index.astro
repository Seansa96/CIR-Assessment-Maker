      function addDraftQuestion(type: QuestionType = "multipleChoice") {
        const nextNumber = state.draftQuestions.length + 1;
        const id = `q${String(nextNumber).padStart(3, "0")}`;
        const question = createEmptyQuestion(id, type);
        state.draftQuestions = [...state.draftQuestions, question];
        renderQuestionEditors();
        renderAssessmentPreview();
