    "ordinal": 32,
    "kind": "exercise-or-check",
    "locator": "chunk 32",
    "text": "Calculate the upper bound of the error of using the degree-3 Maclaurin \napproximation of sin 1 in two ways: using the Taylor Remainder Estimation and \nthe Alternating Series Estimation.  Which gives a better error bound?",
    "tokenCount": 35,
    "ocrConfidence": null
  },
  {
